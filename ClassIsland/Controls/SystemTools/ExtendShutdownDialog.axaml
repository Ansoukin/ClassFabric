<Window xmlns="https://github.com/avaloniaui"
        x:Class="ClassIsland.Controls.SystemTools.ExtendShutdownDialog"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ci="http://classisland.tech/schemas/xaml/core"
        xmlns:icons="using:ClassIsland.Core.Icons"
        Width="268"
        Height="148"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="ClassFabric - 延长关机时间">

    <Border Padding="16" CornerRadius="8"
            Background="{DynamicResource LayerFillColorAltBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ci:FluentIcon Glyph="{x:Static icons:FluentIcons.ClockBillRegular}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="请输入要延长的分钟数" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <NumericUpDown x:Name="MinutesInputElement" Grid.Row="1" Minimum="1" Maximum="720" Value="5" FormatString="F0" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButtonElement" Content="取消" FontSize="14" MinWidth="84" />
                <Button x:Name="ConfirmButtonElement" Content="确认" FontSize="14" MinWidth="84" Classes="accent" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
