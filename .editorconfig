# 仓库统一的基础格式约定：只约束编码与缩进这类零风险项。
# 不在这里挂分析器严重级别，避免给存量 18 万行代码瞬间制造海量告警。
root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.md]
# Markdown 常见行尾双空格换行等习惯，不强制收尾。
trim_trailing_whitespace = false

[*.{cmd,bat}]
# 批处理脚本按 Windows 惯例用 CRLF，避免部分工具解析异常。
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2
