<ci:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.PluginsSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassFabric.Core"
      xmlns:services="clr-namespace:ClassIsland.Core.Abstractions.Services;assembly=ClassFabric.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Controls"
      xmlns:plugin="clr-namespace:ClassIsland.Core.Models.Plugin;assembly=ClassFabric.Core"
      xmlns:ci="http://classfabric.tech/schemas/xaml/core"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:views="clr-namespace:ClassIsland.Views"
      xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      xmlns:converters="clr-namespace:ClassIsland.Converters"
      xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
      xmlns:controls2="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
      xmlns:helpers="clr-namespace:ClassIsland.Core.Helpers;assembly=ClassFabric.Core"
      xmlns:enums="clr-namespace:ClassIsland.Core.Enums;assembly=ClassFabric.Core"
      xmlns:icons="clr-namespace:ClassIsland.Core.Icons;assembly=ClassFabric.Core"
      xmlns:input="clr-namespace:Avalonia.Labs.Input;assembly=Avalonia.Labs.CommandManager"
      xmlns:locPlg="clr-namespace:ClassFabric.Assets.Localization.SettingsPage.Plugins"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="PluginsSettingsPage_OnLoaded"
      Unloaded="PluginsSettingsPage_OnUnloaded"
      d:DataContext="{d:DesignInstance local:PluginsSettingsPage}">

    <ci:SettingsPageBase.Resources>
        <DataTemplate DataType="{x:Type plugin:PluginInfo}" x:Key="PluginDetailDataTemplate">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" Margin="4 8 4 0" ColumnDefinitions="Auto,*">
                    <asyncImageLoader:AdvancedImage Grid.Column="0" Grid.Row="0"
                                    Width="60" Height="60"
                                    VerticalAlignment="Top"
                                    ClipToBounds="True"
                                    Margin="0 0 8 0 "
                                    Source="{Binding RealIconPath, FallbackValue={x:Null}}"/>
                    <StackPanel Grid.Column="1" >
                        <TextBlock Text="{Binding Manifest.Name}"
                                                   FontSize="24" 
                                                   TextTrimming="CharacterEllipsis"
                                                   FontWeight="Medium"
                                                   Margin="0 0 0 4"/>
                        <WrapPanel Orientation="Horizontal" Margin="0 0 0 2">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{Binding Manifest.Version}"/>
                                <Run Text=" | " Classes="l-decoration"/>
                                <ci:NavHyperlink NavTarget="{Binding Manifest.Url}">{x:Static locPlg:Localization.ProjectHomepage}</ci:NavHyperlink>
                                <Run Text=" | " Classes="l-decoration"/>
                                <Run Text="{Binding Manifest.Author}"/>
                                <Run Text=" | " Classes="l-decoration"/>
                            </TextBlock>
                            <WrapPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="999"
                                        Padding="10 3"
                                        VerticalAlignment="Center">
                                    <Border.IsVisible>
                                        <Binding Path="LoadStatus" Converter="{x:Static ObjectConverters.Equal}">
                                            <Binding.ConverterParameter>
                                                <enums:PluginLoadStatus>Loaded</enums:PluginLoadStatus>
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </Border.IsVisible>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ci:FluentIcon Glyph="&#xE426;" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{x:Static locPlg:Localization.StatusLoaded}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="999"
                                        Padding="10 3"
                                        VerticalAlignment="Center">
                                    <Border.IsVisible>
                                        <Binding Path="LoadStatus" Converter="{x:Static ObjectConverters.Equal}">
                                            <Binding.ConverterParameter>
                                                <enums:PluginLoadStatus>Disabled</enums:PluginLoadStatus>
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </Border.IsVisible>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ci:FluentIcon Glyph="&#xE673;" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{x:Static locPlg:Localization.StatusDisabled}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                        CornerRadius="999"
                                        Padding="10 3"
                                        VerticalAlignment="Center">
                                    <Border.IsVisible>
                                        <Binding Path="LoadStatus" Converter="{x:Static ObjectConverters.Equal}">
                                            <Binding.ConverterParameter>
                                                <enums:PluginLoadStatus>Error</enums:PluginLoadStatus>
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </Border.IsVisible>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ci:FluentIcon Glyph="&#xE673;" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{x:Static locPlg:Localization.StatusError}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="999"
                                        Padding="10 3"
                                        VerticalAlignment="Center">
                                    <Border.IsVisible>
                                        <Binding Path="LoadStatus" Converter="{x:Static ObjectConverters.Equal}">
                                            <Binding.ConverterParameter>
                                                <enums:PluginLoadStatus>NotLoaded</enums:PluginLoadStatus>
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </Border.IsVisible>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ci:FluentIcon Glyph="&#xE673;" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{x:Static locPlg:Localization.StatusNotLoaded}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal" 
                                   Margin="0 0 0 4"
                                   IsVisible="{Binding IsLocal}">
                            <CheckBox Content="{x:Static locPlg:Localization.EnabledLabel}" Margin="0 0 6  0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsEnabled}"/>
                            <Button Click="ButtonInstallPlugin_OnClick" Classes="accent"
                                    VerticalAlignment="Center"
                                    Margin="0 0 6 0"
                                    IsEnabled="{Binding DownloadProgress.IsDownloading, Converter={StaticResource InvertBooleanConverter}}">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsLocal" />
                                        <Binding Path="IsUpdateAvailable" />
                                        <Binding Path="IsAvailableOnMarket"/>
                                        <Binding Path="RestartRequired" Converter="{StaticResource InvertBooleanConverter}" Mode="OneWay"/>
                                    </MultiBinding>
                                </Button.IsVisible>
                                <ci:IconText Glyph="&#xE1A0;" Text="{x:Static locPlg:Localization.Update}"/>
                            </Button>
                            <Button VerticalAlignment="Center"
                                    Margin="0 0 6  0"
                                    Click="ButtonUninstall_OnClick"
                                    IsVisible="{Binding !IsUninstalling}">
                                <ci:IconText Glyph="&#xE61D;" Text="{x:Static locPlg:Localization.Remove}"/>
                            </Button>
                            <Button VerticalAlignment="Center"
                                    Margin="0 0 6  0"
                                    Click="ButtonUndoUninstall_OnClick"
                                    IsVisible="{Binding IsUninstalling}">
                                <ci:IconText Glyph="&#xE625;" Text="{x:Static locPlg:Localization.UndoRemove}"/>
                            </Button>
                        </WrapPanel>
                        <!-- Market Operations -->
                        <WrapPanel Orientation="Horizontal" IsEnabled="{Binding DownloadProgress.IsDownloading, Converter={StaticResource InvertBooleanConverter}}"
                                   Margin="0 0 0 4" Classes="accent">
                            <WrapPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsLocal" Converter="{StaticResource InvertBooleanConverter}"/>
                                    <Binding Path="IsAvailableOnMarket"/>
                                    <Binding Path="RestartRequired" Converter="{StaticResource InvertBooleanConverter}"/>
                                </MultiBinding>
                            </WrapPanel.IsVisible>
                            <Button Click="ButtonInstallPlugin_OnClick" Classes="accent">
                                <ci:IconText Glyph="&#xE0D3;" Text="{x:Static locPlg:Localization.Install}"/>
                            </Button>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal"
                                   Margin="0 0 0 4">
                            <Button VerticalAlignment="Center"
                                    Click="ButtonRestart_OnClick"
                                    Classes="accent"
                                    Margin="0 0 6 0"
                                    IsVisible="{Binding RestartRequired}">
                                <ci:IconText Glyph="&#xE0BD;" Text="{x:Static locPlg:Localization.RestartToApply}"/>
                            </Button>
                        </WrapPanel>
                        <controls2:FAInfoBar Message="{x:Static locPlg:Localization.UnsupportedOSWarning}"
                                           Severity="Warning"
                                           IsOpen="{Binding IsNotSupportCurrentOS}"> 
                        </controls2:FAInfoBar>
                        <!-- Download Progresses -->
                        <DockPanel Margin="0 4 0 0" IsVisible="{Binding DownloadProgress.IsDownloading, FallbackValue={x:False}}">
                            <ProgressBar Value="{Binding DownloadProgress.Progress}"/>
                        </DockPanel>
                        <controls2:FAInfoBar Message="{x:Static locPlg:Localization.InstallFailedNetworkMessage}"
                                           Severity="Error"
                                           IsOpen="{Binding DownloadProgress.Exception, Mode=OneWay, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <controls2:FAInfoBar.ActionButton>
                                <HyperlinkButton Click="MenuItemManagePluginSources_OnClick">{x:Static locPlg:Localization.ChangePluginMirror}</HyperlinkButton>
                            </controls2:FAInfoBar.ActionButton>
                        </controls2:FAInfoBar>
                        
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="{x:Static locPlg:Localization.MoreOptionsToolTip}"
                            Content="{ci:FluentIcon &#xEBAC;}"
                            Theme="{StaticResource TransparentButton}"
                            IsVisible="{Binding IsLocal}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Icon="{ci:FluentIcon &#xE06F;}" Header="{x:Static locPlg:Localization.PackPlugin}" Click="MenuItemPackPlugin_OnClick"/>
                                <Separator/>
                                <MenuItem Icon="{ci:FluentIcon &#xE88D;}" Header="{x:Static locPlg:Localization.OpenPluginFolder}" Click="MenuItemOpenPluginFolder_OnClick"/>
                                <MenuItem Icon="{ci:FluentIcon &#xE5FD;}" Header="{x:Static locPlg:Localization.OpenPluginConfigFolder}" Click="MenuItemOpenPluginConfigFolder_OnClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <TabStrip Grid.Row="1" x:Name="TabStrip"
                          Classes="compact">
                    <TabStripItem Content="{x:Static locPlg:Localization.OverviewTab}"/>
                    <TabStripItem Content="{x:Static locPlg:Localization.ErrorInfoTab}"
                                  IsVisible="{Binding Exception, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TabStripItem Content="{x:Static locPlg:Localization.DependenciesTab}"/>
                </TabStrip>
                <Panel Grid.Row="2">
                    <Border>
                        <Border.IsVisible>
                            <Binding Path="#TabStrip.SelectedIndex" Converter="{x:Static ObjectConverters.Equal}">
                                <Binding.ConverterParameter>
                                    <system:Int32>0</system:Int32>
                                </Binding.ConverterParameter>
                            </Binding>
                        </Border.IsVisible>
                        <Grid>
                            <mdxaml:MarkdownScrollViewer
                                Engine="{x:Static helpers:MarkdownConvertHelper.Engine}"
                                Margin="6 4 0 0"
                                Markdown="{Binding ViewModel.ReadmeDocument, RelativeSource={RelativeSource FindAncestor, AncestorType=local:PluginsSettingsPage}}">
                                <mdxaml:MarkdownScrollViewer.Styles>
                                    <StyleInclude Source="avares://ClassFabric.Core/Themes/RichTextStyles.axaml"/>
                                        
                                </mdxaml:MarkdownScrollViewer.Styles>
                            </mdxaml:MarkdownScrollViewer>
                            <ProgressBar IsVisible="{Binding ViewModel.IsLoadingDocument, RelativeSource={RelativeSource FindAncestor, AncestorType=local:PluginsSettingsPage}}"
                                         VerticalAlignment="Top"
                                         Height="3"
                                         IsIndeterminate="True"/>
                        </Grid>
                    </Border >
                    <Border>
                        <Border.IsVisible>
                            <Binding Path="#TabStrip.SelectedIndex" Converter="{x:Static ObjectConverters.Equal}">
                                <Binding.ConverterParameter>
                                    <system:Int32>1</system:Int32>
                                </Binding.ConverterParameter>
                            </Binding>
                        </Border.IsVisible>
                        <SelectableTextBlock ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             TextAlignment="Left" TextWrapping="Wrap"
                                             Text="{Binding Exception, Mode=OneWay}"/>
                    </Border>
                    <Border>
                        <Border.IsVisible>
                            <Binding Path="#TabStrip.SelectedIndex" Converter="{x:Static ObjectConverters.Equal}">
                                <Binding.ConverterParameter>
                                    <system:Int32>2</system:Int32>
                                </Binding.ConverterParameter>
                            </Binding>
                        </Border.IsVisible>
                        <DataGrid ItemsSource="{Binding Manifest.Dependencies, Mode=OneWay}"
                                  IsReadOnly="True"
                                  CanUserReorderColumns="False"
                                  AutoGenerateColumns="False">
                                <DataGrid.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DataGrid.Styles>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*"
                                                        Binding="{Binding Id}"
                                                        Header="{x:Static locPlg:Localization.PluginIdColumnHeader}"/>
                                    <DataGridCheckBoxColumn Width="80"
                                                            Binding="{Binding IsRequired}"
                                                            Header="{x:Static locPlg:Localization.RequiredColumnHeader}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                    </Border>
                </Panel>
            </Grid>
        </DataTemplate>
        
        <ScrollViewer x:Key="PluginUpdateSettingsDrawer" Width="320"
              HorizontalAlignment="Stretch"
              Margin="16" >
            <StackPanel Grid.Row="0">
                <TextBlock Text="{x:Static locPlg:Localization.PluginUpdateSettingsTitle}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                
                <CheckBox IsChecked="{Binding ViewModel.SettingsService.Settings.IsPluginsUpdateNotificationEnabled}"
                          Content="{x:Static locPlg:Localization.NotifyOnPluginUpdates}"/>
                <CheckBox IsChecked="{Binding ViewModel.SettingsService.Settings.IsPluginsAutoUpdateEnabled}"
                          Content="{x:Static locPlg:Localization.AutoUpdatePlugins}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Key="PluginSourceManageDrawer" Width="500"
              HorizontalAlignment="Stretch"
              Margin="16" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0">
                <TextBlock Text="{x:Static locPlg:Localization.ManagePluginSources}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                
                <ci:IconText Glyph="&#xE99E;" Text="{x:Static locPlg:Localization.BuiltinPluginSources}" Margin="0 12 0 8"/>
                <ci:Field Label="{x:Static locPlg:Localization.BuiltinMirrorLabel}" Margin="0 -4">
                    <ComboBox SelectedValue="{Binding ViewModel.SettingsService.Settings.OfficialSelectedMirror, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Key}"
                              ItemsSource="{Binding ViewModel.OfficialPluginMirrors.List}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Key}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ci:Field>
                <CheckBox Content="{x:Static locPlg:Localization.IgnoreSslErrors}"
                          Margin="0 8 0 0"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{x:Static locPlg:Localization.IgnoreSslToolTip}"
                          IsChecked="{Binding ViewModel.SettingsService.Settings.IgnoreSslForPluginMirrors, Mode=TwoWay}"/>
                <Separator Margin="0 16 0 8"/>
                <ci:IconText Glyph="&#xE99A;" Text="{x:Static locPlg:Localization.CustomPluginSources}" Margin="0 0 0 8"/>
                <WrapPanel Margin="0 0 0 0">
                    <Button Theme="{StaticResource TransparentButton}" Click="ButtonAddPluginSource_OnClick">
                        <ci:IconText Glyph="&#xE00D;" Text="{x:Static locPlg:Localization.Add}"/>
                    </Button>
                    <Button Theme="{StaticResource TransparentButton}" Click="ButtonRemovePluginSource_OnClick">
                        <ci:IconText Glyph="&#xE61D;" Text="{x:Static locPlg:Localization.Delete}"/>
                    </Button>
                </WrapPanel>
            </StackPanel>
            <DataGrid Grid.Row="1" GridLinesVisibility="All"
                      CanUserSortColumns="False"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      ItemsSource="{Binding ViewModel.SettingsService.Settings.PluginIndexes}"
                      SelectedItem="{Binding ViewModel.SelectedPluginIndexInfo}">
                <DataGrid.Styles>
                    <Style Selector="TextBlock" >
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Url" Binding="{Binding Url, Mode=TwoWay}"
                                        Width="4*"/>
                    <DataGridTemplateColumn Header="{x:Static locPlg:Localization.MirrorColumnHeader}"
                                            Width="*">
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedValue="{Binding SelectedMirror, Mode=TwoWay}"
                                          SelectedValueBinding="{Binding Key}"
                                          Margin="0 -4"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding MirrorsList.List}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Key}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedMirror}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <converters:LargeNumberToFriendlyNumberConverter x:Key="LargeNumberToFriendlyNumberConverter" />
        <converters:SupportedOSPlatformsToBooleanConverter x:Key="SupportedOSPlatformsToBooleanConverter" />
        <DataTemplate x:Key="InstallPluginConfirmTemplate">
            <DockPanel>
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0 10 0 0">
                    <StackPanel Spacing="6" Orientation="Horizontal">
                        <ci:FluentIcon Glyph="&#xF430;" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static locPlg:Localization.UnknownSourceRiskWarning}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <ScrollViewer MaxHeight="400">
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PluginsSettingsPage+PluginInstallPreviewItem">
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0 0 0 8"
                                        Padding="12">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="48" Height="48" 
                                                CornerRadius="4" ClipToBounds="True"
                                                VerticalAlignment="Top" Margin="0 0 12 0">
                                            <Image Source="{Binding IconBitmap}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Author}"
                                                           FontSize="12"
                                                           Opacity="0.7"
                                                           Margin="8 0 0 0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Version, StringFormat='v{0}'}" FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                            <Border DockPanel.Dock="Bottom"
                                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="6"
                                                    Padding="10"
                                                    Margin="0 10 0 0"
                                                    IsVisible="{Binding SupportedOSPlatforms, Converter={StaticResource SupportedOSPlatformsToBooleanConverter}}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <ci:FluentIcon Grid.Column="0" Glyph="&#xF430;" VerticalAlignment="Top" Margin="0 0 8 0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Static locPlg:Localization.UnsupportedOSWarning}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               MaxWidth="360" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <ControlTemplate x:Key="BlankListBoxTemplate">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Margin="0 0 0 6">
                        <Classes.LocalPlugins>
                            <Binding Path="ViewModel.PluginCategoryIndex" Converter="{x:Static ObjectConverters.Equal}">
                                <Binding.ConverterParameter>
                                    <system:Int32>1</system:Int32>
                                </Binding.ConverterParameter>
                            </Binding>
                        </Classes.LocalPlugins>
                        <Classes.NoPlugins>
                            <Binding Path="!!!Count" Source="{x:Static services:IPluginService.LoadedPlugins}"/>
                        </Classes.NoPlugins>
                        <TextBlock.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Text" Value="{x:Static locPlg:Localization.NoMatchingPlugins}" />
                                <Style Selector="^.LocalPlugins.NoPlugins">
                                    <Setter Property="Text" Value="{x:Static locPlg:Localization.NoPluginsInstalled}" />
                                </Style>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <Button HorizontalAlignment="Center" Click="ButtonOpenMarket_OnClick">

                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="ViewModel.PluginCategoryIndex" Converter="{x:Static ObjectConverters.Equal}">
                                    <Binding.ConverterParameter>
                                        <system:Int32>1</system:Int32>
                                    </Binding.ConverterParameter>
                                </Binding>
                                <Binding Path="!!!Count" Source="{x:Static services:IPluginService.LoadedPlugins}"/>
                            </MultiBinding>
                        </Button.IsVisible>
                        <ci:IconText Glyph="&#xF08B;" Text="{x:Static locPlg:Localization.GoToMarket}" />
                    </Button>
                </StackPanel>
            </Grid>
        </ControlTemplate>
    </ci:SettingsPageBase.Resources>
    <Grid DragDrop.AllowDrop="True" DragDrop.DragEnter="Grid_DragEnter" DragDrop.DragOver="Grid_DragEnter" DragDrop.Drop="Grid_Drop" DragDrop.DragLeave="Grid_DragLeave">
        <Grid Margin="8 12 0 12">
            <controls1:ListDetailView IsEnabled="{Binding ViewModel.SettingsService.Settings.IsPluginMarketWarningVisible, Converter={StaticResource InvertBooleanConverter}}"
                                      IsPanelOpened="{Binding ViewModel.IsDetailsShown, Mode=TwoWay}"
                                      IsVisible="{Binding !ViewModel.SettingsService.Settings.IsPluginMarketWarningVisible}">
            <controls1:ListDetailView.TitleElement>
                <TextBlock Text="{x:Static locPlg:Localization.PluginDetails}" VerticalAlignment="Center"
                           Theme="{StaticResource SubtitleTextBlockStyle}"/>
            </controls1:ListDetailView.TitleElement>
            <controls1:ListDetailView.LeftContent>
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0">
                        <Grid Margin="4 0">
                            <TextBox Watermark="{x:Static locPlg:Localization.SearchPluginsWatermark}"
                                     Text="{Binding ViewModel.PluginFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="TextBoxFilter_OnKeyDown"
                                     Padding="26 4"
                                     BorderThickness="0"
                                     HorizontalAlignment="Stretch"/>
                            <ci:FluentIcon Glyph="&#xEEF3;"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Margin="8 0"
                                           IsHitTestVisible="False"/>
                        </Grid>
                        <DockPanel Dock="Left" LastChildFill="False">
                            <TabStrip SelectedIndex="{Binding ViewModel.PluginCategoryIndex}"
                                      Classes="compact"
                                      SelectionChanged="ListBoxCategory_OnSelectionChanged">
                                <TabStripItem Content="{x:Static locPlg:Localization.MarketTab}"/>
                                <TabStripItem Content="{x:Static locPlg:Localization.InstalledTab}"/>
                            </TabStrip>

                            <Button Content="{ci:FluentIcon &#xEBAC;}"
                                    Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static locPlg:Localization.MoreOptionsToolTip}"
                                    DockPanel.Dock="Right">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Icon="{ci:FluentIcon &#xE0B5;}" Header="{x:Static locPlg:Localization.ReloadFromCache}" 
                                                  Click="MenuItemReloadFromCache_OnClick"
                                                  IsEnabled="{Binding ViewModel.PluginMarketService.IsLoadingPluginSource, Converter={StaticResource InvertBooleanConverter}}"/>
                                        <MenuItem Icon="{ci:FluentIcon &#xE99A;}" Header="{x:Static locPlg:Localization.ManagePluginSourcesMenu}"
                                                  Click="MenuItemManagePluginSources_OnClick"
                                                  IsEnabled="{Binding ViewModel.PluginMarketService.IsLoadingPluginSource, Converter={StaticResource InvertBooleanConverter}}"/>
                                        <MenuItem Icon="{ci:FluentIcon &#xE161;}" Header="{x:Static locPlg:Localization.PluginUpdateSettingsMenu}"
                                                  Click="MenuItemPluginUpdateSettings_OnClick"
                                                  IsEnabled="{Binding ViewModel.PluginMarketService.IsLoadingPluginSource, Converter={StaticResource InvertBooleanConverter}}"/>
                                        <Separator/>
                                        <MenuItem Icon="{ci:FluentIcon &#xE071;}" Header="{x:Static locPlg:Localization.InstallFromLocal}"
                                                  Click="ButtonInstallFromLocal_OnClick"/>
                                        <Separator/>
                                        <MenuItem Icon="{ci:FluentIcon &#xE88D;}" Header="{x:Static locPlg:Localization.OpenPluginFolder}"
                                                  Click="MenuItemOpenPluginsFolder_OnClick"/>
                                        
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            
                            <Button DockPanel.Dock="Right" 
                                    Theme="{StaticResource TransparentButton}"
                                    Click="ButtonBaseRefreshPlugins_OnClick"
                                    IsEnabled="{Binding ViewModel.PluginMarketService.IsLoadingPluginSource, Converter={StaticResource InvertBooleanConverter}}">
                                <ci:IconText Glyph="&#xE0B5;" Text="{x:Static locPlg:Localization.Refresh}"/>
                            </Button>

                        </DockPanel>
                        <ProgressBar IsVisible="{Binding ViewModel.PluginMarketService.IsLoadingPluginSource}"
                                     IsIndeterminate="True"/>
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ViewModel.MergedPluginsFiltered.Items}"
                             SelectedValue="{Binding ViewModel.SelectedPluginInfo}"
                             SelectedValueBinding="{Binding Value}"
                             SelectionChanged="Selector_OnSelectionChanged">
                        <ListBox.Styles>
                            <Style Selector="ListBox:empty">
                                <Setter Property="Template" Value="{StaticResource BlankListBoxTemplate}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent"
                                      x:Name="PluginItemRoot"
                                      Margin="-8 8 -2 8"
                                      Classes.IsLocal="{Binding Value.IsLocal}" RowDefinitions="*,*"
                                      ColumnDefinitions="Auto,*,Auto">
                                    <Classes.Loaded>
                                        <Binding Path="Value.LoadStatus" Converter="{x:Static ObjectConverters.Equal}">
                                            <Binding.ConverterParameter>
                                                <enums:PluginLoadStatus>Loaded</enums:PluginLoadStatus>
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </Classes.Loaded>
                                    <Grid.Styles>
                                        <Style Selector="Grid#PluginItemRoot">
                                            <Setter Property="Opacity" Value="0.75"/>
                                            <Style Selector="^.Loaded">
                                                <Setter Property="Opacity" Value="1"/>
                                            </Style>
                                            <Style Selector="^:not(.IsLocal)">
                                                <Setter Property="Opacity" Value="1"/>
                                            </Style>
                                        </Style>
                                    </Grid.Styles>

                                    <!-- 图标 -->
                                    <asyncImageLoader:AdvancedImage Grid.Column="0" Grid.Row="0"
                                                            Grid.RowSpan="2"
                                                            Width="48" Height="48"
                                                            VerticalAlignment="Center"
                                                            ClipToBounds="True"
                                                            Margin="0 0 6 0 "
                                                            Source="{Binding Value.RealIconPath, FallbackValue={x:Null}}"/>
                                    <!-- 标题 -->
                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Value.Manifest.Name}"
                                                   FontSize="16" FontWeight="Medium">
                                    </TextBlock>
                                    <!-- 描述 -->
                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                                   TextWrapping="Wrap"
                                                   FontWeight="Regular"
                                                   Text="{Binding Value.Manifest.Description}"
                                                   FontSize="12" />
                                    <!-- 错误标志 -->
                                    <WrapPanel Grid.Column="2"
                                               Grid.Row="0"
                                               Grid.RowSpan="2" 
                                               Orientation="Horizontal"
                                               VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" ToolTip.Tip="{x:Static locPlg:Localization.DownloadsToolTip}" Margin="2 0 0 0">
                                            <ci:FluentIcon Width="16" Height="16" FontSize="16"
                                                           Glyph="&#xE0D2;" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Value.DownloadCount, Converter={StaticResource LargeNumberToFriendlyNumberConverter}}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" ToolTip.Tip="Stars" Margin="4 0 0 0">
                                            <ci:FluentIcon Width="16" Height="16" FontSize="16"
                                                           Glyph="&#xF05A;" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Value.StarsCount, Converter={StaticResource LargeNumberToFriendlyNumberConverter}}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ci:FluentIcon ToolTip.Tip="{x:Static locPlg:Localization.PendingRemoveToolTip}"
                                                         Foreground="Orange"
                                                         Width="16" Height="16"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding Value.IsUninstalling}"
                                                         Margin="4 0 0 0"
                                                         Glyph="&#xE61C;"/>
                                        <ci:FluentIcon ToolTip.Tip="{x:Static locPlg:Localization.RestartRequiredToolTip}"
                                                       Foreground="Orange"
                                                       Width="16" Height="16"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding Value.RestartRequired}"
                                                       Margin="2 0 0 0"
                                                       Glyph="&#xE0BC;"/>
                                        <ci:FluentIcon Foreground="Red"
                                                       ToolTip.Tip="{x:Static locPlg:Localization.LoadErrorToolTip}"
                                                       Width="16" Height="16"
                                                       Margin="2 0 0 0"
                                                       VerticalAlignment="Center"
                                                       Glyph="{x:Static icons:FluentIcons.ErrorCircleFilled}">
                                            <ci:FluentIcon.IsVisible>
                                                <Binding Path="Value.LoadStatus" Converter="{x:Static ObjectConverters.Equal}">
                                                    <Binding.ConverterParameter>
                                                        <enums:PluginLoadStatus>Error</enums:PluginLoadStatus>
                                                    </Binding.ConverterParameter>
                                                </Binding>
                                            </ci:FluentIcon.IsVisible>
                                        </ci:FluentIcon>
                                        <Button Theme="{StaticResource TransparentButton}"
                                                ToolTip.Tip="{x:Static locPlg:Localization.ShowDiagnosticToolTip}"
                                                CornerRadius="14"
                                                Width="20" Height="20"
                                                Padding="0"
                                                Margin="2 0 0 0"
                                                VerticalAlignment="Center"
                                                CommandParameter="{Binding Value.Manifest.Id}"
                                                Command="{Binding ShowDiagnosticCommand, RelativeSource={RelativeSource AncestorType=local:PluginsSettingsPage}}">
                                            <Button.IsVisible>
                                                <Binding Path="Value.LoadStatus" Converter="{x:Static ObjectConverters.Equal}">
                                                    <Binding.ConverterParameter>
                                                        <enums:PluginLoadStatus>Error</enums:PluginLoadStatus>
                                                    </Binding.ConverterParameter>
                                                </Binding>
                                            </Button.IsVisible>
                                            <ci:FluentIcon Width="16" Height="16"
                                                           Glyph="{x:Static icons:FluentIcons.InfoRegular}"/>
                                        </Button>
                                        <ci:FluentIcon ToolTip.Tip="{x:Static locPlg:Localization.UpdateAvailableToolTip}"
                                                       Width="16" Height="16"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding Value.IsUpdateAvailable}"
                                                       Margin="2 0 0 0"
                                                       Glyph="&#xE1A0;"/>
                                        <ci:FluentIcon ToolTip.Tip="{x:Static locPlg:Localization.AlreadyInstalledToolTip}"
                                                       Width="16" Height="16"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding Value.IsLocal}"
                                                       Margin="2 0 0 0"
                                                       Glyph="&#xE5AC;"/>
                                    </WrapPanel>
                                    
                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Column="2"
                                          Grid.Row="0"
                                          Grid.RowSpan="2" 
                                          Orientation="Horizontal"
                                          Margin="4 0 0 0"
                                          IsEnabled="{Binding Value.DownloadProgress.IsDownloading, Converter={StaticResource InvertBooleanConverter}}"
                                          VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                        <Panel>
                                            
                                            <Button
                                                ToolTip.Tip="{x:Static locPlg:Localization.Install}"
                                                Classes="accent"
                                                CornerRadius="14"
                                                Width="28" Height="28"
                                                Padding="0"
                                                CommandParameter="{Binding Value.Manifest.Id}"
                                                Command="{Binding InstallPluginCommand, RelativeSource={RelativeSource AncestorType=local:PluginsSettingsPage}}"
                                                Content="{ci:FluentIcon &#xE0D2;}">
                                                <Button.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="Value.IsLocal" Converter="{StaticResource InvertBooleanConverter}"/>
                                                        <Binding Path="Value.IsAvailableOnMarket"/>
                                                        <Binding Path="Value.RestartRequired" Converter="{StaticResource InvertBooleanConverter}"/>
                                                    </MultiBinding>
                                                </Button.IsVisible>
                                            </Button>
                                            <Button
                                                ToolTip.Tip="{x:Static locPlg:Localization.Update}"
                                                Classes="accent"
                                                CornerRadius="14"
                                                Width="28" Height="28"
                                                Padding="0"
                                                CommandParameter="{Binding Value.Manifest.Id}"
                                                Command="{Binding InstallPluginCommand, RelativeSource={RelativeSource AncestorType=local:PluginsSettingsPage}}"
                                                Content="{ci:FluentIcon &#xE1A0;}">
                                                <Button.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="Value.IsLocal"/>
                                                        <Binding Path="Value.IsAvailableOnMarket"/>
                                                        <Binding Path="Value.IsUpdateAvailable"/>
                                                        <Binding Path="Value.RestartRequired" Converter="{StaticResource InvertBooleanConverter}"/>
                                                    </MultiBinding>
                                                </Button.IsVisible>
                                            </Button>
                                            <controls2:FAProgressRing Width="28" Height="28" MinWidth="0" MinHeight="0" IsIndeterminate="False"
                                                                    IsVisible="{Binding Value.DownloadProgress.IsDownloading, FallbackValue={x:False}}"
                                                                    Value="{Binding Value.DownloadProgress.Progress}"
                                                                    Maximum="100"/>
                                        </Panel>
                                        <Button
                                            ToolTip.Tip="{x:Static locPlg:Localization.RestartToApply}"
                                            CornerRadius="14"
                                            Width="28" Height="28"
                                            Click="ButtonRestart_OnClick"
                                            Content="{ci:FluentIcon &#xE0BC;}"
                                            Classes="accent" Padding="0"
                                            IsVisible="{Binding Value.RestartRequired}">
                                        </Button>

                                        <CheckBox IsVisible="{Binding Value.IsLocal}"
                                                  ToolTip.Tip="{x:Static locPlg:Localization.EnablePluginToolTip}"
                                                  Margin="4 0 0 0"
                                                  Padding="0"
                                                  VerticalAlignment="Bottom"
                                                  IsChecked="{Binding Value.IsEnabled}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    
                </Grid>
            </controls1:ListDetailView.LeftContent>
            <controls1:ListDetailView.RightContent>
                <Grid>
                    <ci:Emptiable Content="{Binding ViewModel.SelectedPluginInfo}"
                                      ContentTemplate="{StaticResource PluginDetailDataTemplate}"/>
                </Grid>
            </controls1:ListDetailView.RightContent>
            </controls1:ListDetailView>
            <Border IsVisible="{Binding ViewModel.SettingsService.Settings.IsPluginMarketWarningVisible}">
            <ScrollViewer>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Grid HorizontalAlignment="Center" ColumnDefinitions="75,Auto,75">
                        <Image Grid.Column="0" Source="/Assets/AppLogo.png" />
                        <ci:FluentIcon Grid.Column="1"
                                         VerticalAlignment="Center"
                                         Width="25" Height="25"
                                         FontSize="25"
                                         Margin="16 0"
                                         Glyph="&#xE00C;" />
                        <ci:FluentIcon Grid.Column="2" Glyph="&#xE070;"
                                       VerticalAlignment="Stretch"
                                       HorizontalAlignment="Stretch"
                                       FontSize="75"
                                       Height="75"
                                       Width="75" />
                    </Grid>
                    <TextBlock Text="{x:Static locPlg:Localization.PluginsHeader}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0 8 0 0"
                               Theme="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Margin="0 6 0 0"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Width="320">
                        <Run Text="{x:Static locPlg:Localization.WelcomeText}" />

                    </TextBlock>
                    <Border Width="320"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Margin="0 8 0 0"
                            CornerRadius="4"
                            Padding="8">
                        <StackPanel>
                            <ci:FluentIcon Glyph="&#xF430;"
                                             Margin="0 0 0 4"
                                             HorizontalAlignment="Center"/>
                            <TextBlock TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="{x:Static locPlg:Localization.MarketWarningText}" />
                        </StackPanel>
                    </Border>

                    <Button HorizontalAlignment="Center"
                            Margin="0 16 0 0"
                            Classes="accent"
                            Click="ButtonAgreePluginNotice_OnClick">
                        <ci:IconText Glyph="&#xE424;" Text="{x:Static locPlg:Localization.AgreeAndStart}"/>
                    </Button>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <Grid IsVisible="{Binding ViewModel.IsInstallingLocalPlugin}">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Opacity="0.8"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls2:FAProgressRing IsIndeterminate="True" Width="64" Height="64" />
                <TextBlock Text="{x:Static locPlg:Localization.ParsingText}" 
                           Margin="0 16 0 0" 
                           HorizontalAlignment="Center"
                           FontSize="16"/>
            </StackPanel>
        </Grid>
        <Grid IsVisible="{Binding ViewModel.IsDragEntering}">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Opacity="0.75"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <ci:FluentIcon IsVisible="{Binding ViewModel.IsDragInstallValid}"
                                   Glyph="&#xE162;"
                                   HorizontalAlignment="Center"
                                   FontSize="80"
                                   Margin="0 0 0 4"/>
                    <ci:FluentIcon IsVisible="{Binding !ViewModel.IsDragInstallValid}"
                                   Glyph="&#xEA39;"
                                   HorizontalAlignment="Center"
                                   FontSize="80"
                                   Margin="0 0 0 4"/>

                    <TextBlock Text="{Binding ViewModel.DragInstallHintText}"
                               FontSize="16"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ViewModel.DragInstallSubHintText}"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <TextBlock Opacity="0.55"
                               FontSize="12"
                               TextAlignment="Center"
                               HorizontalAlignment="Center">
                        <Run Text="{x:Static locPlg:Localization.DragFilesPrefix}"/>
                        <Run Text="{Binding ViewModel.DragInstallTotalCount}"/>
                        <Run Text="{x:Static locPlg:Localization.DragFilesMiddle}"/>
                        <Run Text="{Binding ViewModel.DragInstallSupportedCount}"/>
                        <Run Text="{x:Static locPlg:Localization.DragFilesSuffix}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ci:SettingsPageBase>
