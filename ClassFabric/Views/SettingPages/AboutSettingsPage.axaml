<controls:SettingsPageBase x:Class="ClassFabric.Views.SettingPages.AboutSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="using:ClassFabric.Views.SettingPages"
      xmlns:controls="using:ClassFabric.Core.Abstractions.Controls"
      xmlns:ci="using:ClassFabric"
      xmlns:controls1="using:ClassFabric.Core.Controls"
      xmlns:models="using:ClassFabric.Models"
      xmlns:commands="http://classisland.tech/schemas/xaml/core"
      xmlns:controls2="clr-namespace:ClassFabric.Controls"
      xmlns:ci2="http://classisland.tech/schemas/xaml/core"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
      xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:AboutSettingsPage}">
    <controls:SettingsPageBase.Resources>
        <Grid Margin="16" x:Key="ContributorsDrawer" Width="300" RowDefinitions="Auto,Auto,Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="贡献人员" Theme="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Grid.Row="1" Margin="0 6 0 0" Text="感谢以下同学为本项目做出的贡献！"/>
            <Button Grid.Row="2" HorizontalAlignment="Left" 
                    Click="ButtonRefreshContributors_OnClick"
                    Margin="0 2 0 0"
                    IsEnabled="{Binding ViewModel.IsRefreshingContributors, Converter={StaticResource InvertBooleanConverter}}">
                <controls1:IconText Glyph="&#xE0B5;" Text="刷新"/>
            </Button>
            <ListBox Grid.Row="3" Margin="0 2 0 0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemsSource="{Binding ViewModel.SettingsService.Settings.ContributorsCache.Contributors}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center"
                                  Width="32" Height="32"
                                  Margin="0 0 6 0">
                                <Grid.Clip>
                                    <RectangleGeometry RadiusX="16" RadiusY="16"
                                                       Rect="0,0,32,32" />
                                </Grid.Clip>
                                <Border Background="{DynamicResource MaterialDesignBody}" Opacity="0.1" />
                                <asyncImageLoader:AdvancedImage Source="{Binding AvatarUri}"
                                       Width="32" Height="32">
                                </asyncImageLoader:AdvancedImage>
                            </Grid>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                <Run FontSize="15"
                                     Text="{Binding Name, Mode=OneWay}" />
                                <LineBreak />
                                <Run FontSize="11"
                                     FontWeight="Light"
                                     Text="{Binding ContributionText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="4" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0 1 0 0" Margin="0 8 0 0" Padding="0 8 0 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center"
                          Width="32" Height="32"
                          Margin="0 0 6 0">
                        <Grid.Clip>
                            <RectangleGeometry RadiusX="16" RadiusY="16"
                                               Rect="0,0,32,32" />
                        </Grid.Clip>
                        <Border Background="{DynamicResource MaterialDesignBody}" Opacity="0.1" />
                        <asyncImageLoader:AdvancedImage Source="https://avatars.githubusercontent.com/u/101161423?v=4"
                               Width="32" Height="32">
                        </asyncImageLoader:AdvancedImage>
                    </Grid>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                        <Run FontSize="15" Text="Ansoukin" />
                        <LineBreak />
                        <Run FontSize="11" FontWeight="Light" Text="ClassFabric 二改作者" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <Grid Margin="16" x:Key="ThirdPartyLibs" Width="300" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="第三方库" Theme="{StaticResource SubtitleTextBlockStyle}" />
            <ListBox Grid.Row="1" Margin="0 6 0 0"
                     ItemsSource="{Binding ViewModel.ThirdPartyLibs}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:NuGetLicenseInfo}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                              Margin="0 4">
                            <controls1:FluentIcon Grid.Row="0" Grid.Column="0"
                                                  Glyph="&#xE07D;" VerticalAlignment="Center"
                                                  Margin="0 0 6 0" />
                             <TextBlock Grid.Row="0" Grid.Column="1"
                                        Text="{Binding PackageId}"
                                        VerticalAlignment="Center" FontSize="14"
                                        FontWeight="Bold" TextWrapping="Wrap" />
                            <WrapPanel Grid.Row="1" Grid.Column="1"
                                       VerticalAlignment="Center" 
                                       IsVisible="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}">
                                 <commands:NavHyperlink NavTarget="{Binding PackageProjectUrl}"
                                                        ToolTip.Tip="{Binding PackageProjectUrl}">
                                     网站…
                                 </commands:NavHyperlink>
                                 <commands:NavHyperlink NavTarget="{Binding LicenseUrl}"
                                                        ToolTip.Tip="{Binding LicenseUrl}">
                                     <TextBlock Text="{Binding License, StringFormat='许可证：{0}'}" />
                                 </commands:NavHyperlink>
                             </WrapPanel>
                             <!--<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}"  Margin="0 3 0 0" TextWrapping="Wrap"/>-->
                         </Grid>
                     </DataTemplate>
                 </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid x:Key="OpenSourceLicense" Margin="16" MaxHeight="{Binding Height}"
              RowDefinitions="Auto,*,Auto">
            <TextBox Grid.Row="1" Margin="0 12 0 0"
                     Padding="8" Text="{Binding ViewModel.License, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" />
        </Grid>

        <Grid x:Key="DiagnosticInfoDialog" Margin="16" Height="400" Width="550" MaxHeight="{Binding Height}"
              RowDefinitions="Auto,*,Auto">
            <TextBox Grid.Row="1" Margin="0 12 0 0"
                     Padding="8" Text="{Binding ViewModel.DiagnosticInfo, Mode=OneWay}" IsReadOnly="True"
                     VerticalContentAlignment="Top"
                     FontFamily="Consolas" />
        </Grid>

    </controls:SettingsPageBase.Resources>
    <controls1:StickyScrollViewer CollapsedHeight="58">
        <controls1:StickyScrollViewer.HeaderContent>
            <Grid>
                <Border Margin="12 16 18 0"
                        MaxWidth="{StaticResource SettingsContainerWidth}">
                    <TextBlock FontWeight="Normal"
                               Text="关于 ClassFabric"
                               VerticalAlignment="Bottom"
                               Theme="{StaticResource TitleTextBlockStyle}"
                               Margin="0 8"/>
                </Border>
            </Grid>
        </controls1:StickyScrollViewer.HeaderContent>
        <StackPanel Classes="settings-container ">
            <controls3:SettingsExpander Header="ClassFabric"
                                        IsExpanded="True">
                <controls3:SettingsExpander.Footer>
                    <TextBlock Text="{x:Static local:AboutSettingsPage.DisplayVersion}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </controls3:SettingsExpander.Footer>
                <controls3:SettingsExpander.IconSource>
                    <controls3:ImageIconSource Source="/Assets/AppLogo.png"/>
                </controls3:SettingsExpander.IconSource>
                <controls3:SettingsExpanderItem>
                    <controls3:SettingsExpanderItem.Footer>
                        <WrapPanel Classes="animated-resize">
                            <WrapPanel.Styles>
                                <Style Selector="HyperlinkButton">
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </WrapPanel.Styles>
                            <HyperlinkButton Click="SettingsExpanderItemShowOssLicense_OnClick"
                                             CommandParameter="https://classisland.tech">
                                <TextBlock Text="开放源代码许可"/>
                            </HyperlinkButton>
                            <HyperlinkButton Click="ButtonPrivacy_OnClick"
                                             CommandParameter="https://docs.classisland.tech">
                                <TextBlock Text="隐私政策"/>
                            </HyperlinkButton>
                        </WrapPanel>
                    </controls3:SettingsExpanderItem.Footer>
                    <TextBlock>
                        <Run Text="Copyright (c) 2023-"/><Run Text="{Binding Year, Source={x:Static system:DateTime.Now}, Mode=OneWay}" /><Run Text=" HelloWRC（原作者 ClassIsland）" />
                    </TextBlock>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem>
                    <TextBlock>
                        <Run Text="Copyright (c) 2026-"/><Run Text="{Binding Year, Source={x:Static system:DateTime.Now}, Mode=OneWay}" /><Run Text=" Ansoukin（ClassFabric 二改作者）" />
                    </TextBlock>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem MinHeight="40">
                    <TextBlock Text="本项目基于 GNU General Public License v3.0 获得许可。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="13"/>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="常用链接">
                    <controls3:SettingsExpanderItem.Footer>
                        <WrapPanel Classes="animated-resize">
                            <WrapPanel.Styles>
                                <Style Selector="HyperlinkButton">
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </WrapPanel.Styles>
                            <HyperlinkButton Click="UriNavigationCommands_OnClick"
                                             CommandParameter="https://github.com/ansoukin/ClassFabric">
                                <TextBlock Text="项目主页"/>
                            </HyperlinkButton>
                            <HyperlinkButton Click="UriNavigationCommands_OnClick"
                                             CommandParameter="https://docs.classisland.tech">
                                <TextBlock Text="帮助文档（ClassIsland）"/>
                            </HyperlinkButton>
                            <HyperlinkButton Click="UriNavigationCommands_OnClick"
                                             CommandParameter="https://docs.classisland.tech/community/">
                                <TextBlock Text="加入社区（ClassIsland）"/>
                            </HyperlinkButton>
                        </WrapPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                
            </controls3:SettingsExpander>

            <controls3:SettingsExpander Header="遇到问题？" IconSource="{commands:FluentIconSource &#xE3F6;}"
                                        IsExpanded="True">
                <controls3:SettingsExpanderItem 
                    Click="ButtonDiagnosticInfo_OnClick"
                    Content="查看诊断信息"
                    IsClickEnabled="True"/>
            </controls3:SettingsExpander>
            
            <controls3:SettingsExpander Header="鸣谢" IconSource="{commands:FluentIconSource &#xE971;}"
                                        IsExpanded="True">
                <controls3:SettingsExpanderItem 
                    Content="贡献人员"
                    Click="ButtonContributors_OnClick"
                    IsClickEnabled="True"/>
                <controls3:SettingsExpanderItem 
                    Content="第三方库"
                    Click="ButtonThirdPartyLibs_OnClick"
                    IsClickEnabled="True"/>
                <controls3:SettingsExpanderItem>
                    <TextBlock LineHeight="30" Margin="0 0 0 0" FontSize="14" TextWrapping="Wrap">
                        本项目受到
                        <HyperlinkButton Click="Hyperlink2_OnClick">DuguSand/class_form</HyperlinkButton>
                        的启发而开发。<LineBreak/>
                        界面主题和部分控件使用了 FluentAvalonia 框架。<LineBreak/>
                        应用字体使用了华为出品的 HarmonyOS Sans。<LineBreak/>
                        感谢协助本应用测试的同学。<LineBreak/>
                        感谢<commands:NavHyperlink NavTarget="https://forum.smart-teach.cn/">智教联盟</commands:NavHyperlink>提供服务器资源，<commands:NavHyperlink NavTarget="https://xiaowuap.com/">吴恩泽</commands:NavHyperlink>提供 TTS、遥测等服务资源。<LineBreak/>
                        天气数据来源于小米天气。<LineBreak/>
                        感谢其他使用的第三方库和贡献成员，详见贡献名单和第三方库。
                    </TextBlock>
                </controls3:SettingsExpanderItem>

            </controls3:SettingsExpander>

            <TextBlock Text="谨以此应用，献给现在或曾经陪伴着我的同学们。愿时光流转，各位能与所念之人重逢。"
                       Margin="0 8 0 0"
                       Classes="l-instructive" FontSize="13"
                       VerticalAlignment="Center" TextAlignment="Center"
                       Background="Transparent"
                       PointerPressed="InputElementReunion_OnPointerPressed"/>
        </StackPanel>
    </controls1:StickyScrollViewer>
</controls:SettingsPageBase>
