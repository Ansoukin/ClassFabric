<controls:SettingsPageBase x:Class="ClassFabric.Views.SettingPages.PrivacySettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassFabric.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassFabric.Core.Abstractions.Controls;assembly=ClassFabric.Core"
      xmlns:controls1="clr-namespace:ClassFabric.Core.Controls;assembly=ClassFabric.Core"
      xmlns:controls2="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:PrivacySettingsPage}">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Tag="CanPolicyDisable">
            <TextBlock Margin="0 0 0 16" TextWrapping="Wrap">
                <Run Text="更多信息请见">
                </Run>
                <HyperlinkButton Click="HyperlinkMsAppCenter_OnClick">
                    《ClassFabric 隐私政策》
                </HyperlinkButton>
                。
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
