<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.NotificationSettingsPage"
                           xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
                           xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassFabric.Core"
                           xmlns:controls1="clr-namespace:ClassIsland.Controls"
                           xmlns:notification="clr-namespace:ClassIsland.Shared.Models.Notification;assembly=ClassFabric.Shared"
                           xmlns:controls2="clr-namespace:ClassIsland.Core.Controls;assembly=ClassFabric.Core"
                           xmlns:dd="urn:gong-wpf-dragdrop"
                           xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                           xmlns:converters="clr-namespace:ClassIsland.Converters"
                           xmlns:system="clr-namespace:System;assembly=System.Runtime"
                           xmlns:ci="http://classfabric.tech/schemas/xaml/core"
                           xmlns:registry="clr-namespace:ClassIsland.Core.Services.Registry;assembly=ClassFabric.Core"
                           xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                           xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
                           xmlns:storage="clr-namespace:Avalonia.Platform.Storage;assembly=Avalonia.Base"
                           xmlns:notification1="clr-namespace:ClassIsland.Shared.Abstraction.Models.Notification;assembly=ClassFabric.Shared"
                           xmlns:locNtf="clr-namespace:ClassFabric.Assets.Localization.SettingsPage.Notification"
                            mc:Ignorable="d"
                           d:DesignHeight="450" d:DesignWidth="800"
                           d:DataContext="{d:DesignInstance local:NotificationSettingsPage}"
                           Loaded="NotificationSettingsPage_OnLoaded"
                           Unloaded="NotificationSettingsPage_OnUnloaded">

    <controls:SettingsPageBase.Resources>
        <converters:GuidToNotificationProviderConverter x:Key="GuidToNotificationProviderConverter" />
        
        <ci:BindingProxy x:Key="DataProxy"
                         x:TypeArguments="local:NotificationSettingsPage"
                         Data="{Binding}"/>

        <ScrollViewer Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                      x:Key="NotificationSettingsDrawer"
                      DataContext="{Binding ViewModel.SelectedRegisterInfo}"
                      Width="500">
            
        </ScrollViewer>
    </controls:SettingsPageBase.Resources>

    <controls1:ListDetailView Margin="12"
                              ShowTitleWhenNotCompressed="True"
                              IsEnabled="{Binding ViewModel.ManagementService.Policy.DisableSettingsEditing, Converter={StaticResource InvertBooleanConverter}}"
                              IsPanelOpened="{Binding ViewModel.IsNotificationSettingsPanelOpened, Mode=TwoWay}">

        <controls1:ListDetailView.TitleElement>
            <Grid>
                <Grid DataContext="{Binding ViewModel.SelectedRegisterInfo, Mode=OneWay}"
                      d:DataContext="{d:DesignInstance notification:NotificationProviderRegisterInfo}">
                    <TextBlock Text="{Binding Name}"
                               Theme="{StaticResource SubtitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </controls1:ListDetailView.TitleElement>

        <controls1:ListDetailView.LeftContent>
            <!-- 提醒提供方 -->
            <Grid Margin="0 0 4 0" RowDefinitions="Auto,Auto,*">

                <!-- 提醒开关 -->
                <controls3:FASettingsExpander Grid.Row="0"
                                            IconSource="{ci:FluentIconSource &#xE02B;}"
                                            Header="{x:Static locNtf:Localization.EnableNotification}"
                                            Description="{x:Static locNtf:Localization.EnableNotificationDescription}"
                                            Margin="0 0 0 6">
                    <controls3:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsNotificationEnabled, Mode=TwoWay}"/>
                    </controls3:FASettingsExpander.Footer>
                </controls3:FASettingsExpander>
                
                <controls3:FAInfoBar Grid.Row="1"
                                   Severity="Warning"
                                   Title="{x:Static locNtf:Localization.NotificationMayNotShowTitle}"
                                   Message="{x:Static locNtf:Localization.NotificationMayNotShowMessage}"
                                   IsOpen="{Binding !ViewModel.HasValidMainWindowLine, Mode=OneWay}">
                    <controls3:FAInfoBar.ActionButton>
                        <Button Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                CommandParameter="classfabric://app/settings/components" Content="{x:Static locNtf:Localization.GoToComponentsPage}" />
                    </controls3:FAInfoBar.ActionButton>
                </controls3:FAInfoBar>

                <!-- 提醒提供方列表 -->
                <TabControl Grid.Row="2" Classes="compact" Padding="0" Margin="0">
                    <TabItem Header="{x:Static locNtf:Localization.NotificationProvidersTab}">
                        <ListBox ItemsSource="{Binding ViewModel.NotificationProvidersFiltered}"
                                 SelectionMode="Single"
                                 SelectionChanged="SelectorMain_OnSelected"
                                 SelectedItem="{Binding ViewModel.NotificationSettingsSelectedProvider, Mode=TwoWay}">
                            <ListBox.Styles>
                                <Style Selector="ListBox:not(.no-drag) ListBoxItem">
                                    <Setter Property="Interaction.Behaviors">
                                        <BehaviorCollectionTemplate>
                                            <BehaviorCollection>
                                                <ci:AdvancedItemDragBehavior HorizontalDragThreshold="33550336" VerticalDragThreshold="3"
                                                                             Orientation="Vertical"/>
                                            </BehaviorCollection>
                                        </BehaviorCollectionTemplate>
                                    </Setter>
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid DataContext="{Binding Converter={StaticResource GuidToNotificationProviderConverter}}"
                                          d:DataContext="{d:DesignInstance notification:NotificationProviderRegisterInfo}"
                                          Margin="-8 8"
                                          Background="Transparent" RowDefinitions="*,*,Auto" ColumnDefinitions="Auto,Auto,*,Auto">

                                        <ci:TouchDragThumb Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"/>
                                        <!-- 图标 -->
                                        <controls1:ReattachableContentPresenter Grid.Column="1" Grid.Row="0"
                                                                                Grid.RowSpan="2"
                                                                                Width="24" Height="24"
                                                                                VerticalAlignment="Center"
                                                                                ClipToBounds="True" Margin="6 6 10 6"
                                                                                ContentSource="{Binding ProviderInstance.IconElement}" />
                                        
                                        <!-- 标题 -->
                                        <TextBlock Grid.Column="2" Grid.Row="0"
                                                   TextWrapping="Wrap"
                                                   Margin="0 0 0 2"
                                                   Text="{Binding Name}"
                                                   FontSize="16" FontWeight="Bold" />
                                        
                                        <!-- 描述 -->
                                        <TextBlock Grid.Column="2" Grid.Row="1"
                                                   TextWrapping="Wrap"
                                                   Margin="0 0 0 4"
                                                   Classes="l-instructive"
                                                   Text="{Binding Description}"
                                                   FontSize="12" />
                                        
                                        <controls1:NotificationProviderSettingsIndicatorControl 
                                            Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ProviderSettings.IsSettingsEnabled}"
                                            IsSettingsEnabled="{Binding ProviderSettings.IsSettingsEnabled}"
                                            GlobalSettings="{Binding $parent[local:NotificationSettingsPage].ViewModel.SettingsService.Settings}"
                                            Settings="{Binding ProviderSettings}"/>

                                        <Expander Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="2"
                                                  Background="{x:Null}"
                                                  Collapsed="Expander_OnCollapsed"
                                                  Padding="0"
                                                  Header="{x:Static locNtf:Localization.NotificationChannelsHeader}">
                                            <Expander.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="!!NotificationChannels.Count"/>
                                                    <Binding Path="$parent[ListBoxItem].IsSelected"/>
                                                </MultiBinding>
                                            </Expander.IsVisible>
                                            <ListBox ItemsSource="{Binding NotificationChannels}"
                                                     SelectedValueBinding="{Binding ProviderGuid}"
                                                     SelectionChanged="SelectorChannel_OnSelectionChanged"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     Classes="no-drag"
                                                     SelectedValue="{Binding ViewModel.NotificationSettingsSelectedChannel, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=local:NotificationSettingsPage}}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Background="Transparent" RowDefinitions="*,*,Auto"
                                                              ColumnDefinitions="Auto,*,Auto"
                                                              Margin="-12 4">
                                                            <!-- 图标 -->
                                                            <controls1:ReattachableContentPresenter Grid.Column="0" Grid.Row="0"
                                                                                                    Grid.RowSpan="2"
                                                                                                    Width="24" Height="24"
                                                                                                    VerticalAlignment="Center"
                                                                                                    ClipToBounds="True" Margin="6"
                                                                                                    ContentSource="{Binding ProviderInstance.IconElement}" />

                                                            <!-- 标题 -->
                                                            <TextBlock Grid.Column="1" Grid.Row="0"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding Name}"
                                                                       FontSize="14" FontWeight="Medium" />

                                                            <!-- 描述 -->
                                                            <TextBlock Grid.Column="1" Grid.Row="1"
                                                                       TextWrapping="Wrap"
                                                                       Classes="l-instructive"
                                                                       Text="{Binding Description}"
                                                                       FontSize="12" />
                                                            
                                                            <controls1:NotificationProviderSettingsIndicatorControl 
                                                                Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding ProviderSettings.IsSettingsEnabled}"
                                                                IsSettingsEnabled="{Binding ProviderSettings.IsSettingsEnabled}"
                                                                GlobalSettings="{Binding $parent[local:NotificationSettingsPage].ViewModel.SettingsService.Settings}"
                                                                Settings="{Binding ProviderSettings}"/>

                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Expander>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <TabItem >
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal"
                                        Classes="items-valign-center"
                                        Spacing="6">
                                <TextBlock Text="{x:Static locNtf:Localization.AdvancedSettingsTab}" />
                                <controls1:NotificationProviderSettingsIndicatorControl 
                                    VerticalAlignment="Center"
                                    IsSettingsEnabled="True"
                                    Margin="0 -2 0 2"
                                    GlobalSettings="{Binding ViewModel.SettingsService.Settings}"
                                    Settings="{Binding ViewModel.SettingsService.Settings}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer>
                            <StackPanel Margin="0 0 0 0" Classes="settings-container animated-intro">
                                <!-- 启用提醒语音 -->
                                <controls3:FASettingsExpander IconSource="{controls2:FluentIconSource &#xED53;}"
                                                            Header="{x:Static locNtf:Localization.EnableNotificationSpeech}"
                                                            Description="{x:Static locNtf:Localization.EnableNotificationSpeechDescription}"
                                                            IsExpanded="{Binding ViewModel.SettingsService.Settings.AllowNotificationSpeech, Mode=OneWay}">
                                    <controls3:FASettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.AllowNotificationSpeech, Mode=TwoWay}"/>
                                    </controls3:FASettingsExpander.Footer>
                                    
                                    <!-- 默认启用 -->
                                    <controls3:FASettingsExpanderItem>
                                        <CheckBox Content="{x:Static locNtf:Localization.EnableByDefault}" IsChecked="{Binding ViewModel.SettingsService.Settings.IsSpeechEnabled}"
                                                  Margin="0 0 0 6" />
                                    </controls3:FASettingsExpanderItem>
                                    <!-- 语音引擎 -->
                                    <controls3:FASettingsExpanderItem Content="{x:Static locNtf:Localization.SpeechEngine}">
                                        <controls3:FASettingsExpanderItem.Footer>
                                            <StackPanel>
                                                <ComboBox ItemsSource="{x:Static registry:SpeechProviderRegistryService.RegisteredProviders}"
                                                          SelectedValueBinding="{Binding Id}"
                                                          SelectedValue="{Binding ViewModel.SettingsService.Settings.SelectedSpeechProvider}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </controls3:FASettingsExpanderItem.Footer>
                                    </controls3:FASettingsExpanderItem>
                                    <!-- 语音引擎设置 -->
                                    <controls3:FASettingsExpanderItem Padding="0" MinHeight="0" Margin="0 0 0 -1">
                                        <controls3:FASettingsExpanderItem.Template>
                                            <ControlTemplate>
                                                <ContentPresenter Content="{TemplateBinding Content}"/>
                                            </ControlTemplate>
                                        </controls3:FASettingsExpanderItem.Template>
                                        <controls1:ReattachableContentPresenter
                                            ContentSource="{Binding ViewModel.SpeechProviderSettingsControl, Converter={x:Static ci:ElementConverters.ControlPreventNullConverter}}"/>
                                    </controls3:FASettingsExpanderItem>
                                    <!-- 语音音量 -->
                                    <controls3:FASettingsExpanderItem Content="{x:Static locNtf:Localization.SpeechVolume}">
                                        <controls3:FASettingsExpanderItem.Footer>
                                            <Slider Minimum="0" Maximum="1"
                                                    Value="{Binding ViewModel.SettingsService.Settings.SpeechVolume}"
                                                    TickFrequency="0.01"
                                                    Classes="auto-tooltip"
                                                    ci:SliderDragTooltipAssist.StringFormat="F2"
                                                    Width="150" />
                                        </controls3:FASettingsExpanderItem.Footer>
                                    </controls3:FASettingsExpanderItem>
                                    <!-- 测试朗读文本 -->
                                    <controls3:FASettingsExpanderItem Content="{x:Static locNtf:Localization.TestSpeechText}">
                                        <controls3:FASettingsExpanderItem.Footer>
                                            <TextBox Text="{Binding ViewModel.TestSpeechText}" />
                                        </controls3:FASettingsExpanderItem.Footer>
                                    </controls3:FASettingsExpanderItem>
                                    <!-- 测试语音 -->
                                    <controls3:FASettingsExpanderItem Content="{x:Static locNtf:Localization.TestSpeech}" IsClickEnabled="True"
                                                                    Click="ButtonTestSpeeching_OnClick"/>
                                </controls3:FASettingsExpander>

                                
                                <!-- 启用提醒强调特效 -->
                                <controls3:FASettingsExpander IconSource="{controls2:FluentIconSource &#xEA2F;}"
                                                            Header="{x:Static locNtf:Localization.EnableNotificationEffect}"
                                                            Description="{x:Static locNtf:Localization.EnableNotificationEffectDescription}"
                                                            IsExpanded="{Binding ViewModel.SettingsService.Settings.AllowNotificationEffect, Mode=OneWay}">
                                    <controls3:FASettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.AllowNotificationEffect, Mode=TwoWay}"/>
                                    </controls3:FASettingsExpander.Footer>
                                    <!-- 默认启用 -->
                                    <controls3:FASettingsExpanderItem>
                                        <CheckBox Content="{x:Static locNtf:Localization.EnableByDefault}" IsChecked="{Binding ViewModel.SettingsService.Settings.IsNotificationEffectEnabled}"
                                                  Margin="0 0 0 6" />
                                    </controls3:FASettingsExpanderItem>
                                    <controls3:FASettingsExpanderItem
                                        Description="{x:Static locNtf:Localization.NotificationEffectRenderingScaleDescription}"
                                        Content="{x:Static locNtf:Localization.NotificationEffectRenderingScale}"
                                        IconSource="{ci:FluentIconSource {ci:FI LayerDiagonalSparkleRegular}}">
                                        <controls3:FASettingsExpanderItem.Footer>
                                            <Slider Minimum="0.1" Maximum="1.5"
                                                    TickFrequency="0.05"
                                                    Width="150"
                                                    Value="{Binding ViewModel.SettingsService.Settings.NotificationEffectRenderingScale}"
                                                    Classes="auto-tooltip"
                                                    ci:SliderDragTooltipAssist.StringFormat="F2"
                                                    IsSnapToTickEnabled="True" />
                                        </controls3:FASettingsExpanderItem.Footer>
                                    </controls3:FASettingsExpanderItem>
                                </controls3:FASettingsExpander>
                                
                                <!-- 启用提醒音效 -->
                                <controls3:FASettingsExpander IconSource="{controls2:FluentIconSource &#xE649;}"
                                                            Header="{x:Static locNtf:Localization.EnableNotificationSound}"
                                                            Description="{x:Static locNtf:Localization.EnableNotificationSoundDescription}"
                                                            IsExpanded="{Binding ViewModel.SettingsService.Settings.AllowNotificationSound, Mode=OneWay}">
                                    <controls3:FASettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.AllowNotificationSound, Mode=TwoWay}"/>
                                    </controls3:FASettingsExpander.Footer>
                                    <!-- 默认启用 -->
                                    <controls3:FASettingsExpanderItem>
                                        <CheckBox Content="{x:Static locNtf:Localization.EnableByDefault}"
                                                  IsChecked="{Binding ViewModel.SettingsService.Settings.IsNotificationSoundEnabled}"
                                                  Margin="0 0 0 6" />
                                    </controls3:FASettingsExpanderItem>
                                    <controls3:FASettingsExpanderItem Content="{x:Static locNtf:Localization.NotificationSoundVolume}">
                                        <controls3:FASettingsExpanderItem.Footer>
                                            <Slider Grid.Row="1" Grid.Column="1"
                                                    Value="{Binding ViewModel.SettingsService.Settings.NotificationSoundVolume}"
                                                    Minimum="0" Maximum="1"
                                                    TickFrequency="0.01"
                                                    Width="150"
                                                    ci:SliderDragTooltipAssist.StringFormat="F2"
                                                    Classes="auto-tooltip"
                                                    IsSnapToTickEnabled="True" 
                                            />
                                        </controls3:FASettingsExpanderItem.Footer>
                                    </controls3:FASettingsExpanderItem>
                                    <!-- 自定义音效 -->
                                    <controls3:FASettingsExpanderItem
                                        IconSource="{ci:FluentIconSource &#xE6A5;}" Content="{x:Static locNtf:Localization.CustomNotificationSound}"
                                        Description="{x:Static locNtf:Localization.CustomNotificationSoundDescription}">
                                        <controls3:FASettingsExpanderItem.Footer>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBox MinWidth="150"
                                                         MaxWidth="150"
                                                         Watermark="{x:Static locNtf:Localization.NotificationSoundPathPlaceholder}"
                                                         Text="{Binding ViewModel.SettingsService.Settings.NotificationSoundPath}"
                                                         VerticalAlignment="Center"
                                                         Margin="0 0 2 0" />
                                                <controls1:FileBrowserButton
                                                    FileTypes="{x:Static local:NotificationSettingsPage.AudioFileTypes}"
                                                    Theme="{StaticResource TransparentButton}" Content="{ci:FluentIcon &#xE88D;}"
                                                    CurrentPath="{Binding ViewModel.SettingsService.Settings.NotificationSoundPath, Mode=TwoWay}"
                                                    VerticalAlignment="Center">
                                                </controls1:FileBrowserButton>
                                            </StackPanel>
                                        </controls3:FASettingsExpanderItem.Footer>
                                    </controls3:FASettingsExpanderItem>
                                </controls3:FASettingsExpander>

                                <!-- 置顶提醒 -->
                                <controls3:FASettingsExpander IconSource="{controls2:FluentIconSource &#xE1A1;}"
                                                            Header="{x:Static locNtf:Localization.TopmostNotification}"
                                                            IsExpanded="{Binding ViewModel.SettingsService.Settings.AllowNotificationTopmost, Mode=OneWay}"
                                                            Description="{x:Static locNtf:Localization.TopmostNotificationDescription}">
                                    <controls3:FASettingsExpander.Footer>
                                        <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.AllowNotificationTopmost, Mode=TwoWay}"/>
                                    </controls3:FASettingsExpander.Footer>
                                    <!-- 默认启用 -->
                                    <controls3:FASettingsExpanderItem>
                                        <CheckBox Content="{x:Static locNtf:Localization.EnableByDefault}" IsChecked="{Binding ViewModel.SettingsService.Settings.IsNotificationTopmostEnabled}"
                                                  Margin="0 0 0 6" />
                                    </controls3:FASettingsExpanderItem>
                                </controls3:FASettingsExpander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </controls1:ListDetailView.LeftContent>

        <controls1:ListDetailView.RightContent>
            <!-- 提醒详细信息 -->
            <ci:Emptiable Content="{Binding ViewModel.SelectedRegisterInfo}">
                <ci:Emptiable.ContentTemplate>
                    <DataTemplate x:DataType="notification1:INotificationSenderRegisterInfo">
                        <TabControl Classes="compact" Padding="0">
                            <TabItem Header="{x:Static locNtf:Localization.BasicSettingsTab}">
                                <Grid RowDefinitions="Auto,*">
                                    <controls1:ReattachableContentPresenter Grid.Row="1" ClipToBounds="True"
                                                                                  ContentSource="{Binding ProviderInstance.SettingsElement, Converter={x:Static ci:ElementConverters.ControlPreventNullConverter}}" />
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                IsVisible="{Binding ProviderInstance.SettingsElement, Converter={x:Static ObjectConverters.IsNull}}">
                                        <ci:FluentIcon Glyph="&#xEF26;" Width="72" Height="72"
                                                       FontSize="72" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Static locNtf:Localization.ProviderNoSettings}" TextWrapping="Wrap"
                                                   Margin="0 8 0 0" />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal"
                                                Classes="items-valign-center"
                                                Spacing="6">
                                        <TextBlock Text="{x:Static locNtf:Localization.AdvancedSettingsTab}" />
                                        <controls1:NotificationProviderSettingsIndicatorControl 
                                            Margin="0 -2 0 2"
                                            IsSettingsEnabled="{Binding ProviderSettings.IsSettingsEnabled}"
                                            GlobalSettings="{Binding ViewModel.SettingsService.Settings, RelativeSource={RelativeSource AncestorType=local:NotificationSettingsPage}}"
                                            Settings="{Binding ProviderSettings}"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer>
                                    <StackPanel Classes="animated-intro settings-container"
                                                Margin="0">
                                        <!-- 对此提醒来源启用特殊高级设置 -->
                                        <controls3:FASettingsExpander IconSource="{controls2:FluentIconSource &#xe02f;}"
                                                                    Header="{x:Static locNtf:Localization.EnablePerProviderAdvancedSettings}"
                                                                    Description="{x:Static locNtf:Localization.EnablePerProviderAdvancedSettingsDescription}">
                                            <controls3:FASettingsExpander.Footer>
                                                <ToggleSwitch
                                                    IsChecked="{Binding ProviderSettings.IsSettingsEnabled, Mode=TwoWay}" />
                                            </controls3:FASettingsExpander.Footer>
                                        </controls3:FASettingsExpander>
                                        <Separator Margin="0 4" />
                                        <controls3:FAInfoBar Message="{x:Static locNtf:Localization.EnablePerProviderAdvancedSettingsDescription}"
                                                           IsClosable="False" IsOpen="True"
                                                           IsVisible="{Binding ProviderSettings.IsSettingsEnabled}" />
                                        <!-- 启用提醒语音 -->
                                        <controls3:FASettingsExpander IconSource="{controls2:FluentIconSource &#xED53;}"
                                                                    IsEnabled="{Binding ProviderSettings.IsSettingsEnabled}"
                                                                    Header="{x:Static locNtf:Localization.EnableNotificationSpeech}"
                                                                    Description="{x:Static locNtf:Localization.EnableNotificationSpeechDescription}">
                                            <controls3:FASettingsExpander.Footer>
                                                <ToggleSwitch
                                                    IsChecked="{Binding ProviderSettings.IsSpeechEnabled, Mode=TwoWay}" />
                                            </controls3:FASettingsExpander.Footer>
                                        </controls3:FASettingsExpander>

                                        <!-- 启用提醒强调特效 -->
                                        <controls3:FASettingsExpander IconSource="{controls2:FluentIconSource &#xEA2F;}"
                                                                    IsEnabled="{Binding ProviderSettings.IsSettingsEnabled}"
                                                                    Header="{x:Static locNtf:Localization.EnableNotificationEffect}"
                                                                    Description="{x:Static locNtf:Localization.EnableNotificationEffectDescription}">
                                            <controls3:FASettingsExpander.Footer>
                                                <ToggleSwitch
                                                    IsChecked="{Binding ProviderSettings.IsNotificationEffectEnabled, Mode=TwoWay}" />
                                            </controls3:FASettingsExpander.Footer>
                                        </controls3:FASettingsExpander>

                                        <!-- 启用提醒音效 -->
                                        <controls3:FASettingsExpander IconSource="{controls2:FluentIconSource &#xE649;}"
                                                                    IsEnabled="{Binding ProviderSettings.IsSettingsEnabled}"
                                                                    Header="{x:Static locNtf:Localization.EnableNotificationSound}"
                                                                    Description="{x:Static locNtf:Localization.EnableNotificationSoundDescription}"
                                                                    IsExpanded="{Binding ProviderSettings.IsNotificationSoundEnabled, Mode=OneWay}">
                                            <controls3:FASettingsExpander.Footer>
                                                <ToggleSwitch
                                                    IsChecked="{Binding ProviderSettings.IsNotificationSoundEnabled, Mode=TwoWay}" />
                                            </controls3:FASettingsExpander.Footer>
                                            <!-- 自定义音效 -->
                                            <controls3:FASettingsExpanderItem
                                                IconSource="{ci:FluentIconSource &#xE6A5;}" Content="{x:Static locNtf:Localization.CustomNotificationSound}"
                                                Description="{x:Static locNtf:Localization.CustomNotificationSoundDescription}">
                                                <controls3:FASettingsExpanderItem.Footer>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <TextBox MinWidth="150"
                                                                 MaxWidth="150"
                                                                 Watermark="{x:Static locNtf:Localization.NotificationSoundPathPlaceholder}"
                                                                 Text="{Binding ProviderSettings.NotificationSoundPath}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0 0 2 0" />
                                                        <controls1:FileBrowserButton
                                                            FileTypes="{x:Static local:NotificationSettingsPage.AudioFileTypes}"
                                                            Theme="{StaticResource TransparentButton}"
                                                            Content="{ci:FluentIcon &#xE88D;}"
                                                            CurrentPath="{Binding ProviderSettings.NotificationSoundPath, Mode=TwoWay}"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </controls3:FASettingsExpanderItem.Footer>
                                            </controls3:FASettingsExpanderItem>
                                        </controls3:FASettingsExpander>

                                        <!-- 置顶提醒 -->
                                        <controls3:FASettingsExpander IconSource="{controls2:FluentIconSource &#xE1A1;}"
                                                                    IsEnabled="{Binding ProviderSettings.IsSettingsEnabled}"
                                                                    Header="{x:Static locNtf:Localization.TopmostNotification}"
                                                                    Description="{x:Static locNtf:Localization.TopmostNotificationDescription}">
                                            <controls3:FASettingsExpander.Footer>
                                                <ToggleSwitch
                                                    IsChecked="{Binding ProviderSettings.IsNotificationTopmostEnabled, Mode=TwoWay}" />
                                            </controls3:FASettingsExpander.Footer>
                                        </controls3:FASettingsExpander>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                        
                    </DataTemplate>
                </ci:Emptiable.ContentTemplate>
            </ci:Emptiable>
        </controls1:ListDetailView.RightContent>
    </controls1:ListDetailView>
</controls:SettingsPageBase>
