<ci:ViewBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ci="http://classfabric.tech/schemas/xaml/core"
        xmlns:views="clr-namespace:ClassIsland.Views"
        xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:profile="clr-namespace:ClassIsland.Shared.Models.Profile;assembly=ClassFabric.Shared"
        xmlns:services="clr-namespace:ClassIsland.Core.Abstractions.Services;assembly=ClassFabric.Core"
        xmlns:controls1="clr-namespace:ClassIsland.Controls"
        xmlns:converters="clr-namespace:ClassIsland.Converters"
        xmlns:timeLine="clr-namespace:ClassIsland.Controls.TimeLine"
        xmlns:input="clr-namespace:Avalonia.Labs.Input;assembly=Avalonia.Labs.CommandManager"
        xmlns:data="clr-namespace:FluentAvalonia.UI.Data;assembly=FluentAvalonia"
        xmlns:automation="clr-namespace:ClassIsland.Core.Controls.Automation;assembly=ClassFabric.Core"
        xmlns:behaviors="clr-namespace:ClassIsland.Behaviors"
        xmlns:profile1="clr-namespace:ClassIsland.Core.Enums.Profile;assembly=ClassFabric.Core"
        xmlns:scheduleDataGrid="clr-namespace:ClassIsland.Controls.ScheduleDataGrid"
        xmlns:scheduleWeek="clr-namespace:ClassIsland.Controls.ScheduleWeekEdit"
        xmlns:profile2="clr-namespace:ClassIsland.Models.Profile"
        xmlns:locPw="clr-namespace:ClassFabric.Assets.Localization.Windows.ProfileSettings"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ClassIsland.Views.ProfileSettingsWindow"
        Header="{x:Static locPw:Localization.ProfileEditorHeader}"
        d:DataContext="{d:DesignInstance views:ProfileSettingsWindow}"
        Icon="/Assets/AppLogo.ico"
        MinWidth="750"
        HostWidth="1100" HostHeight="600"
        Closing="Window_OnClosing"
        Closed="Window_OnClosed"
        Loaded="Control_OnLoaded">
    <input:CommandManager.CommandBindings>
        <input:CommandBinding Command="{x:Static views:ProfileSettingsWindow.RemoveSelectedTimeLayoutItemCommand}"
                              Executed="CommandBindingRemoveTimePoint_OnExecuted"/>
    </input:CommandManager.CommandBindings>
    <ci:ViewBase.DataTemplates>
    </ci:ViewBase.DataTemplates>
    <ci:ViewBase.Resources>
        <converters:StringToColorConverter x:Key="StringToColorConverter"/>
        <converters:SubjectIconSourceConverter x:Key="SubjectIconSourceConverter"/>
        <converters:SubjectColorBrushConverter x:Key="SubjectColorBrushConverter"/>
        <ci:CustomKeyDictionaryValueConverter x:TypeArguments="system:Guid, profile:Subject"
                                              x:Key="SubjectIdToSubjectConverter"
                                              Dictionary="{Binding ViewModel.ProfileService.Profile.Subjects}"/>
        <ci:CustomKeyDictionaryValueConverter x:TypeArguments="system:Guid, profile:ClassPlanGroup"
                                              x:Key="ClassPlanGroupIdToClassPlanGroupConverter"
                                              Dictionary="{Binding ViewModel.ProfileService.Profile.ClassPlanGroups}"/>
        <views:ClassPlanTreeDropHandler x:Key="ClassPlanTreeDropHandler"/>
        <views:SubjectDataGridDropHandler x:Key="SubjectDataGridDropHandler"/>
        <views:ScheduleItemDataGridDropHandler x:Key="ScheduleItemDataGridDropHandler"/>
        <profile:Subject x:Key="UnspecifiedScheduleSubject" Name="未指定科目" Initial="未"/>
        <ci:BindingProxy x:TypeArguments="profile:ClassPlanGroup"
                         x:Key="ClassPlanGroupBindingProxy"
                         Data="{Binding ViewModel.ProfileService.Profile.SelectedClassPlanGroupId, Converter={StaticResource ClassPlanGroupIdToClassPlanGroupConverter}, Mode=OneWay}"/>
        <converters:DictionaryKeyFinderMultiConverter x:TypeArguments="profile:TimeLayout"
                                                      x:Key="TimeLayoutDictionaryKeyFinderMultiConverter" />
        <converters:DictionaryKeyFinderMultiConverter x:TypeArguments="profile:ClassPlan"
                                                      x:Key="ClassPlanDictionaryKeyFinderMultiConverter" />

        <ScrollViewer x:Key="ClassPlansInfoEditor" Width="332"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding ViewModel.SelectedClassPlan}"
                        Spacing="8"
                        Margin="16">
                <TextBlock Text="{x:Static locPw:Localization.ClassPlanInfoHeader}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <controls:FAInfoBar Message="{x:Static locPw:Localization.ClassPlanOverlayInfoBarMessage}" IsVisible="{Binding IsOverlay}"/>
                <ci:Field Label="{x:Static locPw:Localization.NameLabel}">
                    <TextBox Text="{Binding Name}"/>
                </ci:Field>
                <ci:Field Label="{x:Static locPw:Localization.TimeLayoutLabel}">
                    <ComboBox SelectedValue="{Binding TimeLayoutId}"
                              SelectedValueBinding="{Binding Key}"
                              ItemsSource="{Binding $parent[views:ProfileSettingsWindow].ViewModel.TimeLayouts.List}"
                              SelectedItem="{Binding $parent[views:ProfileSettingsWindow].ViewModel.ClassPlanInfoSelectedTimeLayoutKvp}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value.Name}"
                                           ToolTip.Tip="{Binding Key}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ci:Field>
                <ci:Field Label="{x:Static locPw:Localization.ClassPlanGroupLabel}">
                    <ComboBox SelectedValue="{Binding AssociatedGroup, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Key}"
                              ItemsSource="{Binding $parent[views:ProfileSettingsWindow].ViewModel.ClassPlanGroups.List}"
                              SelectedItem="{Binding $parent[views:ProfileSettingsWindow].ViewModel.ClassPlanInfoSelectedClassPlanGroupKvp}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value.Name}"
                                           ToolTip.Tip="{Binding Key}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ci:Field>
                <CheckBox IsEnabled="{Binding IsOverlay, Converter={StaticResource InvertBooleanConverter}}" Margin="0 8 0 0" Content="{x:Static locPw:Localization.AutoEnable}" IsChecked="{Binding IsEnabled}"/>
                <TextBlock Text="{x:Static locPw:Localization.OverlayIgnoresTriggerRulesDescription}" 
                           Margin="0 0 0 4"
                           IsVisible="{Binding IsOverlay}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Static locPw:Localization.AutoEnableByTriggerRulesDescription}" 
                           Classes="l-instructive"
                           TextWrapping="Wrap">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsEnabled"/>
                            <Binding Path="!IsOverlay"/>
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock Text="{x:Static locPw:Localization.ManualEnableOnlyDescription}" 
                           Classes="l-instructive"
                           TextWrapping="Wrap">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsEnabled"/>
                            <Binding Path="!IsOverlay"/>
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <StackPanel IsEnabled="{Binding IsOverlay, Converter={StaticResource InvertBooleanConverter}}" 
                            IsVisible="{Binding IsEnabled}">
                    <controls1:TimeRuleEditControl x:Name="ClassPlanTimeRuleEditControl"
                                                   TimeRule="{Binding TimeRule, Mode=OneWay}"/>
                </StackPanel>
                <!-- 附加属性 -->
                <Separator Margin="0 16 0 8"/>
                <ci:IconText Glyph="&#xef2b;" Text="{x:Static locPw:Localization.MoreOptionsLabel}" Margin="0 0 0 8"/>
                <ItemsControl ItemsSource="{x:Static services:IAttachedSettingsHostService.ClassPlanSettingsAttachedSettingsControls}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ci:AttachedSettingsControlPresenter ControlInfo="{Binding}"
                                                               TargetObject="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedClassPlan}">
                                <ci:AttachedSettingsControlPresenter.ContentId>
                                    <MultiBinding
                                        Converter="{StaticResource ClassPlanDictionaryKeyFinderMultiConverter}"
                                        Mode="OneWay">
                                        <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.SelectedClassPlan"/>
                                        <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ProfileService.Profile.ClassPlans"/>
                                    </MultiBinding>
                                </ci:AttachedSettingsControlPresenter.ContentId>
                            </ci:AttachedSettingsControlPresenter>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <Grid x:Key="ProfileManager" Margin="16" Width="300" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" >
                <TextBlock Text="{x:Static locPw:Localization.ManageProfilesHeader}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="{x:Static locPw:Localization.ManageProfilesDescription}" TextWrapping="Wrap"
                           Margin="0 6 0 0"/>
                <ci:Field Label="(test) ScheduleType">
                    <ComboBox SelectedIndex="{Binding ViewModel.ProfileService.Profile.ScheduleType, Converter={x:Static ci:EnumToIntConverter.Instance}}">
                        <ComboBoxItem Content="{x:Static locPw:Localization.ScheduleTypeClassic}"/>
                        <ComboBoxItem Content="{x:Static locPw:Localization.ScheduleTypeExperimental}"/>
                    </ComboBox>
                </ci:Field>
                <!--<TextBlock Text="{Binding MainViewModel.Settings.SelectedProfile, Mode=OneWay}"/>-->
                <WrapPanel Margin="0 6 0 0" Classes="animated-resize">
                    <Button ToolTip.Tip="{x:Static locPw:Localization.CreateProfileTip}" Click="ButtonCreateProfile_OnClick"
                            Theme="{StaticResource TransparentButton}">
                        <ci:IconText Glyph="&#xE689;" Text="{x:Static locPw:Localization.CreateProfileLabel}"/>
                    </Button>
                    <Button ToolTip.Tip="{x:Static locPw:Localization.OpenProfileFolderTip}" Click="ButtonOpenProfileFolder_OnClick"
                            Theme="{StaticResource TransparentButton}">
                        <ci:IconText Glyph="&#xE88D;" Text="{x:Static locPw:Localization.OpenFolderLabel}"/>
                    </Button>
                    <Button ToolTip.Tip="{x:Static locPw:Localization.RefreshProfilesTip}" Click="ButtonRefreshProfiles_OnClick"
                            Theme="{StaticResource TransparentButton}">
                        <ci:IconText Glyph="&#xE0B5;" Text="{x:Static locPw:Localization.RefreshLabel}"/>
                    </Button>
                </WrapPanel>
            </StackPanel>
            <ListBox Grid.Row="1" Margin="0 12 0 0"
                     SelectedValue="{Binding ViewModel.SelectedProfile, Mode=TwoWay}"
                     SelectionMode="Single"
                     ItemsSource="{Binding ViewModel.Profiles, Mode=OneWay}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="ContextFlyout">
                            <MenuFlyout>
                                <MenuItem Icon="{ci:FluentIcon &#xEE7D;}" Header="{x:Static locPw:Localization.RenameLabel}" Click="MenuItemRenameProfile_OnClick"/>
                                <MenuItem Icon="{ci:FluentIcon &#xE58B;}" Header="{x:Static locPw:Localization.DuplicateLabel}" Click="MenuItemProfileDuplicate_OnClick"/>
                                <!--<MenuItem Icon="{materialDesign:PackIcon FileExportOutline}" Header="导出"/>-->
                                <MenuItem Icon="{ci:FluentIcon &#xE61D;}" Header="{x:Static locPw:Localization.DeleteLabel}" Click="MenuItemDeleteProfile_OnClick"/>
                            </MenuFlyout>
                        </Setter>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Background="Transparent">
                            <StackPanel.Resources>
                                <ci:StringToRadioButtonSelectionConverter x:Key="StringToRadioButtonSelectionConverter" />
                            </StackPanel.Resources>
                            <RadioButton GroupName="ProfileSelection" VerticalAlignment="Center"
                                         Command="{Binding $parent[views:ProfileSettingsWindow].ProfileSelectionRadioButtonToggledCommand}"
                                         CommandParameter="{Binding}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource StringToRadioButtonSelectionConverter}">
                                        <Binding Path="ViewModel.SettingsService.Settings.SelectedProfile" 
                                                 RelativeSource="{RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}"/>
                                        <Binding Mode="OneWay"/>
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0 0 0 0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        
        <!-- 时间表信息 -->
        <ScrollViewer x:Key="TimeLayoutInfoEditor" Width="332" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16"  
                        Spacing="8"
                        DataContext="{Binding ViewModel.SelectedTimeLayout}">
                <TextBlock Text="{x:Static locPw:Localization.TimeLayoutInfoHeader}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                <ci:Field Label="{x:Static locPw:Localization.NameLabel}">
                    <TextBox Margin="0 4 0 0"
                             Text="{Binding Name}"/>
                </ci:Field>
                <!-- 附加属性 -->
                <Separator Margin="0 8 0 0"/>
                <ci:IconText Glyph="&#xef2b;" Text="{x:Static locPw:Localization.MoreOptionsLabel}"/>
                <ItemsControl ItemsSource="{x:Static services:IAttachedSettingsHostService.TimeLayoutSettingsAttachedSettingsControls}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ci:AttachedSettingsControlPresenter ControlInfo="{Binding}" 
                                                                   TargetObject="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimeLayout}">
                                <ci:AttachedSettingsControlPresenter.ContentId>
                                    <MultiBinding
                                        Converter="{StaticResource TimeLayoutDictionaryKeyFinderMultiConverter}"
                                        Mode="OneWay">
                                        <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.SelectedTimeLayout"/>
                                        <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ProfileService.Profile.TimeLayouts"/>
                                    </MultiBinding>
                                </ci:AttachedSettingsControlPresenter.ContentId>
                            </ci:AttachedSettingsControlPresenter>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <ci:PreventNullConverter x:Key="PreventNullConverter" />
        <Grid  Margin="16" Width="300" x:Key="TemporaryClassPlan">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{x:Static locPw:Localization.CurrentClassPlanHeader}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                        <ToggleSwitch VerticalAlignment="Center" Margin="0 -6"
                                      OnContent="{x:Static locPw:Localization.LoadClassPlanToggle}" OffContent="{x:Static locPw:Localization.LoadClassPlanToggle}"
                                      IsChecked="{Binding ViewModel.LessonsService.IsClassPlanEnabled}"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ViewModel.ProfileService.Profile.OverlayClassPlanId, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Separator Margin="0 16 0 4"/>
                        <ci:IconText Glyph="&#xEA2F;" Text="{x:Static locPw:Localization.OverlayLabel}" Margin="0 0 0 8"/>
                        <TextBlock Text="{x:Static locPw:Localization.OverlayPriorityDescription}"
                                   Classes="l-instructive"
                                   TextWrapping="Wrap"
                                   Margin="0 0 0 4"/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleSwitch VerticalAlignment="Center" Margin="0 -6"
                                          OnContent="{x:Static locPw:Localization.EnableOverlayToggle}" OffContent="{x:Static locPw:Localization.EnableOverlayToggle}"
                                          IsChecked="{Binding ViewModel.ProfileService.Profile.IsOverlayClassPlanEnabled}"/>
                        </StackPanel>
                        <Button Theme="{StaticResource TransparentButton}" Margin="0 4 0 0"
                                HorizontalAlignment="Left"
                                Click="ButtonClearTempOverlay_OnClick"
                                ToolTip.Tip="{x:Static locPw:Localization.ClearOverlayTip}">
                            <ci:IconText Glyph="&#xE1BC;" Text="{x:Static locPw:Localization.ClearOverlayLabel}"/>
                        </Button>
                    </StackPanel>

                    <Separator Margin="0 16 0 4"/>
                    <ci:IconText Glyph="&#xE6B1;" Text="{x:Static locPw:Localization.TempClassPlanLabel}" Margin="0 0 0 8"/>
                    <TextBlock Text="{x:Static locPw:Localization.TempClassPlanDescription}" TextWrapping="Wrap"
                               Classes="l-instructive"/>
                    <Button Theme="{StaticResource TransparentButton}" 
                            HorizontalAlignment="Left"
                            ToolTip.Tip="{x:Static locPw:Localization.ClearTempClassPlanTip}"
                            Margin="0 6 0 0"
                            Click="ButtonClearTemporaryClassPlan_OnClick">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}"
                                          Mode="OneWay">
                                <Binding Path="!ViewModel.ProfileService.Profile.IsOverlayClassPlanEnabled"/>
                                <Binding Path="!ViewModel.ProfileService.Profile.HasOverlayClassPlan"/>
                            </MultiBinding>
                        </Button.IsVisible>
                        <ci:IconText Glyph="&#xE1BC;" Text="{x:Static locPw:Localization.ClearTempClassPlanLabel}"/>
                    </Button>
                    <TextBlock Text="{x:Static locPw:Localization.TempClassPlanCoveredByOverlayDescription}"
                               TextWrapping="Wrap"
                               Margin="0 4 0 0">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="ViewModel.ProfileService.Profile.IsOverlayClassPlanEnabled"/>
                                <Binding Path="ViewModel.ProfileService.Profile.HasOverlayClassPlan"/>
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding ViewModel.TempClassPlanList.Items}"
                         Margin="0 12 0 0"
                         SelectionMode="Single"
                         SelectedValue="{Binding ViewModel.ProfileService.Profile.TempClassPlanId, Mode=TwoWay, Converter={StaticResource PreventNullConverter}}"
                         SelectedValueBinding="{Binding Key}"
                         SelectionChanged="ListBoxTempClassPlanSelector_OnSelectionChanged">
                    <ListBox.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}"
                                      Mode="OneWay">
                            <Binding Path="!ViewModel.ProfileService.Profile.IsOverlayClassPlanEnabled"/>
                            <Binding Path="!ViewModel.ProfileService.Profile.HasOverlayClassPlan"/>
                        </MultiBinding>
                    </ListBox.IsVisible>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Mode=OneWay}"
                                      IsHitTestVisible="False"
                                      Focusable="False"
                                      HorizontalAlignment="Stretch">
                                <CheckBox.Content>
                                    <TextBlock Text="{Binding Value.Name}"
                                               VerticalAlignment="Center"/>
                                </CheckBox.Content>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2">
                    <Separator Margin="0 16 0 4" />
                    <ci:IconText Glyph="&#xE304;" Text="{x:Static locPw:Localization.WeekOffsetHeader}" Margin="0 0 0 8" />
                    <Button Theme="{StaticResource TransparentButton}"
                            HorizontalAlignment="Left">
                        <Button.Flyout>
                            <Flyout>
                                <Border>
                                    <controls1:WeekOffsetSettingsControl
                                        x:Name="WeekOffsetSettingsControl"/>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <ci:IconText Glyph="&#xE324;" Text="{x:Static locPw:Localization.AdjustWeekOffsetLabel}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        
        <!-- 课表群管理 -->
        <ci:TempClassPlanGroupTypeToIntConverter x:Key="TempClassPlanGroupTypeToIntConverter" />
        <Grid  Margin="16" Width="300" x:Key="ClassPlanGroups">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{x:Static locPw:Localization.ClassPlanGroupLabel}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0 6 0 0">
                        <Run Text="{x:Static locPw:Localization.ClassPlanGroupsIntroPrefix}" /><ci:NavHyperlink NavTarget="https://docs.classisland.tech/app/profile/classplan#%E8%AF%BE%E8%A1%A8%E7%BE%A4" Content="{x:Static locPw:Localization.LearnMoreLabel}" />
                    </TextBlock>
                    <StackPanel IsVisible="{Binding ViewModel.ProfileService.Profile.TempClassPlanGroupId, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Separator Margin="0 12 0 4" />
                        <ci:IconText Glyph="&#xE92F;" Text="{x:Static locPw:Localization.TempClassPlanGroupLabel}" Margin="0 0 0 4" />
                        <Border DataContext="{Binding ViewModel.ProfileService.Profile.TempClassPlanGroupId, Converter={StaticResource ClassPlanGroupIdToClassPlanGroupConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static locPw:Localization.CurrentPrefixLabel}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Theme="{StaticResource TransparentButton}"
                                        VerticalAlignment="Center"
                                        Click="ButtonClearTempClassPlanGroup_OnClick">
                                    <ci:IconText Glyph="&#xE1BC;" Text="{x:Static locPw:Localization.ClearLabel}" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Grid ColumnDefinitions="Auto,Auto,*,*">
                            <ToggleSwitch Grid.Column="0" VerticalAlignment="Center"
                                          Margin="0 -8"
                                          OnContent="" OffContent=""
                                          IsChecked="{Binding ViewModel.ProfileService.Profile.IsTempClassPlanGroupEnabled}" />
                            <ci:Field Grid.Column="2" Label="{x:Static locPw:Localization.ExpireDateLabel}">
                                <CalendarDatePicker VerticalAlignment="Center"
                                                    SelectedDate="{Binding ViewModel.ProfileService.Profile.TempClassPlanGroupExpireTime}" />
                                </ci:Field>
                            <ci:Field Grid.Column="3" Label="{x:Static locPw:Localization.OverrideModeLabel}" Margin="2 0 0 0">
                                <ComboBox SelectedIndex="{Binding ViewModel.ProfileService.Profile.TempClassPlanGroupType, Converter={StaticResource TempClassPlanGroupTypeToIntConverter}}"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="{x:Static locPw:Localization.OverrideLabel}" />
                                    <ComboBoxItem Content="{x:Static locPw:Localization.InheritLabel}" />
                                </ComboBox>
                            </ci:Field>
                        </Grid>
                    </StackPanel>
                    <Separator Margin="0 12 0 4" />
                    <ci:IconText Glyph="&#xE92F;" Text="{x:Static locPw:Localization.ManageClassPlanGroupsLabel}" Margin="0 0 0 4"/>
                    
                    <WrapPanel Orientation="Horizontal" Classes="animated-resize">
                        <Button Theme="{StaticResource TransparentButton}" 
                                HorizontalAlignment="Left"
                                ToolTip.Tip="{x:Static locPw:Localization.CreateClassPlanGroupTip}"
                                Margin="2"
                                Click="ButtonNewClassPlanGroups_OnClick">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanAndExpressionMultiConverter}" Mode="OneWay">
                                    <Binding Path="ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing" Mode="OneWay" Converter="{StaticResource InvertBooleanConverter}"/>
                                    <Binding Path="ViewModel.ManagementService.Policy.DisableProfileEditing" Mode="OneWay" Converter="{StaticResource InvertBooleanConverter}"/>
                                </MultiBinding>
                            </Button.IsEnabled>
                            <ci:IconText Glyph="&#xE00D;" Text="{x:Static locPw:Localization.CreateClassPlanGroupLabel}"/>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding ViewModel.ClassPlanGroups.List}"
                         Margin="0 4 0 0"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls1:ClassPlanGroupItemControl Item="{Binding Value, Mode=OneWay}" 
                                                                Key="{Binding Key, Mode=OneWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
        
        <Flyout x:Key="ChangeClassFlyout">
            <StackPanel Width="250">
                <TextBlock Text="{x:Static locPw:Localization.ChangeClassHeader}"
                           Theme="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0 0 0 8" />
                <ci:Field Label="{x:Static locPw:Localization.ChangeClassToSelectorLabel}">
                    <ComboBox HorizontalAlignment="Stretch"
                              Margin="0 0 0 8"
                              ItemsSource="{Binding ViewModel.Subjects.List, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValueBinding="{Binding Key}"
                              SelectedValue="{Binding ViewModel.TargetSubjectIndex}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value.Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ci:Field>
                <CheckBox
                    IsEnabled="{Binding !ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing}"
                    IsChecked="{Binding ViewModel.IsTempSwapMode, Converter={StaticResource InvertBooleanConverter}}"
                    Margin="0 0 0 8"
                    Content="{x:Static locPw:Localization.TempSwapModeLabel}" />
                <Button Click="ButtonEditClassInfoTempConfirm_OnClick"
                        HorizontalAlignment="Left"
                        Classes="accent"
                        IsEnabled="{Binding ViewModel.TargetSubjectIndex, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static system:Guid.Empty}}">
                    <ci:IconText Glyph="&#xE424;" Text="{x:Static locPw:Localization.OKLabel}" />
                </Button>
            </StackPanel>
        </Flyout>
        
        <Flyout x:Key="CreateOverlayFlyout">
            <StackPanel Spacing="12" Width="250">
                <TextBlock Text="{x:Static locPw:Localization.CreateOverlayHeader}" FontWeight="Bold" />
                <ci:Field Label="{x:Static locPw:Localization.TimeLayoutLabel}">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ViewModel.TimeLayouts.List}"
                        SelectedValueBinding="{Binding Key}"
                        SelectedValue="{Binding ViewModel.TempOverlayClassPlanTimeLayoutId}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value.Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ci:Field>
                <ci:Field Label="{x:Static locPw:Localization.EnableDateLabel}">
                    <CalendarDatePicker
                        HorizontalAlignment="Stretch"
                        SelectedDate="{Binding ViewModel.OverlayEnableDateTime}" />
                </ci:Field>
                <CheckBox IsChecked="{Binding ViewModel.TempOverlayCreateTimeLayout}"
                          Content="{x:Static locPw:Localization.AlsoCreateTempTimeLayout}" />
                <Button HorizontalAlignment="Right"
                        Click="ButtonCreateTempOverlayClassPlan_OnClick"
                        Classes="accent">
                    <ci:IconText Glyph="&#xE424;" Text="{x:Static locPw:Localization.CreateLabel}" />
                </Button>
            </StackPanel>
        </Flyout>
        
        <Flyout x:Key="DeleteClassPlanConfirmFlyout">
            <StackPanel Spacing="8">
                <TextBlock FontWeight="Bold">
                    <Run Text="{x:Static locPw:Localization.DeleteClassPlanConfirmPrefix}" />
                    <Run
                        Text="{Binding ViewModel.SelectedClassPlan.Name}" />
                    <Run Text="{x:Static locPw:Localization.DeleteClassPlanConfirmSuffix}" />
                </TextBlock>
                <TextBlock Text="{x:Static locPw:Localization.CannotBeUndoneDescription}" />
                <Button Content="{x:Static locPw:Localization.DeleteLabel}" Classes="accent"
                        Click="ButtonDeleteSelectedClassPlan_OnClick" />
            </StackPanel>
        </Flyout>

        <Grid x:Key="ProfileMigrationsDebugDrawer"
              Width="600" Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <TextBlock Text="{x:Static locPw:Localization.ProfileMigrationsDebugHeader}" Theme="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Grid.Row="1" Text="{x:Static locPw:Localization.ProfileMigrationsDebugDescription}"
                       TextWrapping="Wrap" />
            <DataGrid Grid.Row="2" x:Name="ProfileMigrationsDataGrid"
                      ItemsSource="{Binding ViewModel.ProfileService.Profile.Migrations}"
                      AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static locPw:Localization.MigrationIdColumnHeader}" Width="*"
                                        Binding="{Binding Id, Mode=TwoWay}" />
                    <DataGridCheckBoxColumn Header="{x:Static locPw:Localization.AllowDowngradeColumnHeader}"
                                            Binding="{Binding AllowDowngrade, Mode=TwoWay}" />
                    <DataGridCheckBoxColumn Header="{x:Static locPw:Localization.RemoveOnDowngradeColumnHeader}"
                                            Binding="{Binding RemoveOnDowngrade, Mode=TwoWay}" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static locPw:Localization.AddNewLabel}" Command="{Binding ViewModel.AddProfileMigrationCommand}" />
                <Button Content="{x:Static locPw:Localization.DeleteSelectedItemLabel}" Command="{Binding ViewModel.RemoveProfileMigrationCommand}"
                        CommandParameter="{Binding #ProfileMigrationsDataGrid.SelectedItem}" />
            </StackPanel>
        </Grid>

        <Grid x:Key="ProfileTransferDrawer"
              Width="600"
              ClipToBounds="True"
              RowDefinitions="Auto,*,Auto,Auto"
              IsEnabled="{Binding !ViewModel.IsTransferring}">
            <Grid Grid.Row="0"
                  Margin="16 16 16 0"
                  IsVisible="{Binding !ViewModel.SelectedTransferInfo.HidePageTitle}"
                  Classes.FullWidth="{Binding ViewModel.SelectedTransferInfo.UseFullWidth, TargetNullValue={x:False}, FallbackValue={x:False}}"
                  x:Name="ProfileTransferDrawerTitleContainer">
                <Grid.Styles>
                    <Style Selector="Grid#ProfileTransferDrawerTitleContainer:not(.FullWidth)">
                        <Setter Property="MaxWidth" Value="{StaticResource SettingsContainerWidth}" />
                    </Style>
                </Grid.Styles>
                <TextBlock FontWeight="Normal"
                           Text="{Binding ViewModel.SelectedTransferInfo.Name, FallbackValue=''}"
                           Theme="{StaticResource TitleTextBlockStyle}" />
            </Grid>
            <ci:Lazy Grid.Row="1"
                     Content="{Binding ViewModel.TransferProviderContent}" />
            <Separator Grid.Row="2" Margin="12 0" />
            <Border Grid.Row="3" Padding="12">
                <Grid>
                    <controls:FAProgressRing Width="32"
                                             Height="32"
                                             IsActive="{Binding ViewModel.IsTransferring}"
                                             IsIndeterminate="True"
                                             IsVisible="{Binding ViewModel.IsTransferring}" />
                    <Button Classes="accent"
                            Click="ButtonInvokeTransfer_OnClick"
                            HorizontalAlignment="Right"
                            Padding="32 6">
                        <Button.Content>
                            <Binding Path="ViewModel.SelectedTransferInfo.Type"
                                     Converter="{x:Static views:ProfileSettingsWindow.ProfileTransferProviderTypeToImportButtonTextConverter}">
                                <Binding.FallbackValue>
                                    <profile1:ProfileTransferProviderType>None</profile1:ProfileTransferProviderType>
                                </Binding.FallbackValue>
                            </Binding>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ci:ViewBase.Resources>
    <ci:DrawerHost DrawerPlacement="Right"
               IsDrawerOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}"
               DrawerContent="{Binding ViewModel.DrawerContent, Mode=OneWay}">
        <Grid RowDefinitions="48, *" ColumnDefinitions="300, *">
            <!-- Background Layer -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch" />

            <ci:ReusableTabControl Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Padding="0" Classes="navigation barrier"
                        SelectionChanged="MasterTabControl_OnSelectionChanged"
                        x:Name="MasterTabControl"
                        SelectedIndex="{Binding ViewModel.MasterPageTabSelectIndex}">
                <ci:ReusableTabControl.Styles>
                    <Style Selector="TabControl#MasterTabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                    </Style>
                </ci:ReusableTabControl.Styles>
                <TabItem Header="{x:Static locPw:Localization.ClassPlansTabHeader}" Classes="tag-ClassPlans"
                         IsVisible="{Binding !ViewModel.ManagementService.Policy.DisableProfileEditing}">
                    <ci:Lazy>
                        <ci:ReusableTabControl TabStripPlacement="Bottom" Classes="compact barrier" Padding="0"
                                               SelectedIndex="{Binding ViewModel.SettingsService.Settings.ClassPlanEditModeIndex}">
                            <TabItem Header="{ci:FluentIcon &#xE075;}" ToolTip.Tip="{x:Static locPw:Localization.ListViewToolTip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="500" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 课表选择区域 -->
                                    <Grid Grid.Column="0" RowDefinitions="Auto, *">
                                        <ci:TutorialBarrier>
                                            <controls:FACommandBar Grid.Row="0"
                                                                 DefaultLabelPosition="Right"
                                                                 IsEnabled="{Binding !ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing}">
                                                <controls:FACommandBar.PrimaryCommands>
                                                    <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xe00d;}"
                                                                               Label="{x:Static locPw:Localization.AddLabel}" ToolTip.Tip="{x:Static locPw:Localization.CreateClassPlanTip}"
                                                                               Click="ButtonAddClassPlan_OnClick" />
                                                    <controls:FACommandBarSeparator />
                                                    <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xe58d;}"
                                                                               Label="{x:Static locPw:Localization.DuplicateLabel}" ToolTip.Tip="{x:Static locPw:Localization.DuplicateClassPlanTip}"
                                                                               Click="ButtonDuplicateClassPlan_OnClick" />
                                                </controls:FACommandBar.PrimaryCommands>
                                            </controls:FACommandBar>
                                        </ci:TutorialBarrier>

                                        <TreeView Grid.Row="1"
                                                  x:Name="ClassPlansTreeView"
                                                  ItemsSource="{Binding ViewModel.GroupedClassPlans, Mode=OneWay}"
                                                  SelectedItem="{Binding ViewModel.SelectedClassPlansTreeNode}"
                                                  SelectionMode="Single"
                                                  SelectionChanged="TreeViewClassPlans_OnSelectionChanged">
                                            <TreeView.Styles>
                                                <Style Selector="TreeView#ClassPlansTreeView > TreeViewItem">
                                                    <Setter Property="IsExpanded" Value="True" />
                                                </Style>
                                                <Style Selector="TreeView#ClassPlansTreeView TreeViewItem">
                                                    <Setter Property="Interaction.Behaviors">
                                                        <BehaviorCollectionTemplate>
                                                            <BehaviorCollection>
                                                                <ci:AdvancedManagedContextDragBehavior
                                                                    Context="{Binding}"
                                                                    DataFormat="{x:Static views:ClassPlanTreeDropHandler.DataFormat}"
                                                                    HorizontalDragThreshold="3"
                                                                    VerticalDragThreshold="3"
                                                                    PreviewOpacity="0.5">
                                                                    <ci:AdvancedManagedContextDragBehavior.IsEnabled>
                                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                            <Binding Path="!IsGroup"/>
                                                                            <Binding
                                                                                Path="$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing"
                                                                                Converter="{StaticResource InvertBooleanConverter}"/>
                                                                        </MultiBinding>
                                                                    </ci:AdvancedManagedContextDragBehavior.IsEnabled>
                                                                </ci:AdvancedManagedContextDragBehavior>
                                                            </BehaviorCollection>
                                                        </BehaviorCollectionTemplate>
                                                    </Setter>
                                                </Style>
                                                <Style Selector="Border.ClassPlanTreeNodeRoot">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </Style>
                                                <Style Selector="Border.ClassPlanTreeNodeRoot.class-plan-drop-before">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0 2 0 0"/>
                                                </Style>
                                                <Style Selector="Border.ClassPlanTreeNodeRoot.class-plan-drop-after">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0 0 0 2"/>
                                                </Style>
                                                <Style Selector="Border.ClassPlanTreeNodeRoot.class-plan-drop-into-group">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                                                </Style>
                                            </TreeView.Styles>
                                            
                                            <TreeView.ItemTemplate>
                                                <TreeDataTemplate x:DataType="profile2:ClassPlansTreeNode"
                                                                  ItemsSource="{Binding SubPlans}">
                                                    <Border Background="Transparent"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Classes="ClassPlanTreeNodeRoot">
                                                        <Interaction.Behaviors>
                                                            <BehaviorCollection>
                                                                <ManagedContextDropBehavior
                                                                    AcceptDataFormat="{x:Static views:ClassPlanTreeDropHandler.DataFormat}"
                                                                    AllowDrop="True"
                                                                    Context="{Binding}"
                                                                    Handler="{StaticResource ClassPlanTreeDropHandler}"/>
                                                            </BehaviorCollection>
                                                        </Interaction.Behaviors>
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Styles>
                                                                <Style Selector="Border.ClassPlanTag">
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="BorderBrush"
                                                                            Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource ControlFillColorTransparentBrush}" />

                                                                    <Style Selector="^.IsTagActivated">
                                                                        <Setter Property="BorderThickness" Value="0" />
                                                                        <Setter Property="BorderBrush"
                                                                                Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                        <Setter Property="TextElement.Foreground"
                                                                                Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                    </Style>

                                                                    <Style Selector="^.IsWrong">
                                                                        <Setter Property="BorderBrush" Value="IndianRed" />
                                                                        <Setter Property="TextElement.Foreground"
                                                                                Value="IndianRed" />
                                                                    </Style>
                                                                </Style>
                                                            </StackPanel.Styles>
                                                            
                                                            <!-- 名称 -->
                                                            <Panel IsVisible="{Binding !IsGroup}">
                                                                <ci:TouchDragThumb Width="20" Margin="-4 0 4 0"
                                                                                   IsEnabled="{Binding $parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing, Converter={StaticResource InvertBooleanConverter}}" />
                                                            </Panel>
                                                            <ci:FluentIcon Glyph="{ci:FI GroupRegular}" Margin="0 0 4 0"
                                                                           IsVisible="{Binding IsGroup}" />
                                                            <Panel IsVisible="{Binding IsGroup}">
                                                                <TextBlock DataContext="{Binding Guid, Converter={StaticResource ClassPlanGroupIdToClassPlanGroupConverter}}"
                                                                           Text="{Binding Name}"
                                                                           VerticalAlignment="Center" />
                                                            </Panel>
                                                            
                                                            <ci:FluentIcon Glyph="{ci:FI DocumentDataRegular}" Margin="0 0 4 0"
                                                                           IsVisible="{Binding !IsGroup}" />
                                                            <TextBlock Text="{Binding ClassPlan.Name}"
                                                                       IsVisible="{Binding !IsGroup}"
                                                                       VerticalAlignment="Center" />

                                                            <!-- 触发规则 -->
                                                            <Border MinWidth="20" Height="24" CornerRadius="12"
                                                                    Margin="4 0 2 0" Padding="8 0"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip.Tip="{x:Static locPw:Localization.TriggerRuleToolTip}"
                                                                    IsVisible="{Binding !IsGroup}"
                                                                    Classes="ClassPlanTag l-secondary"
                                                                    Classes.IsTagActivated="{Binding ClassPlan.IsActivated}">
                                                                <Classes.IsWrong>
                                                                    <MultiBinding
                                                                                Converter="{x:Static BoolConverters.And}">
                                                                                <Binding Path="ClassPlan.IsEnabled" />
                                                                                <Binding Path="!ClassPlan.IsOverlay" />
                                                                                <Binding Path="ClassPlan.TimeRule.TypeString"
                                                                                        Converter="{x:Static ObjectConverters.Equal}"
                                                                                        ConverterParameter="Date"/>
                                                                                <Binding Path="ClassPlan.TimeRule.EnableDates.Count"
                                                                                        Converter="{x:Static ObjectConverters.Equal}">
                                                                                    <Binding.ConverterParameter>
                                                                                        <x:Int32>0</x:Int32>
                                                                                    </Binding.ConverterParameter>
                                                                                </Binding>
                                                                            </MultiBinding>
                                                                </Classes.IsWrong>
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <ci:FluentIcon Classes="ClassTimeRuleTagIcon"
                                                                                   Classes.IsEnabled="{Binding ClassPlan.IsEnabled}"
                                                                                   Classes.IsOverlay="{Binding ClassPlan.IsOverlay}">
                                                                        <Classes.IsWeekly>
                                                                            <Binding Path="ClassPlan.TimeRule.TypeString"
                                                                                    Converter="{x:Static ObjectConverters.Equal}"
                                                                                    ConverterParameter="Weekly"/>
                                                                        </Classes.IsWeekly>
                                                                        <Classes.IsDate>
                                                                            <Binding Path="ClassPlan.TimeRule.TypeString"
                                                                                    Converter="{x:Static ObjectConverters.Equal}"
                                                                                    ConverterParameter="Date"/>
                                                                        </Classes.IsDate>
                                                                        <Classes.IsLoop>
                                                                            <Binding Path="ClassPlan.TimeRule.TypeString"
                                                                                    Converter="{x:Static ObjectConverters.Equal}"
                                                                                    ConverterParameter="Loop"/>
                                                                        </Classes.IsLoop>
                                                                        <ci:FluentIcon.Styles>
                                                                            <Style Selector="ci|FluentIcon.ClassTimeRuleTagIcon">
                                                                                <Setter Property="Glyph"
                                                                                        Value="{ci:FI TagOffRegular}" />
                                                                                <Style Selector="^.IsEnabled">
                                                                                    <Setter Property="Glyph"
                                                                                            Value="{ci:FI TagMultipleRegular}" />
                                                                                    
                                                                                    <Style Selector="^.IsWeekly">
                                                                                        <Setter Property="Glyph"
                                                                                            Value="{ci:FI CalendarRegular}" />
                                                                                    </Style>
                                                                                    <Style Selector="^.IsDate">
                                                                                        <Setter Property="Glyph"
                                                                                            Value="{ci:FI CalendarDayRegular}" />
                                                                                    </Style>
                                                                                    <Style Selector="^.IsLoop">
                                                                                        <Setter Property="Glyph"
                                                                                            Value="{ci:FI ArrowRepeatAllFilled}" />
                                                                                    </Style>
                                                                                </Style>
                                                                                
                                                                                <Style Selector="^.IsOverlay">
                                                                                    <Setter Property="Glyph"
                                                                                            Value="{ci:FI LayerRegular}" />
                                                                                </Style>
                                                                            </Style>
                                                                        </ci:FluentIcon.Styles>
                                                                    </ci:FluentIcon>

                                                                    <TextBlock Margin="2 0 0 0"
                                                                               Text="{Binding ClassPlan.TimeRule.WeekDay, Converter={StaticResource WeekIndexToWeekStringConverter}}">
                                                                        <TextBlock.IsVisible>
                                                                            <MultiBinding
                                                                                Converter="{x:Static BoolConverters.And}">
                                                                                <Binding Path="ClassPlan.IsEnabled" />
                                                                                <Binding Path="!ClassPlan.IsOverlay" />
                                                                                <Binding Path="ClassPlan.TimeRule.TypeString"
                                                                                        Converter="{x:Static ObjectConverters.Equal}"
                                                                                        ConverterParameter="Weekly"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.IsVisible>
                                                                    </TextBlock>

                                                                    <TextBlock Margin="2 0 0 0">
                                                                        <TextBlock.Resources>
                                                                            <system:Int32 x:Key="Zero">0</system:Int32>
                                                                        </TextBlock.Resources>

                                                                        <TextBlock.IsVisible>
                                                                            <MultiBinding
                                                                                Converter="{x:Static BoolConverters.And}">
                                                                                <Binding Path="ClassPlan.TimeRule.WeekCountDiv"
                                                                                    Converter="{x:Static ObjectConverters.NotEqual}"
                                                                                    ConverterParameter="{StaticResource Zero}" />
                                                                                <Binding Path="ClassPlan.IsEnabled" />
                                                                                <Binding Path="!ClassPlan.IsOverlay" />
                                                                                <Binding Path="ClassPlan.TimeRule.TypeString"
                                                                                        Converter="{x:Static ObjectConverters.Equal}"
                                                                                        ConverterParameter="Weekly"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.IsVisible>

                                                                        <Run Text="{Binding ClassPlan.TimeRule.WeekCountDiv}" />
                                                                        <Run Text="/" />
                                                                        <Run
                                                                            Text="{Binding ClassPlan.TimeRule.WeekCountDivTotal}" />
                                                                        <Run Text="{x:Static locPw:Localization.WeekUnitSuffix}" />
                                                                    </TextBlock>
                                                                    
                                                                    <TextBlock Margin="2 0 0 0"
                                                                               Text="{Binding ClassPlan.TimeRule.EnableDates[0], StringFormat='yy/MM/dd'}">
                                                                        <TextBlock.IsVisible>
                                                                            <MultiBinding
                                                                                Converter="{x:Static BoolConverters.And}">
                                                                                <Binding Path="ClassPlan.IsEnabled" />
                                                                                <Binding Path="!ClassPlan.IsOverlay" />
                                                                                <Binding Path="ClassPlan.TimeRule.TypeString"
                                                                                        Converter="{x:Static ObjectConverters.Equal}"
                                                                                        ConverterParameter="Date"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.IsVisible>
                                                                    </TextBlock>
                                                                    
                                                                    <TextBlock Margin="2 0 0 0"
                                                                               Text="...">
                                                                        <TextBlock.IsVisible>
                                                                            <MultiBinding
                                                                                Converter="{x:Static BoolConverters.And}">
                                                                                <Binding Path="ClassPlan.IsEnabled" />
                                                                                <Binding Path="!ClassPlan.IsOverlay" />
                                                                                <Binding Path="ClassPlan.TimeRule.TypeString"
                                                                                        Converter="{x:Static ObjectConverters.Equal}"
                                                                                        ConverterParameter="Date"/>
                                                                                <Binding Path="ClassPlan.TimeRule.EnableDates.Count"
                                                                                        Converter="{x:Static ObjectConverters.NotEqual}">
                                                                                    <Binding.ConverterParameter>
                                                                                        <x:Int32>0</x:Int32>
                                                                                    </Binding.ConverterParameter>
                                                                                </Binding>
                                                                                <Binding Path="ClassPlan.TimeRule.EnableDates.Count"
                                                                                        Converter="{x:Static ObjectConverters.NotEqual}">
                                                                                    <Binding.ConverterParameter>
                                                                                        <x:Int32>1</x:Int32>
                                                                                    </Binding.ConverterParameter>
                                                                                </Binding>
                                                                            </MultiBinding>
                                                                        </TextBlock.IsVisible>
                                                                    </TextBlock>
                                                                    
                                                                    <TextBlock Margin="2 0 0 0">
                                                                        <TextBlock.IsVisible>
                                                                            <MultiBinding
                                                                                Converter="{x:Static BoolConverters.And}">
                                                                                <Binding Path="ClassPlan.IsEnabled" />
                                                                                <Binding Path="!ClassPlan.IsOverlay" />
                                                                                <Binding Path="ClassPlan.TimeRule.TypeString"
                                                                                        Converter="{x:Static ObjectConverters.Equal}"
                                                                                        ConverterParameter="Loop"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.IsVisible>

                                                                        <Run Text="{Binding ClassPlan.TimeRule.LoopOffsetDays}"/>
                                                                        <Run Text="/" />
                                                                        <Run
                                                                            Text="{Binding ClassPlan.TimeRule.LoopCycleDays}" />
                                                                        <Run Text="{x:Static locPw:Localization.DayUnitSuffix}" />
                                                                    </TextBlock>

                                                                    <TextBlock Margin="2 0 0 0" Padding="0 0 4 0"
                                                                               Text="{x:Static locPw:Localization.OverlayLabel}"
                                                                               IsVisible="{Binding ClassPlan.IsOverlay}"
                                                                               FontWeight="Bold" FontStyle="Italic" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- 时间表 -->
                                                            <Border MinWidth="20" Height="24" CornerRadius="12"
                                                                    Margin="2 0" Padding="8 0"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip.Tip="{x:Static locPw:Localization.TimeLayoutLabel}"
                                                                    IsVisible="{Binding !IsGroup}"
                                                                    Classes="ClassPlanTag l-secondary"
                                                                    Classes.IsWrong="{Binding ClassPlan.TimeLayoutId, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static system:Guid.Empty}}">
                                                                <StackPanel Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <ci:FluentIcon Glyph="{ci:FI TableRegular}" />

                                                                    <TextBlock VerticalAlignment="Center"
                                                                               Margin="4 0 0 0"
                                                                               Classes="ClassTableTimeLayoutTagText"
                                                                               Classes.IsWrong="{Binding ClassPlan.TimeLayoutId, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static system:Guid.Empty}}">
                                                                        <TextBlock.Styles>
                                                                            <Style
                                                                                Selector="TextBlock.ClassTableTimeLayoutTagText">
                                                                                <Setter Property="Text"
                                                                                    Value="{Binding ClassPlan.TimeLayout.Name}" />
                                                                                <Style Selector="^.IsWrong">
                                                                                    <Setter Property="Text" Value="？？？" />
                                                                                </Style>
                                                                            </Style>
                                                                        </TextBlock.Styles>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </TreeDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Grid>
                                    
                                    <GridSplitter Grid.Column="1" Margin="2 0" />
                                    <!-- 课表编辑区域 -->

                                    <ci:Emptiable Grid.Column="2" Data="{Binding ViewModel.SelectedClassPlan}"
                                                  IsDirectContentMode="True"
                                                  IsEnabled="{Binding !ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing}">
                                        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                                            <ci:TutorialBarrier Grid.Row="0">
                                                <controls:FACommandBar DefaultLabelPosition="Right"
                                                                     Classes="hide-popup-indicator">
                                                    <controls:FACommandBar.PrimaryCommands>
                                                        <controls:FACommandBarButton
                                                            IconSource="{ci:FluentIconSource &#xe9e4;}"
                                                            Label="{x:Static locPw:Localization.DetailsLabel}"
                                                            Click="ButtonOpenClassPlanDetails_OnClick"
                                                            ToolTip.Tip="{x:Static locPw:Localization.ViewClassPlanDetailsTip}" />
                                                        <controls:FACommandBarButton
                                                            IconSource="{ci:FluentIconSource &#xe077;}"
                                                            Label="{x:Static locPw:Localization.DetailsDashboardLabel}"
                                                            ToolTip.Tip="{x:Static locPw:Localization.DetailsDashboardTip}"
                                                            Click="ButtonOpenClassPlanDetailsWindow_OnClick" />
                                                        <controls:FACommandBarButton
                                                            IconSource="{ci:FluentIconSource &#xea2f;}"
                                                            Label="{x:Static locPw:Localization.CreateOverlayHeader}"
                                                            ToolTip.Tip="{x:Static locPw:Localization.CreateOverlayTip}"
                                                            Click="ButtonOpenCreateOverlayClassPlanFlyout_OnClick"
                                                            IsEnabled="{Binding ViewModel.SelectedClassPlan.IsOverlay, Converter={StaticResource BooleanToBooleanReConverter}}"
                                                            Flyout="{StaticResource CreateOverlayFlyout}" />
                                                        <controls:FACommandBarButton
                                                            IconSource="{ci:FluentIconSource &#xe61d;}"
                                                            Label="{x:Static locPw:Localization.DeleteLabel}"
                                                            ToolTip.Tip="{x:Static locPw:Localization.DeleteClassPlanTip}"
                                                            Flyout="{StaticResource DeleteClassPlanConfirmFlyout}" />
                                                    </controls:FACommandBar.PrimaryCommands>

                                                </controls:FACommandBar>
                                            </ci:TutorialBarrier>

                                            <!-- 课表编辑 -->
                                            <Grid Grid.Row="1"
                                                  RowDefinitions="Auto,*"
                                                  DataContext="{Binding ViewModel.SelectedClassPlan}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="350" MinWidth="300" MaxWidth="450" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Warnings -->
                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <StackPanel.Styles>
                                                        <Style Selector="StackPanel">
                                                            <Style Selector="^ controls|FAInfoBar#InfoBarNoTimeLayoutWarning">
                                                                <Setter Property="IsVisible" Value="False" />
                                                            </Style>
                                                            <Style
                                                                Selector="^ controls|FAInfoBar#InfoBarEmptyTimeLayoutIdWarning">
                                                                <Setter Property="IsVisible"
                                                                        Value="{Binding TimeLayout, Converter={x:Static ObjectConverters.IsNull}}" />
                                                            </Style>
                                                        </Style>
                                                        <Style Selector="StackPanel.no-timeLayouts">
                                                            <Style Selector="^ controls|FAInfoBar#InfoBarNoTimeLayoutWarning">
                                                                <Setter Property="IsVisible" Value="True" />
                                                            </Style>
                                                            <Style
                                                                Selector="^ controls|FAInfoBar#InfoBarEmptyTimeLayoutIdWarning">
                                                                <Setter Property="IsVisible" Value="False" />
                                                            </Style>
                                                        </Style>
                                                    </StackPanel.Styles>
                                                    <Interaction.Behaviors>
                                                        <DataTriggerBehavior
                                                            Binding="{Binding $parent[views:ProfileSettingsWindow].ViewModel.ProfileService.Profile.TimeLayouts.Count}"
                                                            Value="0">
                                                            <AddClassAction ClassName="no-timeLayouts" />
                                                        </DataTriggerBehavior>
                                                        <DataTriggerBehavior
                                                            Binding="{Binding $parent[views:ProfileSettingsWindow].ViewModel.ProfileService.Profile.TimeLayouts.Count}"
                                                            Value="0"
                                                            ComparisonCondition="NotEqual">
                                                            <RemoveClassAction ClassName="no-timeLayouts" />
                                                        </DataTriggerBehavior>
                                                    </Interaction.Behaviors>
                                                    <controls:FAInfoBar Message="{x:Static locPw:Localization.NoTimeLayoutWarningMessage}"
                                                                      Severity="Warning"
                                                                      IsOpen="True"
                                                                      IsClosable="False"
                                                                      x:Name="InfoBarNoTimeLayoutWarning">
                                                        <controls:FAInfoBar.ActionButton>
                                                            <Button Content="{x:Static locPw:Localization.GoToTimeLayoutsButton}"
                                                                    Click="ButtonGoToTimeLayoutsPage_OnClick" />
                                                        </controls:FAInfoBar.ActionButton>
                                                    </controls:FAInfoBar>
                                                    <controls:FAInfoBar
                                                        Message="{x:Static locPw:Localization.EmptyTimeLayoutWarningMessage}"
                                                        Severity="Warning"
                                                        IsOpen="True"
                                                        IsClosable="False"
                                                        x:Name="InfoBarEmptyTimeLayoutIdWarning">
                                                        <controls:FAInfoBar.ActionButton>
                                                            <Button Content="{x:Static locPw:Localization.GoToSetTimeLayoutButton}"
                                                                    Click="ButtonOpenClassPlanDetails_OnClick" />
                                                        </controls:FAInfoBar.ActionButton>
                                                    </controls:FAInfoBar>
                                                </StackPanel>

                                                <DataGrid Grid.Column="0" Grid.Row="1"
                                                          Margin="0 0 4 0"
                                                          AutoGenerateColumns="False"
                                                          ItemsSource="{Binding Classes}"
                                                          CanUserSortColumns="False"
                                                          RowHeaderWidth="150"
                                                          x:Name="DataGridClassPlans"
                                                          GridLinesVisibility="Horizontal"
                                                          SelectedIndex="{Binding ViewModel.SelectedClassIndex, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}, Mode=TwoWay}"
                                                          SelectedItem="{Binding ViewModel.SelectedClassInfo, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}}">
                                                    <DataGrid.Columns>
                                                        <DataGridCheckBoxColumn Header="{x:Static locPw:Localization.EnabledColumnHeader}"
                                                                                Binding="{Binding IsEnabled}" />
                                                        <DataGridTemplateColumn Header="{x:Static locPw:Localization.TimeColumnHeader}" IsReadOnly="True">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock VerticalAlignment="Center"
                                                                               FontSize="13"
                                                                               Margin="6 0">
                                                                        <Run
                                                                            Text="{Binding CurrentTimeLayoutItem.StartTime, Mode=OneWay}" />
                                                                        <Run Text="-" />
                                                                        <Run
                                                                            Text="{Binding CurrentTimeLayoutItem.EndTime, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="{x:Static locPw:Localization.SubjectLabel}">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.Styles>
                                                                            <Style
                                                                                Selector="ComboBox /template/ Border#Background">
                                                                                <Setter Property="IsVisible" Value="False" />
                                                                            </Style>
                                                                        </Grid.Styles>
                                                                        <ComboBox
                                                                            ItemsSource="{Binding $parent[views:ProfileSettingsWindow].ViewModel.Subjects.List}"
                                                                            SelectedValue="{Binding SubjectId}"
                                                                            HorizontalAlignment="Stretch"
                                                                            SelectedValueBinding="{Binding Key}"
                                                                            FontSize="13">
                                                                            <Interaction.Behaviors>
                                                                                <BehaviorCollection>
                                                                                    <behaviors:ComboBoxEmptyFixBehavior />
                                                                                </BehaviorCollection>
                                                                            </Interaction.Behaviors>
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Value.Name}"
                                                                                        Margin="0 4 0 0" />
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>

                                                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                                                              Grid.Row="0" Grid.RowSpan="2"
                                                              VerticalAlignment="Stretch" />

                                                <ci:ReusableTabControl Grid.Row="0" Grid.Column="2" Classes="compact"
                                                            Grid.RowSpan="2"
                                                            Padding="0">
                                                    <TabItem Header="{x:Static locPw:Localization.EditSubjectTabHeader}">
                                                        <Grid RowDefinitions="*, Auto">
                                                            <ListBox
                                                                Grid.Row="0"
                                                                SelectedValue="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedClassInfo.SubjectId, Mode=OneWay}"
                                                                SelectedValueBinding="{Binding Key}"
                                                                ItemsSource="{Binding $parent[views:ProfileSettingsWindow].ViewModel.Subjects.List}">
                                                                <ListBox.Styles>
                                                                    <Style Selector="ListBoxItem">
                                                                        <Setter Property="MinWidth" Value="0" />
                                                                        <Setter Property="Padding" Value="0" />
                                                                    </Style>
                                                                </ListBox.Styles>
                                                                <ListBox.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Classes="animated-resize" />
                                                                    </ItemsPanelTemplate>
                                                                </ListBox.ItemsPanel>
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="Transparent"
                                                                                PointerReleased="InputElementSubjectItem_OnTapped"
                                                                                PointerPressed="InputElementSubjectItem_OnPointerPressed"
                                                                                Padding="8">
                                                                            <TextBlock Text="{Binding Value.Initial}"
                                                                                ToolTip.Tip="{Binding Value.Name}"
                                                                                FontSize="16"
                                                                                IsHitTestVisible="False"
                                                                                Margin="2 0 0 0" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                            <CheckBox Margin="8" Grid.Row="1"
                                                                      IsChecked="{Binding ViewModel.SettingsService.Settings.IsProfileEditorClassInfoSubjectAutoMoveNextEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}}"
                                                                      Content="{x:Static locPw:Localization.AutoMoveNextAfterSubjectSelected}" />
                                                        </Grid>
                                                    </TabItem>
                                                </ci:ReusableTabControl>
                                            </Grid>
                                        </Grid>
                                    </ci:Emptiable>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{ci:FluentIcon &#xF0EB;}" ToolTip.Tip="{x:Static locPw:Localization.WeekViewToolTip}">
                                <Grid RowDefinitions="Auto *">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="300" MinWidth="300" MaxWidth="450" />
                                    </Grid.ColumnDefinitions>

                                    <ci:TutorialBarrier Grid.Column="0" Grid.ColumnSpan="3"
                                                        Grid.Row="0">
                                        <controls:FACommandBar DefaultLabelPosition="Right"
                                                               Margin="0 -4 0 -4"
                                                               IsEnabled="{Binding !ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing}"
                                                               Classes="hide-popup-indicator">
                                            <controls:FACommandBar.PrimaryCommands>
                                                <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xE0B5;}"
                                                                             Label="{x:Static locPw:Localization.RefreshLabel}"
                                                                             Click="ButtonRefreshScheduleDataGrid_OnClick"
                                                                             ToolTip.Tip="{x:Static locPw:Localization.RefreshCurrentViewTip}" />
                                                <controls:FACommandBarSeparator />
                                                <controls:FACommandBarElementContainer
                                                    IsVisible="{Binding ViewModel.SelectedClassPlan, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <StackPanel VerticalAlignment="Center" Classes="items-valign-center"
                                                                Margin="8 0"
                                                                Orientation="Horizontal"
                                                                Opacity="0.8"
                                                                Spacing="6">
                                                        <ci:FluentIcon Glyph="&#xE6B1;" FontSize="16" />
                                                        <TextBlock FontSize="13"
                                                                   Text="{Binding ViewModel.SelectedClassPlan.Name, FallbackValue=''}" />
                                                    </StackPanel>
                                                </controls:FACommandBarElementContainer>
                                                <controls:FACommandBarElementContainer
                                                    IsVisible="{Binding ViewModel.SelectedClassPlan, Converter={x:Static ObjectConverters.IsNull}}">
                                                    <StackPanel VerticalAlignment="Center" Classes="items-valign-center"
                                                                Margin="8 0"
                                                                Orientation="Horizontal"
                                                                Opacity="0.8"
                                                                Spacing="6">
                                                        <TextBlock FontSize="13"
                                                                   Text="{x:Static locPw:Localization.NoClassPlanSelected}" />
                                                    </StackPanel>
                                                </controls:FACommandBarElementContainer>
                                                <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xe9e4;}"
                                                                             Label="{x:Static locPw:Localization.DetailsLabel}"
                                                                             Click="ButtonOpenClassPlanDetails_OnClick"
                                                                             IsVisible="{Binding ViewModel.SelectedClassPlan, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                             ToolTip.Tip="{x:Static locPw:Localization.ViewClassPlanDetailsTip}" />
                                                <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xe077;}"
                                                                             Label="{x:Static locPw:Localization.DetailsDashboardLabel}"
                                                                             ToolTip.Tip="{x:Static locPw:Localization.DetailsDashboardTip}"
                                                                             Click="ButtonOpenClassPlanDetailsWindow_OnClick"
                                                                             IsVisible="{Binding ViewModel.SelectedClassPlan, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xea2f;}"
                                                                             Label="{x:Static locPw:Localization.CreateOverlayHeader}"
                                                                             ToolTip.Tip="{x:Static locPw:Localization.CreateOverlayTip}"
                                                                             Click="ButtonOpenCreateOverlayClassPlanFlyout_OnClick"
                                                                             IsVisible="{Binding ViewModel.SelectedClassPlan, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                             IsEnabled="{Binding ViewModel.SelectedClassPlan.IsOverlay, Converter={StaticResource BooleanToBooleanReConverter}, FallbackValue={x:False}}"
                                                                             Flyout="{StaticResource CreateOverlayFlyout}" />
                                                <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xe61d;}"
                                                                             Label="{x:Static locPw:Localization.DeleteLabel}"
                                                                             ToolTip.Tip="{x:Static locPw:Localization.DeleteClassPlanTip}"
                                                                             Flyout="{StaticResource DeleteClassPlanConfirmFlyout}"
                                                                             IsVisible="{Binding ViewModel.SelectedClassPlan, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </controls:FACommandBar.PrimaryCommands>

                                        </controls:FACommandBar>
                                    </ci:TutorialBarrier>
                                     
                                    <scheduleDataGrid:ScheduleDataGrid Grid.Row="1" Grid.Column="0"
                                                                       x:Name="ScheduleDataGrid"
                                                                       TutorialContextId="profileSettingsWindow.classPlans"
                                                                       IsReadonly="{Binding ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing}"
                                                                       OpenClassPlanSettingsRequested="ScheduleDataGrid_OnOpenClassPlanSettingsRequested"
                                                                       SelectedClassInfo="{Binding ViewModel.SelectedClassInfo, Mode=TwoWay}"
                                                                       SelectedClassInfoIndex="{Binding ViewModel.SelectedClassIndex, Mode=TwoWay}"
                                                                       SelectedClassPlan="{Binding ViewModel.SelectedClassPlan, Mode=TwoWay}"
                                                                       SelectedDate="{Binding ViewModel.ScheduleCalendarSelectedDate, Mode=TwoWay}"/>
                                    
                                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                                                  Grid.Row="1" 
                                                  VerticalAlignment="Stretch" />

                                    <ci:ReusableTabControl Grid.Row="1" Grid.Column="2" Classes="compact tag-SubjectsInput"
                                                IsEnabled="{Binding !ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing}"
                                                Padding="0">
                                        <TabItem Header="{x:Static locPw:Localization.EditSubjectTabHeader}">
                                            <Grid RowDefinitions="*, Auto">
                                                <ListBox
                                                    Grid.Row="0"
                                                    IsEnabled="{Binding !ViewModel.SelectedClassInfo.IsEmpty}"
                                                    SelectedValue="{Binding ViewModel.SelectedClassInfo.SubjectId, Mode=OneWay}"
                                                    SelectedValueBinding="{Binding Key}"
                                                    ItemsSource="{Binding ViewModel.Subjects.List}">
                                                    <ListBox.Styles>
                                                        <Style Selector="ListBoxItem">
                                                            <Setter Property="MinWidth" Value="0" />
                                                            <Setter Property="Padding" Value="0" />
                                                        </Style>
                                                    </ListBox.Styles>
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Classes="animated-resize" />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="Transparent"
                                                                    PointerReleased="InputElementSubjectItem_OnTapped"
                                                                    PointerPressed="InputElementSubjectItem_OnPointerPressed"
                                                                    Padding="8">
                                                                <TextBlock Text="{Binding Value.Initial}"
                                                                    ToolTip.Tip="{Binding Value.Name}"
                                                                    FontSize="16"
                                                                    IsHitTestVisible="False"
                                                                    Margin="2 0 0 0" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <CheckBox Margin="8" Grid.Row="1"
                                                          IsChecked="{Binding ViewModel.SettingsService.Settings.IsProfileEditorClassInfoSubjectAutoMoveNextEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}}"
                                                          Content="{x:Static locPw:Localization.AutoMoveNextAfterSubjectSelected}" />
                                            </Grid>
                                        </TabItem>
                                    </ci:ReusableTabControl>
                                </Grid>
                            </TabItem>
                            <TabItem Header="{ci:FluentIcon &#xE304;}" ToolTip.Tip="{x:Static locPw:Localization.MonthViewToolTip}">
                                <Grid RowDefinitions="Auto *">
                                    <ci:TutorialBarrier>
                                        <controls:FACommandBar Grid.Column="0"
                                                               Grid.Row="0" DefaultLabelPosition="Right"
                                                               Margin="0 -4 0 -4"
                                                               IsEnabled="{Binding !ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing}"
                                                               Classes="hide-popup-indicator">
                                            <controls:FACommandBar.PrimaryCommands>
                                                <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xE0B5;}"
                                                                           Label="{x:Static locPw:Localization.RefreshLabel}"
                                                                           Click="ButtonRefreshScheduleDataGrid_OnClick"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.RefreshCurrentViewTip}" />
                                            </controls:FACommandBar.PrimaryCommands>

                                        </controls:FACommandBar>
                                    </ci:TutorialBarrier>
                                    <controls1:ScheduleCalendarControl x:Name="ScheduleCalendarControl2"
                                                                       Grid.Row="1"
                                                                       DisplayDate="{Binding ViewModel.ScheduleCalendarSelectedDate, Mode=TwoWay}"
                                                                       SelectedDate="{Binding ViewModel.ScheduleCalendarSelectedDate, Mode=TwoWay}" />
                                </Grid>
                            </TabItem>
                        </ci:ReusableTabControl>
                    </ci:Lazy>
                    
                </TabItem>
                <TabItem Header="{x:Static locPw:Localization.TimeLayoutLabel}" Classes="tag-TimeLayouts"
                         IsVisible="{Binding !ViewModel.ManagementService.Policy.DisableProfileEditing}">
                    <ci:Lazy>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" MinWidth="250" MaxWidth="400"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <!-- 时间表选择 -->
                            <Grid Grid.Column="0" Margin="0 0 3 0" RowDefinitions="Auto,*,Auto">
                                <!-- 时间表操作 -->
                                <ci:TutorialBarrier Grid.Row="0" ExcludedTags="classfabric.profileSettingsWindow.timeLayouts.add">
                                    <controls:FACommandBar Grid.Row="0" 
                                                         DefaultLabelPosition="Right"
                                                         IsEnabled="{Binding ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing, Converter={StaticResource InvertBooleanConverter}}">
                                        <controls:FACommandBar.PrimaryCommands>
                                            <controls:FACommandBarButton Click="ButtonAddTimeLayout_OnClick" ToolTip.Tip="{x:Static locPw:Localization.CreateTimeLayoutTip}"
                                                                       IconSource="{ci:FluentIconSource &#xE00D;}"
                                                                       Label="{x:Static locPw:Localization.AddLabel}"/>
                                            <controls:FACommandBarSeparator />
                                            <controls:FACommandBarButton Click="ButtonDuplicateTimeLayout_OnClick" ToolTip.Tip="{x:Static locPw:Localization.DuplicateTimeLayoutTip}"
                                                                       IconSource="{ci:FluentIconSource &#xE58D;}"
                                                                       IsEnabled="{Binding ViewModel.SelectedTimeLayout, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                       Label="{x:Static locPw:Localization.DuplicateLabel}"/>
                                        </controls:FACommandBar.PrimaryCommands>
                                    </controls:FACommandBar>
                                </ci:TutorialBarrier>

                                <!-- 时间表 -->
                                <ci:TutorialBarrier Grid.Row="1">
                                    <ListBox SelectionMode="Single"
                                             ItemsSource="{Binding ViewModel.TimeLayouts.List, Mode=OneWay}"
                                             SelectedValue="{Binding ViewModel.SelectedTimeLayout, Mode=TwoWay}"
                                             SelectedValueBinding="{Binding Value}">
                                        <ListBox.Styles>
                                            <Style Selector="ListBox:not(.no-drag) ListBoxItem">
                                                <Setter Property="Interaction.Behaviors">
                                                    <BehaviorCollectionTemplate>
                                                        <BehaviorCollection>
                                                            <ci:AdvancedItemDragBehavior HorizontalDragThreshold="33550336" VerticalDragThreshold="3"
                                                                    Orientation="Vertical"/>
                                                        </BehaviorCollection>
                                                    </BehaviorCollectionTemplate>
                                                </Setter>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch" ColumnDefinitions="Auto * Auto"
                                                      Classes="items-valign-center">
                                                    <ci:TouchDragThumb Grid.Column="0" Margin="-8 0 4 0"/>
                                                    <TextBlock Text="{Binding Value.Name}"
                                                               Margin="0 0 4 0"
                                                               Grid.Column="1" TextTrimming="{x:Static TextTrimming.WordEllipsis}"
                                                               HorizontalAlignment="Left" />
                                                    <ci:FluentIcon Glyph="&#xE4D2;" HorizontalAlignment="Right"
                                                                   Grid.Column="2"
                                                                   ToolTip.Tip="{x:Static locPw:Localization.TimeLayoutActiveTip}"
                                                                   IsVisible="{Binding Value.IsActivated, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ci:TutorialBarrier>

                                <!-- 时间点时长 -->
                                <Expander HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          Padding="12 10 12 10"
                                          Grid.Row="2"
                                          ExpandDirection="Up" Header="{x:Static locPw:Localization.TimePointDurationHeader}"
                                          IsEnabled="{Binding ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing, Converter={StaticResource InvertBooleanConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}}">
                                    <StackPanel Spacing="4">
                                        <ci:Field Label="{x:Static locPw:Localization.DefaultOnClassDurationLabel}" Suffix="{x:Static locPw:Localization.MinutesSuffix}">
                                            <controls:FANumberBox
                                                Maximum="36000" Minimum="0" HorizontalAlignment="Stretch"
                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                Value="{Binding ViewModel.SettingsService.Settings.DefaultOnClassTimePointMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                        </ci:Field>
                                        <ci:Field Label="{x:Static locPw:Localization.DefaultBreakDurationLabel}" Suffix="{x:Static locPw:Localization.MinutesSuffix}">
                                            <controls:FANumberBox
                                                Maximum="36000" Minimum="0" HorizontalAlignment="Stretch"
                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                Value="{Binding ViewModel.SettingsService.Settings.DefaultBreakingTimePointMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                        </ci:Field>
                                    </StackPanel>
                                </Expander>
                            </Grid>
                            
                            <GridSplitter Grid.Column="1" Margin="2 0" />
                            
                            <ci:Emptiable Grid.Column="2" IsDirectContentMode="True" Data="{Binding ViewModel.SelectedTimeLayout, Mode=OneWay}">
                                <Grid Margin="3 0 0 0" 
                                      DataContext="{Binding ViewModel.SelectedTimeLayout}"
                                      RowDefinitions="Auto,Auto,*,Auto">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="5"/>
                                        <ColumnDefinition Width="375" MinWidth="250" MaxWidth="450"/>
                                    </Grid.ColumnDefinitions>
                                    <ci:TutorialBarrier Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"
                                                        ExcludedTags="classfabric.profileSettingsWindow.timeLayouts.timePoints.add">
                                        <controls:FACommandBar Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"
                                                             DefaultLabelPosition="Right"
                                                             IsEnabled="{Binding !$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing}"
                                                             Classes="hide-popup-indicator">
                                            <controls:FACommandBar.PrimaryCommands>
                                                <controls:FACommandBarButton Click="ButtonAddClassTime_OnClick" 
                                                                           IconSource="{ci:FluentIconSource &#xE47A;}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.AddOnClassTimePointTip}"
                                                                           Label="{x:Static locPw:Localization.OnClassLabel}"/>
                                                <controls:FACommandBarButton Click="ButtonAddBreakTime_OnClick" 
                                                                           IconSource="{ci:FluentIconSource &#xE4C4;}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.AddBreakTimePointTip}"
                                                                           Label="{x:Static locPw:Localization.BreakLabel}"/>
                                                <controls:FACommandBarButton Click="ButtonAddSeparator_OnClick" 
                                                                           IconSource="{ci:FluentIconSource &#xF021;}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.AddSeparatorTip}"
                                                                           Label="{x:Static locPw:Localization.SeparatorLabel}"/>
                                                <controls:FACommandBarButton Click="ButtonAddActionTimePoint_OnClick" 
                                                                           IconSource="{ci:FluentIconSource &#xE01F;}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.AddActionTimePointTip}"
                                                                           Label="{x:Static locPw:Localization.ActionLabel}" />
                                                <controls:FACommandBarSeparator />
                                                <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xE58B;}"
                                                                           Command="{Binding $parent[views:ProfileSettingsWindow].DuplicateTimePointCommand}"
                                                                           CommandParameter="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimePoint}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.DuplicateTimePointTip}"
                                                                           IsEnabled="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimePoint, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                           Label="{x:Static locPw:Localization.CreateDuplicateLabel}" />
                                                <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xE195;}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.UndoStepToolTip}"
                                                                           IsEnabled="{Binding $parent[views:ProfileSettingsWindow].ViewModel.CanUndo}">
                                                    <controls:FACommandBarButton.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                                            <StackPanel Spacing="4" MinWidth="180">
                                                                <Button Content="{x:Static locPw:Localization.UndoLastStepButton}"
                                                                        Click="ButtonUndoAdd_OnClick"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left" />
                                                                <Separator />
                                                                <TextBlock Text="{x:Static locPw:Localization.UndoHistoryLabel}" Opacity="0.6" FontSize="11" />
                                                                <ScrollViewer MaxHeight="200">
                                                                    <ListBox ItemsSource="{Binding $parent[views:ProfileSettingsWindow].ViewModel.UndoDescriptions}"
                                                                             SelectionChanged="UndoHistoryList_OnSelectionChanged" />
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </controls:FACommandBarButton.Flyout>
                                                </controls:FACommandBarButton>
                                                <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xE121;}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.RedoStepToolTip}"
                                                                           IsEnabled="{Binding $parent[views:ProfileSettingsWindow].ViewModel.CanRedo}">
                                                    <controls:FACommandBarButton.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                                            <StackPanel Spacing="4" MinWidth="180">
                                                                <Button Content="{x:Static locPw:Localization.RedoLastStepButton}"
                                                                        Click="ButtonRedoAdd_OnClick"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left" />
                                                                <Separator />
                                                                <TextBlock Text="{x:Static locPw:Localization.RedoHistoryLabel}" Opacity="0.6" FontSize="11" />
                                                                <ScrollViewer MaxHeight="200">
                                                                    <ListBox ItemsSource="{Binding $parent[views:ProfileSettingsWindow].ViewModel.RedoDescriptions}"
                                                                             SelectionChanged="RedoHistoryList_OnSelectionChanged" />
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </controls:FACommandBarButton.Flyout>
                                                </controls:FACommandBarButton>
                                                <controls:FACommandBarSeparator />
                                                <controls:FACommandBarButton Click="ButtonRemoveTimePoint_OnClick"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.DeleteTimePointTip}"
                                                                           IsEnabled="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimePoint, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                           Label="{x:Static locPw:Localization.DeleteLabel}">
                                                    <controls:FACommandBarButton.IconSource>
                                                        <controls:FASymbolIconSource Symbol="Remove"/>
                                                    </controls:FACommandBarButton.IconSource>
                                                </controls:FACommandBarButton>
                                                <controls:FACommandBarButton Click="ButtonRefreshTimeLayout_OnClick" 
                                                                           IconSource="{ci:FluentIconSource &#xE0B5;}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.ResortTimePointsTip}"
                                                                           Label="{x:Static locPw:Localization.RefreshLabel}"/>
                                                <controls:FACommandBarSeparator />
                                                <controls:FACommandBarButton Click="ButtonEditTimeLayoutInfo_OnClick" 
                                                                           IconSource="{ci:FluentIconSource &#xE9E4;}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.ViewTimeLayoutDetailsTip}"
                                                                           Label="{x:Static locPw:Localization.TimeLayoutInfoHeader}"/>
                                                <controls:FACommandBarButton Click="ButtonDeleteTimeLayout_OnClick"
                                                                           IconSource="{ci:FluentIconSource &#xE61D;}"
                                                                           ToolTip.Tip="{x:Static locPw:Localization.DeleteTimeLayoutTip}"
                                                                           IsEnabled="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimeLayout, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                           Label="{x:Static locPw:Localization.DeleteTimeLayoutLabel}"/>
                                            </controls:FACommandBar.PrimaryCommands>
                                        </controls:FACommandBar>
                                    </ci:TutorialBarrier>
                                    <ci:ReusableTabControl Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" Classes="compact barrier"
                                                Padding="0"
                                                SelectedIndex="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SettingsService.Settings.TimeLayoutEditorIndex, Mode=TwoWay}"
                                                TabStripPlacement="Bottom">
                                        <TabItem Header="{ci:FluentIcon &#xE075;}">
                                            <ListBox x:Name="ListViewTimePoints"
                                                     ItemsSource="{Binding Layouts}"
                                                     SelectedIndex="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimePointIndex}"
                                                     SelectedItem="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimePoint}">

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="4">
                                                            <ci:FluentIcon Glyph="{Binding TimeType, Converter={x:Static ci:TimeTypeToIconGlyphConverter.Instance}}"
                                                                           Margin="0 -4 0 0"/>
                                                            <TextBlock Text="{Binding TimeType, Converter={x:Static ci:TimeTypeToTimeTypeNameConverter.Instance}}"/>
                                                            <TextBlock Text="{Binding StartTime}"/>
                                                            <TextBlock Text="-"/>
                                                            <TextBlock Text="{Binding EndTime}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </TabItem>
                                        <TabItem Header="{ci:FluentIcon &#xF35B;}">
                                            <timeLine:TimeLineListControl SelectedItem="{Binding ViewModel.SelectedTimePoint, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}, Mode=TwoWay}"
                                                                          ItemsSource="{Binding Layouts, Mode=OneWay}"
                                                                          Scale="{Binding ViewModel.TimeLineScale, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}, Mode=OneWay}"
                                                                          IsSticky="{Binding ViewModel.IsTimeLineSticky, RelativeSource={RelativeSource AncestorType=views:ProfileSettingsWindow}}"
                                                                          x:Name="TimeLineListControl"
                                                                          AutoScrollToSelectedItem="True"
                                                                          IsPanningModeEnabled="True"
                                                                          RequestInsertTimePoint="TimeLineListControl_OnRequestInsertTimePoint">
                                                <!-- 回应我吧，爱莉希雅 -->
                                                <timeLine:TimeLineListControl.IsReadonly>
                                                    <Binding Path="ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=views:ProfileSettingsWindow}" Mode="OneWay"/>
                                                </timeLine:TimeLineListControl.IsReadonly>
                                            </timeLine:TimeLineListControl>
                                        </TabItem>
                                    </ci:ReusableTabControl>
                                    <!-- 底部操作按钮 -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                        <ToggleButton Theme="{StaticResource TransparentToggleButton}"
                                                Content="{ci:FluentIcon &#xE095;}"
                                                ToolTip.Tip="{x:Static locPw:Localization.TimePointSnapTip}"
                                                IsChecked="{Binding $parent[views:ProfileSettingsWindow].ViewModel.IsTimeLineSticky}">
                                            <ToggleButton.IsVisible>
                                                <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.SettingsService.Settings.TimeLayoutEditorIndex"
                                                         Converter="{x:Static ObjectConverters.Equal}">
                                                    <Binding.ConverterParameter>
                                                        <system:Int32>1</system:Int32>
                                                    </Binding.ConverterParameter>
                                                </Binding>
                                            </ToggleButton.IsVisible>
                                        </ToggleButton>
                                        <Button Theme="{StaticResource TransparentButton}"
                                                Content="{ci:FluentIcon &#xf4d3;}"
                                                ToolTip.Tip="{x:Static locPw:Localization.ZoomOutTip}"
                                                Click="ButtonZoomOut_OnClick">
                                            <ToggleButton.IsVisible>
                                                <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.SettingsService.Settings.TimeLayoutEditorIndex"
                                                         Converter="{x:Static ObjectConverters.Equal}">
                                                    <Binding.ConverterParameter>
                                                        <system:Int32>1</system:Int32>
                                                    </Binding.ConverterParameter>
                                                </Binding>
                                            </ToggleButton.IsVisible>
                                        </Button>
                                        <TextBlock Text="{Binding $parent[views:ProfileSettingsWindow].ViewModel.TimeLineScale, StringFormat='P0'}"
                                                   VerticalAlignment="Center">
                                            <ToggleButton.IsVisible>
                                                <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.SettingsService.Settings.TimeLayoutEditorIndex"
                                                         Converter="{x:Static ObjectConverters.Equal}">
                                                    <Binding.ConverterParameter>
                                                        <system:Int32>1</system:Int32>
                                                    </Binding.ConverterParameter>
                                                </Binding>
                                            </ToggleButton.IsVisible>
                                        </TextBlock>
                                        <Button Theme="{StaticResource TransparentButton}"
                                                Content="{ci:FluentIcon &#xf4d1;}"
                                                ToolTip.Tip="{x:Static locPw:Localization.ZoomInTip}"
                                                Click="ButtonZoomIn_OnClick">
                                            <ToggleButton.IsVisible>
                                                <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.SettingsService.Settings.TimeLayoutEditorIndex"
                                                         Converter="{x:Static ObjectConverters.Equal}">
                                                    <Binding.ConverterParameter>
                                                        <system:Int32>1</system:Int32>
                                                    </Binding.ConverterParameter>
                                                </Binding>
                                            </ToggleButton.IsVisible>
                                        </Button>
                                        <Button Theme="{StaticResource TransparentButton}"
                                                Content="{ci:FluentIcon &#xEBD2;}"
                                                ToolTip.Tip="{x:Static locPw:Localization.LocateSelectedTimePointTip}"
                                                Click="ButtonTimeLayoutItemScrollIntoItem"/>
                                    </StackPanel>
                                    <GridSplitter Grid.Row="2" Grid.Column="1" Margin="2 0"/>
                                    <ci:Emptiable Grid.Row="2" Grid.Column="2" Grid.RowSpan="2"
                                                  IsDirectContentMode="True"
                                                  Data="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimePoint}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="16"
                                                        Spacing="8"
                                                        IsEnabled="{Binding ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing, Converter={StaticResource InvertBooleanConverter}}"
                                                        DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}}">
                                                <StackPanel.Styles>
                                                    <Style Selector="StackPanel.line-timePoint">
                                                        <Style Selector="^ ci|Field#FieldEndTime">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </Style>
                                                        <Style Selector="^ ci|Field#FieldTimeLayoutType">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </Style>
                                                    </Style>

                                                    <Style Selector="StackPanel#StackPanelClassTimePointSettings">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </Style>
                                                    <Style
                                                        Selector="StackPanel.onClass-timePoint StackPanel#StackPanelClassTimePointSettings">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </Style>

                                                    <Style Selector="StackPanel#StackPanelBreakingTimePointSettings">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </Style>
                                                    <Style
                                                        Selector="StackPanel.breaking-timePoint StackPanel#StackPanelBreakingTimePointSettings">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </Style>

                                                    <Style
                                                        Selector="StackPanel.action-timePoint StackPanel#StackPanelTimePointAttachedSettings">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </Style>
                                                </StackPanel.Styles>
                                                <Interaction.Behaviors>
                                                    <DataTriggerBehavior
                                                        Binding="{Binding ViewModel.SelectedTimePoint.TimeType}"
                                                        Value="0">
                                                        <AddClassAction ClassName="onClass-timePoint" />
                                                        <RemoveClassAction ClassName="breaking-timePoint" />
                                                        <RemoveClassAction ClassName="action-timePoint" />
                                                        <RemoveClassAction ClassName="line-timePoint" />
                                                    </DataTriggerBehavior>
                                                    <DataTriggerBehavior
                                                        Binding="{Binding ViewModel.SelectedTimePoint.TimeType}"
                                                        Value="1">
                                                        <RemoveClassAction ClassName="onClass-timePoint" />
                                                        <AddClassAction ClassName="breaking-timePoint" />
                                                        <RemoveClassAction ClassName="action-timePoint" />
                                                        <RemoveClassAction ClassName="line-timePoint" />
                                                    </DataTriggerBehavior>
                                                    <DataTriggerBehavior
                                                        Binding="{Binding ViewModel.SelectedTimePoint.TimeType}"
                                                        Value="2">
                                                        <RemoveClassAction ClassName="onClass-timePoint" />
                                                        <RemoveClassAction ClassName="breaking-timePoint" />
                                                        <RemoveClassAction ClassName="action-timePoint" />
                                                        <AddClassAction ClassName="line-timePoint" />
                                                    </DataTriggerBehavior>
                                                    <DataTriggerBehavior
                                                        Binding="{Binding ViewModel.SelectedTimePoint.TimeType}"
                                                        Value="3">
                                                        <RemoveClassAction ClassName="onClass-timePoint" />
                                                        <RemoveClassAction ClassName="breaking-timePoint" />
                                                        <AddClassAction ClassName="action-timePoint" />
                                                        <AddClassAction ClassName="line-timePoint" />
                                                    </DataTriggerBehavior>
                                                </Interaction.Behaviors>
                                                <StackPanel Spacing="8" Classes="tag-TimePointEditing">
                                                    <TextBlock Text="{x:Static locPw:Localization.EditTimePointHeader}"
                                                               Theme="{StaticResource SubtitleTextBlockStyle}" />
                                                    <!--<TextBlock Text="{Binding}"/>-->
                                                    <ci:Field Label="{x:Static locPw:Localization.StartTimeLabel}">
                                                        <TimePicker
                                                            SelectedTime="{Binding ViewModel.SelectedTimePoint.StartTime}"
                                                            UseSeconds="True" />
                                                    </ci:Field>
                                                    <ci:Field Label="{x:Static locPw:Localization.EndTimeLabel}" x:Name="FieldEndTime">
                                                        <TimePicker
                                                            SelectedTime="{Binding ViewModel.SelectedTimePoint.EndTime}"
                                                            UseSeconds="True">
                                                        </TimePicker>
                                                    </ci:Field>
                                                    <ci:Field Label="{x:Static locPw:Localization.TypeLabel}" x:Name="FieldTimeLayoutType">
                                                        <ListBox
                                                            Theme="{StaticResource ChipListBoxTheme}"
                                                            SelectedIndex="{Binding ViewModel.SelectedTimePoint.TimeType}">
                                                            <ListBoxItem>
                                                                <ci:IconText Glyph="&#xE47A;" Text="{x:Static locPw:Localization.OnClassLabel}" />
                                                            </ListBoxItem>
                                                            <ListBoxItem>
                                                                <ci:IconText Glyph="&#xE4C4;" Text="{x:Static locPw:Localization.BreakRestLabel}" />
                                                            </ListBoxItem>
                                                            <ListBoxItem IsVisible="False">
                                                                <ci:IconText Glyph="&#xF021;" Text="{x:Static locPw:Localization.SeparatorLabel}" />
                                                            </ListBoxItem>
                                                            <ListBoxItem IsVisible="False">
                                                                <ci:IconText Glyph="&#xE01F;" Text="{x:Static locPw:Localization.ActionLabel}" />
                                                            </ListBoxItem>
                                                        </ListBox>
                                                    </ci:Field>
                                                </StackPanel>
                                                <StackPanel x:Name="StackPanelClassTimePointSettings" Spacing="8">
                                                    <CheckBox Content="{x:Static locPw:Localization.HideByDefault}"
                                                              IsChecked="{Binding ViewModel.SelectedTimePoint.IsHideDefault}" />
                                                    <TextBlock Text="{x:Static locPw:Localization.HideByDefaultDescription}" TextWrapping="Wrap" 
                                                               Classes="l-instructive"/>

                                                    <Separator Margin="0 4 0 0" />
                                                    <ci:IconText Glyph="&#xE47A;" Text="{x:Static locPw:Localization.DefaultClassLabel}"  />
                                                    <ComboBox
                                                        HorizontalAlignment="Stretch"
                                                        ItemsSource="{Binding ViewModel.Subjects.List, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValueBinding="{Binding Key}"
                                                        SelectedValue="{Binding ViewModel.SelectedTimePoint.DefaultClassId}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Value.Name}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <WrapPanel Orientation="Horizontal" Margin="0 4 0 0" Classes="animated-resize">
                                                        <Button Theme="{StaticResource TransparentButton}"
                                                                Click="ButtonOverwriteClasses_OnClick"
                                                                IsEnabled="{Binding ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing, Converter={StaticResource InvertBooleanConverter}}">
                                                            <ci:IconText Glyph="&#xE1A1;" Text="{x:Static locPw:Localization.OverwriteExistingClasses}" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel x:Name="StackPanelBreakingTimePointSettings">
                                                    <ci:Field Label="{x:Static locPw:Localization.BreakNameLabel}">
                                                        <AutoCompleteBox
                                                            ItemsSource="{Binding $parent[views:ProfileSettingsWindow].ViewModel.CurrentProfileBreakNames}"
                                                            Text="{Binding ViewModel.SelectedTimePoint.BreakName}"
                                                            GotFocus="StackPanelBreakingTimePointSettings_OnGotFocus"/>
                                                    </ci:Field>
                                                </StackPanel>
                                                <Separator Margin="0 4 0 8" />
                                                <StackPanel x:Name="StackPanelTimePointAttachedSettings">
                                                    <ci:IconText Glyph="&#xEF2B;" Text="{x:Static locPw:Localization.MoreOptionsLabel}" Margin="0 0 0 8" />
                                                    <ItemsControl
                                                        ItemsSource="{x:Static services:IAttachedSettingsHostService.TimePointSettingsAttachedSettingsControls}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ci:AttachedSettingsControlPresenter
                                                                    ControlInfo="{Binding}"
                                                                    ContentIndex="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimePointIndex, Mode=OneWay}"
                                                                    TargetObject="{Binding $parent[views:ProfileSettingsWindow].ViewModel.SelectedTimePoint}">
                                                                    <ci:AttachedSettingsControlPresenter.ContentId>
                                                                        <MultiBinding
                                                                            Converter="{StaticResource TimeLayoutDictionaryKeyFinderMultiConverter}"
                                                                            Mode="OneWay">
                                                                            <Binding
                                                                                Path="$parent[views:ProfileSettingsWindow].ViewModel.SelectedTimeLayout" />
                                                                            <Binding
                                                                                Path="$parent[views:ProfileSettingsWindow].ViewModel.ProfileService.Profile.TimeLayouts" />
                                                                        </MultiBinding>
                                                                    </ci:AttachedSettingsControlPresenter.ContentId>
                                                                </ci:AttachedSettingsControlPresenter>

                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel x:Name="StackPanelActionTimePointSettings"
                                                            IsVisible="{Binding ViewModel.SelectedTimePoint.ActionSet, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <ci:IconText Glyph="&#xE01F;" Text="{x:Static locPw:Localization.ActionLabel}" Margin="0 0 0 8" />
                                                    <controls:FAInfoBar
                                                        IsClosable="False"
                                                        IsOpen="True"
                                                        IsVisible="{Binding !ViewModel.ProfileService.IsCurrentProfileTrusted, RelativeSource={RelativeSource AncestorType=views:ProfileSettingsWindow}}"
                                                        Severity="Warning"
                                                        Title="{x:Static locPw:Localization.UntrustedProfileTitle}"
                                                        Message="{x:Static locPw:Localization.UntrustedProfileInfoBarMessage}"
                                                        Margin="0 4"/>
                                                    <automation:ActionSetRunningControl ActionSet="{Binding ViewModel.SelectedTimePoint.ActionSet}"
                                                            Margin="0 0 0 6"
                                                            IsRevertButtonVisible="False"/>
                                                    <automation:ActionControl
                                                        ActionSet="{Binding ViewModel.SelectedTimePoint.ActionSet}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </ci:Emptiable >
                                </Grid>
                                
                            </ci:Emptiable>
                        </Grid>
                    </ci:Lazy>
                </TabItem>
                <TabItem Header="{x:Static locPw:Localization.SchedulesTabHeader}" Classes="tag-Schedules"
                         IsVisible="{Binding !ViewModel.ManagementService.Policy.DisableProfileEditing}">
                    <ci:Lazy>
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="375" MinWidth="250" MaxWidth="450"/>
                            </Grid.ColumnDefinitions>

                            <controls:FAInfoBar Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"
                                                Severity="Warning" Message="{x:Static locPw:Localization.ExperimentalFeatureWarning}"
                                                IsOpen="True"
                                                IsClosable="False"/>

                            <!-- 课程操作 -->
                            <controls:FACommandBar Grid.Column="0" Grid.ColumnSpan="3"
                                                   Grid.Row="1" DefaultLabelPosition="Right">
                                <controls:FACommandBar.IsEnabled>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileEditing"/>
                                        <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing"/>
                                        <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing"/>
                                        <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing"/>
                                    </MultiBinding>
                                </controls:FACommandBar.IsEnabled>
                                <controls:FACommandBar.PrimaryCommands>
                                    <controls:FACommandBarButton Click="ButtonAddScheduleItem_OnClick"
                                                               ToolTip.Tip="{x:Static locPw:Localization.CreateScheduleTip}" Label="{x:Static locPw:Localization.AddLabel}">
                                        <controls:FACommandBarButton.IconSource>
                                            <ci:FluentIconSource Glyph="{ci:FI AddRegular}"/>
                                        </controls:FACommandBarButton.IconSource>
                                    </controls:FACommandBarButton>
                                    <controls:FACommandBarSeparator/>
                                    <controls:FACommandBarButton Click="ButtonDuplicateScheduleItem_OnClick"
                                                               ToolTip.Tip="{x:Static locPw:Localization.DuplicateScheduleTip}"
                                                               IsEnabled="{Binding ViewModel.SelectedScheduleItemKvp, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                               Label="{x:Static locPw:Localization.DuplicateLabel}">
                                        <controls:FACommandBarButton.IconSource>
                                            <ci:FluentIconSource Glyph="{ci:FI CopyRegular}"/>
                                        </controls:FACommandBarButton.IconSource>
                                    </controls:FACommandBarButton>
                                    <controls:FACommandBarButton Click="ButtonDeleteScheduleItem_OnClick"
                                                               ToolTip.Tip="{x:Static locPw:Localization.DeleteScheduleTip}"
                                                               IsEnabled="{Binding ViewModel.SelectedScheduleItemKvp, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                               Label="{x:Static locPw:Localization.DeleteLabel}">
                                        <controls:FACommandBarButton.IconSource>
                                            <ci:FluentIconSource Glyph="{ci:FI DeleteRegular}"/>
                                        </controls:FACommandBarButton.IconSource>
                                    </controls:FACommandBarButton>
                                </controls:FACommandBar.PrimaryCommands>
                            </controls:FACommandBar>
                            <!-- 课程选择 -->
                            <Grid Grid.Row="2" Grid.Column="0" Margin="0 0 3 0">
                                <ci:ReusableTabControl TabStripPlacement="Bottom" Classes="compact barrier schedule-editor-tabs" Padding="0"
                                                       SelectedIndex="{Binding ViewModel.SettingsService.Settings.ScheduleEditModeIndex, Mode=TwoWay}">
                                    <ci:ReusableTabControl.Styles>
                                        <Style Selector="TabControl.schedule-editor-tabs /template/ DockPanel > Panel">
                                            <Setter Property="ClipToBounds" Value="False"/>
                                        </Style>
                                    </ci:ReusableTabControl.Styles>
                                    <TabItem ToolTip.Tip="{x:Static locPw:Localization.ListViewToolTip}">
                                        <TabItem.Header><ci:FluentIcon Glyph="{ci:FI TextBulletListLtrRegular}"/></TabItem.Header>
                                <DataGrid Grid.Row="0"
                                          x:Name="DataGridScheduleItems"
                                          ItemsSource="{Binding ViewModel.ScheduleItems.List}"
                                          AutoGenerateColumns="False"
                                          SelectedItem="{Binding ViewModel.SelectedScheduleItemKvp}"
                                          GridLinesVisibility="All"
                                          CanUserSortColumns="False"
                                          FontSize="13">
                                    <DataGrid.IsReadOnly>
                                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                            <Binding Path="ViewModel.ManagementService.Policy.DisableProfileEditing"/>
                                            <Binding Path="ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing"/>
                                            <Binding Path="ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing"/>
                                            <Binding Path="ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing"/>
                                        </MultiBinding>
                                    </DataGrid.IsReadOnly>
                                    <Interaction.Behaviors>
                                        <BehaviorCollection>
                                            <ManagedContextDropBehavior
                                                AcceptDataFormat="{x:Static views:ScheduleItemDataGridDropHandler.DataFormat}"
                                                Context="{Binding ViewModel.ScheduleItems.List}"
                                                Handler="{StaticResource ScheduleItemDataGridDropHandler}">
                                                <ManagedContextDropBehavior.AllowDrop>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileEditing"/>
                                                        <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing"/>
                                                        <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing"/>
                                                        <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing"/>
                                                    </MultiBinding>
                                                </ManagedContextDropBehavior.AllowDrop>
                                            </ManagedContextDropBehavior>
                                        </BehaviorCollection>
                                    </Interaction.Behaviors>
                                    <DataGrid.Styles>
                                        <Style Selector="DataGridRow TextBlock, DataGridRow TextBox">
                                            <Setter Property="TextElement.FontSize" Value="13"/>
                                        </Style>
                                        <Style Selector="DataGridRow.DraggingUp">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <Setter Property="BorderThickness" Value="0 2 0 0"/>
                                        </Style>
                                        <Style Selector="DataGridRow.DraggingDown">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <Setter Property="BorderThickness" Value="0 0 0 2"/>
                                        </Style>
                                    </DataGrid.Styles>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" IsReadOnly="True" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                          Background="Transparent">
                                                        <Interaction.Behaviors>
                                                            <ci:AdvancedManagedContextDragBehavior
                                                                Context="{Binding}"
                                                                DataFormat="{x:Static views:ScheduleItemDataGridDropHandler.DataFormat}"
                                                                HorizontalDragThreshold="33550336"
                                                                VerticalDragThreshold="3"
                                                                CanDragWithoutDragThumb="True"
                                                                PreviewOpacity="0.5">
                                                                <ci:AdvancedManagedContextDragBehavior.IsEnabled>
                                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                        <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileEditing"
                                                                                 Converter="{StaticResource InvertBooleanConverter}"/>
                                                                        <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing"
                                                                                 Converter="{StaticResource InvertBooleanConverter}"/>
                                                                        <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing"
                                                                                 Converter="{StaticResource InvertBooleanConverter}"/>
                                                                        <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing"
                                                                                 Converter="{StaticResource InvertBooleanConverter}"/>
                                                                    </MultiBinding>
                                                                </ci:AdvancedManagedContextDragBehavior.IsEnabled>
                                                            </ci:AdvancedManagedContextDragBehavior>
                                                        </Interaction.Behaviors>
                                                        <ci:TouchDragThumb HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Stretch" Height="32" Opacity="0"/>
                                                        <ci:FluentIcon Glyph="{ci:FI BookClockRegular}"
                                                                       Classes="l-instructive"
                                                                       ToolTip.Tip="{x:Static locPw:Localization.DragToReorderTip}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{x:Static locPw:Localization.SubjectLabel}" Width="*" MinWidth="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentControl
                                                        Content="{Binding Value.SubjectId, Converter={StaticResource SubjectIdToSubjectConverter}, TargetNullValue={StaticResource UnspecifiedScheduleSubject}, FallbackValue={StaticResource UnspecifiedScheduleSubject}}"
                                                        VerticalAlignment="Center" Margin="6 0">
                                                        <ContentControl.ContentTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}"/>
                                                            </DataTemplate>
                                                        </ContentControl.ContentTemplate>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding $parent[views:ProfileSettingsWindow].ViewModel.ScheduleItemSubjects.List}"
                                                              SelectedValue="{Binding Value.SubjectId, Mode=TwoWay}"
                                                              SelectedValueBinding="{Binding Key}"
                                                              HorizontalAlignment="Stretch"
                                                              Margin="0 -4">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Value.Name}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{x:Static locPw:Localization.StartTimeLabel}" Width="180" MinWidth="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Value.StartTime, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                                                               VerticalAlignment="Center" Margin="6 0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TimePicker SelectedTime="{Binding Value.StartTime, Mode=TwoWay}"
                                                                UseSeconds="True" Margin="0 -4"
                                                                MinWidth="0" HorizontalAlignment="Stretch"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{x:Static locPw:Localization.EndTimeLabel}" Width="180" MinWidth="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Value.EndTime, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                                                               VerticalAlignment="Center" Margin="6 0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TimePicker SelectedTime="{Binding Value.EndTime, Mode=TwoWay}"
                                                                UseSeconds="True" Margin="0 -4"
                                                                MinWidth="0" HorizontalAlignment="Stretch"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                    </TabItem>
                                    <TabItem ToolTip.Tip="{x:Static locPw:Localization.ScheduleViewToolTip}">
                                        <TabItem.Header><ci:FluentIcon Glyph="{ci:FI CalendarWeekStartRegular}"/></TabItem.Header>
                                        <Grid RowDefinitions="Auto,*">
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <CalendarDatePicker Width="150" Margin="0,0,4,0"
                                                    SelectedDate="{Binding ViewModel.ScheduleWeekNavigationDate, Mode=TwoWay}"
                                                    DisplayDateEnd="{Binding ViewModel.ScheduleWeekNavigationMaxDate}"
                                                    ToolTip.Tip="{x:Static locPw:Localization.PickDateToJumpWeekTip}"/>
                                                <Button Click="ScheduleWeekPrevious_OnClick" ToolTip.Tip="{x:Static locPw:Localization.PreviousWeekTip}" Margin="0,0,4,0"
                                                        Theme="{StaticResource TransparentButton}">
                                                    <ci:FluentIcon Glyph="{ci:FI ChevronLeftRegular}"/>
                                                </Button>
                                                <Button Click="ScheduleWeekToday_OnClick" Content="{x:Static locPw:Localization.ThisWeekLabel}" Margin="0,0,4,0"
                                                        Theme="{StaticResource TransparentButton}"/>
                                                <Button Click="ScheduleWeekNext_OnClick" ToolTip.Tip="{x:Static locPw:Localization.NextWeekTip}" Margin="0,0,4,0"
                                                        Theme="{StaticResource TransparentButton}">
                                                    <ci:FluentIcon Glyph="{ci:FI ChevronRightRegular}"/>
                                                </Button>
                                                <TextBlock Text="{Binding ViewModel.ScheduleWeekCaption}" VerticalAlignment="Center" FontSize="12"/>
                                            </WrapPanel>
                                            <scheduleWeek:ScheduleWeekEditControl Grid.Row="1" x:Name="ScheduleWeekEditor"
                                                WeekStart="{Binding ViewModel.ScheduleWeekStart}"
                                                SelectedScheduleItemId="{Binding ViewModel.SelectedScheduleItemId, Mode=TwoWay}"
                                                SelectedDate="{Binding ViewModel.ScheduleWeekSelectedDate, Mode=TwoWay}"
                                                SelectedTime="{Binding ViewModel.ScheduleWeekSelectedTime, Mode=TwoWay}"
                                                CreateRequested="ScheduleWeekEditor_OnCreateRequested"
                                                EditRequested="ScheduleWeekEditor_OnEditRequested"
                                                DeleteRequested="ScheduleWeekEditor_OnDeleteRequested"
                                                Margin="0 0 0 -28">
                                                <scheduleWeek:ScheduleWeekEditControl.IsReadonly>
                                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                        <Binding Path="ViewModel.ManagementService.Policy.DisableProfileEditing"/>
                                                        <Binding Path="ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing"/>
                                                        <Binding Path="ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing"/>
                                                        <Binding Path="ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing"/>
                                                    </MultiBinding>
                                                </scheduleWeek:ScheduleWeekEditControl.IsReadonly>
                                            </scheduleWeek:ScheduleWeekEditControl>
                                        </Grid>
                                    </TabItem>
                                </ci:ReusableTabControl>
                            </Grid>

                            <!-- Gutter -->
                            <GridSplitter Grid.Row="2"
                                          Grid.Column="1"
                                          MaxWidth="500"
                                          Width="5" HorizontalAlignment="Stretch"/>

                            <!-- 课程编辑 -->
                            <ci:Emptiable Grid.Row="2" Grid.Column="2"
                                          IsDirectContentMode="True"
                                          Data="{Binding ViewModel.SelectedScheduleItem}">
                                <Grid Margin="3 0 0 0"
                                      DataContext="{Binding ViewModel.SelectedScheduleItem}" RowDefinitions="Auto,*">
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="6" Margin="8">
                                            <StackPanel.IsEnabled>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileEditing"
                                                             Converter="{StaticResource InvertBooleanConverter}"/>
                                                    <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing"
                                                             Converter="{StaticResource InvertBooleanConverter}"/>
                                                    <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing"
                                                             Converter="{StaticResource InvertBooleanConverter}"/>
                                                    <Binding Path="$parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing"
                                                             Converter="{StaticResource InvertBooleanConverter}"/>
                                                </MultiBinding>
                                            </StackPanel.IsEnabled>
                                            <TextBlock Text="{x:Static locPw:Localization.EditClassInfoHeader}"
                                                       Theme="{StaticResource SubtitleTextBlockStyle}"/>
                                            <ci:Field Label="{x:Static locPw:Localization.SubjectLabel}">
                                                <ComboBox ItemsSource="{Binding $parent[views:ProfileSettingsWindow].ViewModel.ScheduleItemSubjects.List}"
                                                          SelectedValue="{Binding SubjectId, Mode=TwoWay}"
                                                          SelectedValueBinding="{Binding Key}"
                                                          HorizontalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Value.Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </ci:Field>
                                            <ci:Field Label="{x:Static locPw:Localization.StartTimeLabel}">
                                                <TimePicker SelectedTime="{Binding StartTime, Mode=TwoWay}"
                                                            UseSeconds="True" MinWidth="0"
                                                            HorizontalAlignment="Stretch"/>
                                            </ci:Field>
                                            <ci:Field Label="{x:Static locPw:Localization.EndTimeLabel}">
                                                <TimePicker SelectedTime="{Binding EndTime, Mode=TwoWay}"
                                                            UseSeconds="True" MinWidth="0"
                                                            HorizontalAlignment="Stretch"/>
                                            </ci:Field>
                                            <controls1:TimeRuleEditControl x:Name="ScheduleItemTimeRuleEditControl"
                                                                           TimeRule="{Binding EnableRule, Mode=OneWay}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </ci:Emptiable>
                        </Grid>
                    </ci:Lazy>
                </TabItem>
                <TabItem Header="{x:Static locPw:Localization.SubjectLabel}" Classes="tag-Subjects"
                         IsVisible="{Binding !ViewModel.ManagementService.Policy.DisableProfileEditing}">
                    <ci:Lazy>
                        <Grid RowDefinitions="Auto,*">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="450" MaxWidth="500" MinWidth="200"/>
                            </Grid.ColumnDefinitions>
                            <!-- 科目操作 -->
                            <controls:FACommandBar Grid.Column="0" Grid.ColumnSpan="3"
                                     Grid.Row="0" DefaultLabelPosition="Right"
                                     IsEnabled="{Binding ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing, Converter={StaticResource BooleanToBooleanReConverter}}">
                                <controls:FACommandBar.PrimaryCommands>
                                    <controls:FACommandBarButton Click="ButtonAddSubject_OnClick" ToolTip.Tip="{x:Static locPw:Localization.CreateSubjectTip}"
                                                               IconSource="{ci:FluentIconSource &#xE00D;}" Label="{x:Static locPw:Localization.AddLabel}"/>
                                    <controls:FACommandBarSeparator/>
                                    <controls:FACommandBarButton Click="ButtonDuplicateSubject_OnClick" ToolTip.Tip="{x:Static locPw:Localization.DuplicateSubjectTip}"
                                                               IsEnabled="{Binding ViewModel.SelectedSubjectKvp, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                               IconSource="{ci:FluentIconSource &#xE58D;}" Label="{x:Static locPw:Localization.DuplicateLabel}"/>
                                    <controls:FACommandBarButton Click="ButtonDeleteSubject_OnClick" ToolTip.Tip="{x:Static locPw:Localization.DeleteSubjectTip}"
                                                               IsEnabled="{Binding ViewModel.SelectedSubjectKvp, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                               IconSource="{ci:FluentIconSource &#xE61D;}" Label="{x:Static locPw:Localization.DeleteLabel}"/>
                                </controls:FACommandBar.PrimaryCommands>
                            </controls:FACommandBar>
                            <!-- 科目选择 -->
                            <Grid Grid.Row="1" Grid.Column="0" Margin="0 0 3 0">
                                <!-- 科目 -->
                                <DataGrid Grid.Row="0"
                                          x:Name="DataGridSubjects"
                                          ItemsSource="{Binding ViewModel.Subjects.List}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="{Binding ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing}"
                                          SelectedItem="{Binding ViewModel.SelectedSubjectKvp}"
                                          GridLinesVisibility="All"
                                          CanUserSortColumns="False"
                                          FontSize="13">
                                    <Interaction.Behaviors>
                                        <BehaviorCollection>
                                            <ManagedContextDropBehavior
                                                AcceptDataFormat="{x:Static views:SubjectDataGridDropHandler.DataFormat}"
                                                AllowDrop="{Binding ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing, Converter={StaticResource InvertBooleanConverter}}"
                                                Context="{Binding ViewModel.Subjects.List}"
                                                Handler="{StaticResource SubjectDataGridDropHandler}"/>
                                        </BehaviorCollection>
                                    </Interaction.Behaviors>
                                    <DataGrid.Styles>
                                        <Style Selector="DataGridRow TextBlock, DataGridRow TextBox">
                                            <Setter Property="TextElement.FontSize" Value="13"/>
                                        </Style>
                                        <Style Selector="DataGridRow.DraggingUp">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <Setter Property="BorderThickness" Value="0 2 0 0"/>
                                        </Style>
                                        <Style Selector="DataGridRow.DraggingDown">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <Setter Property="BorderThickness" Value="0 0 0 2"/>
                                        </Style>
                                    </DataGrid.Styles>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" IsReadOnly="True"
                                                                Width="24">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                          Background="Transparent">
                                                        <Interaction.Behaviors>
                                                            <ci:AdvancedManagedContextDragBehavior
                                                                Context="{Binding}"
                                                                DataFormat="{x:Static views:SubjectDataGridDropHandler.DataFormat}"
                                                                HorizontalDragThreshold="33550336"
                                                                VerticalDragThreshold="3"
                                                                CanDragWithoutDragThumb="True"
                                                                PreviewOpacity="0.5"
                                                                IsEnabled="{Binding $parent[views:ProfileSettingsWindow].ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing, Converter={StaticResource InvertBooleanConverter}}"/>
                                                        </Interaction.Behaviors>
                                                        <ci:TouchDragThumb HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="32"
                                                                           IsExplicitVisible="True"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{x:Static locPw:Localization.IconLabel}" Width="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <controls:FAIconSourceElement IconSource="{Binding Value.Icon, Converter={StaticResource SubjectIconSourceConverter}}"
                                                                                  Width="20" Height="20" TextElement.FontSize="20"
                                                                                  Classes="repair-fontsize" HorizontalAlignment="Center"
                                                                                  IsHitTestVisible="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ci:IconExpressionEditor IconExpression="{Binding Value.Icon}"
                                                                             HorizontalAlignment="Center"
                                                                             IsEnabled="{Binding ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing, Converter={StaticResource InvertBooleanConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{x:Static locPw:Localization.ThemeColorLabel}" Width="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="24" Height="24" CornerRadius="4"
                                                            Background="{Binding Value.ColorHex, Converter={StaticResource SubjectColorBrushConverter}}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1" HorizontalAlignment="Center"
                                                            IsHitTestVisible="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ColorPicker Color="{Binding Value.ColorHex, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}"
                                                                 HorizontalAlignment="Center"
                                                                 IsEnabled="{Binding ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing, Converter={StaticResource InvertBooleanConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Value.Name, Mode=TwoWay}"
                                                            Header="{x:Static locPw:Localization.SubjectNameLabel}"/>
                                        <DataGridTextColumn Binding="{Binding Value.Initial, Mode=TwoWay}"
                                                                Header="{x:Static locPw:Localization.ShortNameLabel}"/>
                                        <DataGridCheckBoxColumn Binding="{Binding Value.IsOutDoor, Mode=TwoWay}"
                                                                    Header="{x:Static locPw:Localization.IsOutdoorColumnHeader}"/>
                                        <DataGridTextColumn Binding="{Binding Value.TeacherName, Mode=TwoWay}"
                                                                Header="{x:Static locPw:Localization.TeacherLabel}"/>
                                        <DataGridTextColumn Binding="{Binding Value.Location, Mode=TwoWay}"
                                                            Header="{x:Static locPw:Localization.LocationLabel}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- Gutter -->
                            <GridSplitter Grid.Row="1"
                                          Grid.Column="1"
                                          MaxWidth="500"
                                          Width="5" HorizontalAlignment="Stretch"/>

                            <!-- 科目编辑 -->
                            <ci:Emptiable Grid.Row="1" Grid.Column="2" 
                                          IsDirectContentMode="True"
                                          Data="{Binding ViewModel.SelectedSubject}">
                                <Grid Margin="3 0 0 0"
                                      DataContext="{Binding ViewModel.SelectedSubject}" RowDefinitions="Auto,*">
                                    <!-- 科目编辑 -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="6" Margin="8"
                                                    IsEnabled="{Binding ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing, Converter={StaticResource InvertBooleanConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}}">
                                            <TextBlock Text="{x:Static locPw:Localization.EditSubjectInfoHeader}"
                                                       Theme="{StaticResource SubtitleTextBlockStyle}"/>
                                            <!-- 科目名 & 简称 -->
                                            <Grid ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="4">
                                                <!-- 图标 -->
                                                <ci:Field Grid.Column="0" Label="{x:Static locPw:Localization.IconLabel}">
                                                    <ci:IconExpressionEditor IconExpression="{Binding Icon}"/>
                                                </ci:Field>
                                                <!-- 科目名 -->
                                                <ci:Field Grid.Column="1" Label="{x:Static locPw:Localization.SubjectNameLabel}">
                                                    <TextBox x:Name="TextBoxSubjectName"
                                                             Text="{Binding Name}" />
                                                </ci:Field>
                                                <!-- 简称 -->
                                                <ci:Field Grid.Column="2" Label="{x:Static locPw:Localization.ShortNameLabel}">
                                                    <TextBox Text="{Binding Initial}" />
                                                </ci:Field>
                                                <!-- 主题色 -->
                                                <ci:Field Grid.Column="3" Label="{x:Static locPw:Localization.ThemeColorLabel}">
                                                    <ColorPicker Color="{Binding ColorHex, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}"/>
                                                </ci:Field>
                                            </Grid>
                                            <!-- 科任老师 -->
                                            <ci:Field Label="{x:Static locPw:Localization.TeacherLabel}">
                                                <TextBox Text="{Binding TeacherName}" />
                                            </ci:Field>
                                            <!-- 地点 -->
                                            <ci:Field Label="{x:Static locPw:Localization.LocationLabel}">
                                                <TextBox Text="{Binding Location}" />
                                            </ci:Field>
                                            <!-- 户外课程 -->
                                            <CheckBox Margin="0 6 0 0"
                                                      IsChecked="{Binding IsOutDoor}"
                                                      Content="{x:Static locPw:Localization.IsOutdoorSubject}" />

                                            <!-- 附加属性 -->
                                            <Separator Margin="0 20 0 8" />
                                            <ci:IconText Glyph="&#xEF2B;" Text="{x:Static locPw:Localization.MoreOptionsLabel}" Margin="0 0 0 8" />
                                            <ItemsControl
                                                ItemsSource="{x:Static services:IAttachedSettingsHostService.SubjectSettingsAttachedSettingsControls}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ci:AttachedSettingsControlPresenter ControlInfo="{Binding}"
                                                            TargetObject="{Binding ViewModel.SelectedSubject, RelativeSource={RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}}">
                                                            <ci:AttachedSettingsControlPresenter.ContentId>
                                                                <Binding Path="ViewModel.SelectedSubjectKvp.Key"
                                                                         RelativeSource="{RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}" />
                                                            </ci:AttachedSettingsControlPresenter.ContentId>
                                                        </ci:AttachedSettingsControlPresenter>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </ci:Emptiable>

                        </Grid>
                    </ci:Lazy>
                </TabItem>
                <TabItem Header="{x:Static locPw:Localization.ForbiddenTabHeader}" Classes="tag-Forbidden"
                         IsVisible="{Binding ViewModel.ManagementService.Policy.DisableProfileEditing}">
                    <ci:Empty Text="{x:Static locPw:Localization.ProfileEditingDisabledByPolicy}"
                              Icon="{ci:FluentIconSource &#xee0f;, FontSize=48}"/>
                </TabItem>
                <TabItem Header="{x:Static locPw:Localization.AdjustmentTabHeader}" Classes="tag-Adjustment">
                    <ci:Lazy>
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" MinWidth="250" MaxWidth="400"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <controls:FACommandBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                 Classes="hide-popup-indicator"
                                                 DefaultLabelPosition="Right">
                                <controls:FACommandBar.PrimaryCommands>
                                    <controls:FACommandBarButton Click="ButtonRefreshScheduleAdjustmentView_OnClick" 
                                                               IconSource="{ci:FluentIconSource &#xE0B5;}"
                                                               Label="{x:Static locPw:Localization.RefreshLabel}"
                                                               IsEnabled="{Binding ViewModel.IsInScheduleSwappingMode, Converter={StaticResource InvertBooleanConverter}}"/>
                                    <controls:FACommandBarSeparator>
                                        <controls:FACommandBarSeparator.IsVisible>
                                            <Binding Path="#ScheduleAdjustmentTabControl.SelectedIndex"
                                                     Converter="{x:Static ObjectConverters.Equal}">
                                                <Binding.ConverterParameter>
                                                    <system:Int32>0</system:Int32>
                                                </Binding.ConverterParameter>
                                            </Binding>
                                        </controls:FACommandBarSeparator.IsVisible>
                                    </controls:FACommandBarSeparator>
                                    <controls:FACommandBarButton Click="ButtonEditClassInfoTemp_OnClick"
                                                               IconSource="{ci:FluentIconSource &#xE7C9;}"
                                                               Label="{x:Static locPw:Localization.ChangeClassHeader}"
                                                               IsEnabled="{Binding ViewModel.IsInScheduleSwappingMode, Converter={StaticResource InvertBooleanConverter}}">
                                        <controls:FACommandBarButton.IsVisible>
                                            <Binding Path="#ScheduleAdjustmentTabControl.SelectedIndex"
                                                     Converter="{x:Static ObjectConverters.Equal}">
                                                <Binding.ConverterParameter>
                                                    <system:Int32>0</system:Int32>
                                                </Binding.ConverterParameter>
                                            </Binding>
                                        </controls:FACommandBarButton.IsVisible>
                                    </controls:FACommandBarButton>
                                    <controls:FACommandBarButton Click="ButtonSwapSchedule_OnClick" 
                                                               IconSource="{ci:FluentIconSource &#xE15F;}"
                                                               Label="{x:Static locPw:Localization.SwapClassesLabel}"
                                                               IsEnabled="{Binding ViewModel.IsInScheduleSwappingMode, Converter={StaticResource InvertBooleanConverter}}">
                                        <controls:FACommandBarButton.IsVisible>
                                            <Binding Path="#ScheduleAdjustmentTabControl.SelectedIndex"
                                                     Converter="{x:Static ObjectConverters.Equal}">
                                                <Binding.ConverterParameter>
                                                    <system:Int32>0</system:Int32>
                                                </Binding.ConverterParameter>
                                            </Binding>
                                        </controls:FACommandBarButton.IsVisible>
                                    </controls:FACommandBarButton>
                                    <controls:FACommandBarButton Click="ButtonCancelClassSwap_OnClick" 
                                                               IconSource="{ci:FluentIconSource &#xE671;}"
                                                               Label="{x:Static locPw:Localization.CancelLabel}"
                                                               IsEnabled="{Binding !ViewModel.IsInScheduleSwappingMode, Converter={StaticResource InvertBooleanConverter}}">
                                        <controls:FACommandBarButton.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="#ScheduleAdjustmentTabControl.SelectedIndex"
                                                         Converter="{x:Static ObjectConverters.Equal}">
                                                    <Binding.ConverterParameter>
                                                        <system:Int32>0</system:Int32>
                                                    </Binding.ConverterParameter>
                                                </Binding>
                                                <Binding Path="ViewModel.IsInScheduleSwappingMode"/>
                                            </MultiBinding>
                                        </controls:FACommandBarButton.IsVisible>
                                    </controls:FACommandBarButton>
                                    <controls:FACommandBarButton Click="ButtonSwapScheduleComplete_OnClick" 
                                                               IconSource="{ci:FluentIconSource &#xE424;}"
                                                               Label="{x:Static locPw:Localization.CompleteSwapLabel}"
                                                               IsEnabled="{Binding !ViewModel.IsInScheduleSwappingMode, Converter={StaticResource InvertBooleanConverter}}">
                                        <controls:FACommandBarButton.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="#ScheduleAdjustmentTabControl.SelectedIndex"
                                                         Converter="{x:Static ObjectConverters.Equal}">
                                                    <Binding.ConverterParameter>
                                                        <system:Int32>0</system:Int32>
                                                    </Binding.ConverterParameter>
                                                </Binding>
                                                <Binding Path="ViewModel.IsInScheduleSwappingMode"/>
                                            </MultiBinding>
                                        </controls:FACommandBarButton.IsVisible>
                                    </controls:FACommandBarButton>
                                    <controls:FACommandBarElementContainer>
                                        <controls:FACommandBarElementContainer.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="#ScheduleAdjustmentTabControl.SelectedIndex"
                                                         Converter="{x:Static ObjectConverters.Equal}">
                                                    <Binding.ConverterParameter>
                                                        <system:Int32>0</system:Int32>
                                                    </Binding.ConverterParameter>
                                                </Binding>
                                                <Binding Path="ViewModel.IsInScheduleSwappingMode"/>
                                            </MultiBinding>
                                        </controls:FACommandBarElementContainer.IsVisible>
                                        <CheckBox
                                            IsEnabled="{Binding !ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing}"
                                            IsChecked="{Binding ViewModel.IsTempSwapMode, Converter={StaticResource InvertBooleanConverter}}"
                                            Content="{x:Static locPw:Localization.TempSwapModeLabel}" />
                                    </controls:FACommandBarElementContainer>
                                </controls:FACommandBar.PrimaryCommands>
                            </controls:FACommandBar>

                            <ListBox Grid.Row="1" Grid.Column="0"
                                     ItemsSource="{Binding ViewModel.OrderedSchedules.List}"
                                     SelectedValue="{Binding ViewModel.ScheduleCalendarSelectedDate}"
                                     SelectedValueBinding="{Binding Key}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center">
                                                <Run
                                                    Text="{Binding Key, Mode=OneWay, StringFormat={}{0:yy/MM/dd ddd}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                                          VerticalAlignment="Stretch"
                                          Width="5"
                                          Margin="4 0"
                                          ResizeBehavior="PreviousAndNext"/>

                            <ci:ReusableTabControl Grid.Row="1" Grid.Column="2" x:Name="ScheduleAdjustmentTabControl"
                                        SelectionChanged="ScheduleAdjustmentTabControl_OnSelectionChanged"
                                        TabStripPlacement="Bottom"
                                        Padding="0"
                                        Classes="compact">
                                <TabItem Header="{ci:FluentIcon &#xF0EB;}">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <Border Background="#204169e1" 
                                                Grid.Row="2"
                                                IsVisible="{Binding ViewModel.IsInScheduleSwappingMode}">
                                            <Grid>
                                                <DockPanel Margin="8 4">
                                                    <ci:FluentIcon Glyph="&#xE15F;"
                                                        Height="20" Width="20" FontSize="20"/>
                                                    <TextBlock TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Margin="4 0 0 0" >
                                                        <Run Text="{x:Static locPw:Localization.SwapClassesIntroPrefix}" />
                                                        <Run Text="{Binding ViewModel.ClassSwapStartPosition, Mode=OneWay}"/>
                                                        <Run Text="{x:Static locPw:Localization.SwapClassesIntroSuffix}" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </Grid>
                                        </Border>

                                        <scheduleDataGrid:ScheduleDataGrid Grid.Row="1" Grid.Column="0"
                                                                           x:Name="ScheduleDataGridAdjustment"
                                                                           TutorialContextId="profileSettingsWindow.adjustment"
                                                                           IsReadonly="True"
                                                                           SelectedClassInfo="{Binding ViewModel.SelectedClassInfo, Mode=TwoWay}"
                                                                           SelectedClassInfoIndex="{Binding ViewModel.SelectedClassIndex2, Mode=TwoWay}"
                                                                           SelectedClassPlan="{Binding ViewModel.SelectedClassPlan, Mode=TwoWay}"
                                                                           SelectedDate="{Binding ViewModel.ScheduleCalendarSelectedDate, Mode=TwoWay}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{ci:FluentIcon &#xE304;}">
                                    <controls1:ScheduleCalendarControl x:Name="ScheduleCalendarControl"
                                                                      DisplayDate="{Binding ViewModel.ScheduleCalendarSelectedDate, Mode=TwoWay}"
                                                                      SelectedDate="{Binding ViewModel.ScheduleCalendarSelectedDate, Mode=TwoWay}" />
                                </TabItem>
                            </ci:ReusableTabControl>
                        </Grid>
                    </ci:Lazy>
                </TabItem>
            </ci:ReusableTabControl>

            <!-- 信息栏 -->
            <ci:TutorialBarrier Grid.Column="1" Grid.Row="0" >
                <controls:FACommandBar Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" DefaultLabelPosition="Right"
                                     Classes="tag-InfoBar">
                    <controls:FACommandBar.SecondaryCommands>
                        
                    </controls:FACommandBar.SecondaryCommands>
                    <controls:FACommandBar.PrimaryCommands>
                        <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xe699;}"
                                                   Label="{Binding ViewModel.ProfileService.CurrentProfilePath}"
                                                   ToolTip.Tip="{x:Static locPw:Localization.CurrentProfileTip}"
                                                   Click="ButtonOpenProfileManager_OnClick"/>
                        <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xe6b1;}"
                                                   Click="ButtonOpenTempClassPlans_OnClick"
                                                   Label="{Binding ViewModel.LessonsService.CurrentClassPlan.Name, FallbackValue={x:Static locPw:Localization.CurrentProfileNoneLabel}}"
                                                   ToolTip.Tip="{x:Static locPw:Localization.EnableTempClassPlanTip}"/>
                        <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xe92f;}"
                                                   Click="ButtonClassPlansGroup_OnClick"
                                                   ToolTip.Tip="{x:Static locPw:Localization.ManageClassPlanGroupsLabel}"
                                                   Label="{Binding Data.Name, Source={StaticResource ClassPlanGroupBindingProxy}, Mode=OneWay}"/>
                        <controls:FACommandBarSeparator/>
                        <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xf431;}"
                                                   Label="{x:Static locPw:Localization.UntrustedLabel}"
                                                   Click="ButtonTrustProfile_OnClick"
                                                   ToolTip.Tip="{x:Static locPw:Localization.UntrustedProfileTip}"
                                                   IsVisible="{Binding ViewModel.ProfileService.IsCurrentProfileTrusted, Converter={StaticResource InvertBooleanConverter}}" />
                        <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xeeb5;}"
                                                   Label="{x:Static locPw:Localization.SaveLabel}"
                                                   Click="ButtonSaveProfile_OnClick"
                                                   ToolTip.Tip="{x:Static locPw:Localization.SaveProfileTip}"/>
                        <controls:FACommandBarButton x:Name="ProfileTransferButton"
                                                   IconSource="{ci:FluentIconSource &#xe68f;}"
                                                   Label="{x:Static locPw:Localization.ImportExportLabel}"
                                                   ToolTip.Tip="{x:Static locPw:Localization.ImportExportTip}">
                            <controls:FACommandBarButton.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileEditing"/>
                                    <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileClassPlanEditing"/>
                                    <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileTimeLayoutEditing"/>
                                    <Binding Path="!ViewModel.ManagementService.Policy.DisableProfileSubjectsEditing"/>
                                </MultiBinding>
                            </controls:FACommandBarButton.IsVisible>
                            <controls:FACommandBarButton.Flyout>
                                <MenuFlyout />
                            </controls:FACommandBarButton.Flyout>
                        </controls:FACommandBarButton>
                        <controls:FACommandBarButton IconSource="{ci:FluentIconSource &#xee2f;}"
                                                   Label="{x:Static locPw:Localization.HelpLabel}"
                                                   Click="ButtonHelp_OnClick"
                                                   CommandParameter="https://docs.classisland.tech/app/profile/"
                                                   ToolTip.Tip="{x:Static locPw:Localization.ViewHelpTip}"/>
                    </controls:FACommandBar.PrimaryCommands>
                </controls:FACommandBar>
            </ci:TutorialBarrier>   
        </Grid>
    </ci:DrawerHost>
</ci:ViewBase>
