<ci:ViewBase x:Class="ClassIsland.Views.DevPreviewNoticeWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassIsland.Views"
        xmlns:ci="http://classfabric.tech/schemas/xaml/core"
        xmlns:locM="clr-namespace:ClassFabric.Assets.Localization.Main"
        mc:Ignorable="d"
        Header="ClassFabric"
        HostWidth="460"
        HostStartupLocation="CenterScreen"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        ShowAsDialog="True"
        MinHeight="120"
        d:DataContext="{d:DesignInstance local:DevPreviewNoticeWindow}">
    <Grid Margin="20 16 20 18" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
        <ci:FluentIcon Grid.Row="0" Grid.Column="0" Glyph="{ci:FI BugRegular}"
                       Width="40" Height="40" FontSize="40"
                       Margin="0 0 16 0" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0 0 0 14">
            <TextBlock Text="{x:Static locM:Localization.DevPreviewHeader}"
                       Theme="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock Text="{x:Static locM:Localization.DevPreviewContent}"
                       TextWrapping="Wrap" Margin="0 6 0 0"/>
        </StackPanel>

        <SplitButton Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                     HorizontalAlignment="Right"
                     Classes="accent"
                     Click="ButtonOk_OnClick"
                     IsVisible="{Binding !ViewModel.SuppressPermanentChosen}">
            确定
            <SplitButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" ShowMode="TransientWithDismissOnPointerMoveAway">
                    <StackPanel MinWidth="220" Spacing="0" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12 9"
                                Click="ButtonSuppressOnce_OnClick">
                            <StackPanel>
                                <TextBlock Text="下次启动不再显示" FontWeight="Medium"/>
                                <TextBlock Text="仅跳过下一次启动的提示" FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12 9"
                                Click="ButtonSuppressPermanent_OnClick">
                            <StackPanel>
                                <TextBlock Text="永久不再显示" FontWeight="Medium"/>
                                <TextBlock Text="本机不再弹出此提示，可在「设置 → 关于」重新开启" FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Flyout>
            </SplitButton.Flyout>
        </SplitButton>

        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                HorizontalAlignment="Right" Classes="accent"
                Click="ButtonOk_OnClick"
                IsVisible="{Binding ViewModel.SuppressPermanentChosen}">
            确定
        </Button>
    </Grid>
</ci:ViewBase>
