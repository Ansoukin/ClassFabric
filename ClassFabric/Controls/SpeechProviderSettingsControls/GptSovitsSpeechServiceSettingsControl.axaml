<ci:SpeechProviderControlBase x:Class="ClassIsland.Controls.SpeechProviderSettingsControls.GptSovitsSpeechServiceSettingsControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClassIsland.Controls.SpeechProviderSettingsControls"
             xmlns:ci="http://classfabric.tech/schemas/xaml/core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:locSp="clr-namespace:ClassFabric.Assets.Localization.Controls.SpeechProviderSettingsControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ci:SpeechProviderControlBase.Resources>
        <ci:BindingProxy x:Key="BindingProxy" Data="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:GptSovitsSpeechServiceSettingsControl}}"
                         x:TypeArguments="local:GptSovitsSpeechServiceSettingsControl"/>
        <Grid Width="300" Margin="16" x:Key="SpeechPresets" 
              DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:GptSovitsSpeechServiceSettingsControl}}"
              RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0">
                <TextBlock Text="{x:Static locSp:Localization.SpeechPresetsTitle}" Theme="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0 0 0 8" />
                <TextBlock Text="{x:Static locSp:Localization.ManageSpeechPresetsTip}" TextWrapping="Wrap"
                           Margin="0 0 0 4" />
                <WrapPanel>
                    <Button Theme="{StaticResource TransparentButton}"
                            HorizontalAlignment="Left"
                            Click="ButtonSaveGptSovitsPreset_OnClick">
                        <ci:IconText Glyph="&#xeeb4;" Text="{x:Static locSp:Localization.SavePreset}"/>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding GptSoVitsSpeechSettingsPresets}"
                      AutoGenerateColumns="False"
                      BeginningEdit="DataGridPresets_OnBeginningEdit"
                      SelectedItem="{Binding SelectedGptSoVitsSpeechPreset}">
                <DataGrid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Resources>
                    <ci:BindingProxy x:Key="BindingProxy" Data="{Binding}"
                                     x:TypeArguments="local:GptSovitsSpeechServiceSettingsControl"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding PresetName}"
                                        Header="{x:Static locSp:Localization.PresetNameColumn}"
                                        Width="*"/>
                    <DataGridTemplateColumn Header="{x:Static locSp:Localization.ActionsColumn}"
                                            Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" >
                                    <Button Theme="{StaticResource TransparentButton}"
                                            Content="{ci:FluentIcon &#xe0d3;}"
                                            Margin="0 -8"
                                            ToolTip.Tip="{x:Static locSp:Localization.LoadTooltip}"
                                            Command="{Binding Data.LoadGptSoVitsPresetCommand, Source={StaticResource BindingProxy}}"
                                            CommandParameter="{Binding}"/>

                                    <Button Theme="{StaticResource TransparentButton}"
                                            Content="{ci:FluentIcon &#xe1a1;}"
                                            Margin="0 -8"
                                            ToolTip.Tip="{x:Static locSp:Localization.OverwriteTooltip}"
                                            IsVisible="{Binding !IsInternal}"
                                            Command="{Binding Data.OverwriteGptSoVitsPresetCommand, Source={StaticResource BindingProxy}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Theme="{StaticResource TransparentButton}"
                                            Content="{ci:FluentIcon &#xe58b;}"
                                            Margin="0 -8"
                                            ToolTip.Tip="{x:Static locSp:Localization.DuplicateTooltip}"
                                            Command="{Binding Data.DuplicateGptSoVitsPresetCommand, Source={StaticResource BindingProxy}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Theme="{StaticResource TransparentButton}"
                                            Content="{ci:FluentIcon &#xe61d;}"
                                            Margin="0 -8"
                                            ToolTip.Tip="{x:Static locSp:Localization.RemoveTooltip}"
                                            IsVisible="{Binding !IsInternal}"
                                            Foreground="IndianRed"
                                            Command="{Binding Data.RemoveGptSoVitsPresetCommand, Source={StaticResource BindingProxy}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </ci:SpeechProviderControlBase.Resources>
    <StackPanel DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:GptSovitsSpeechServiceSettingsControl}}" 
                Spacing="1">

        <controls:FASettingsExpanderItem>
            <WrapPanel>
                <Button HorizontalAlignment="Left"
                        Margin="0 0 2 0"
                        Click="ButtonOpenGptSovitsPresetsDrawer_OnClick"
                        Content="{x:Static locSp:Localization.SpeechPresetsButton}">
                </Button>
                <Button HorizontalAlignment="Left"
                        Click="ButtonSaveGptSovitsPreset2_OnClick"
                        Content="{x:Static locSp:Localization.SavePreset}">
                </Button>
            </WrapPanel>
        </controls:FASettingsExpanderItem>

        <!-- 服务器 IP -->
        <controls:FASettingsExpanderItem Content="{x:Static locSp:Localization.ServerIp}">
            <controls:FASettingsExpanderItem.Footer>
                <TextBox Width="150" 
                         Text="{Binding SettingsService.Settings.GptSoVitsSpeechSettings.GptSoVitsServerIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </controls:FASettingsExpanderItem.Footer>
        </controls:FASettingsExpanderItem>

        <!-- 服务器端口 -->
        <controls:FASettingsExpanderItem Content="{x:Static locSp:Localization.ServerPort}">
            <controls:FASettingsExpanderItem.Footer >
                <TextBox Width="150"
                         Text="{Binding SettingsService.Settings.GptSoVitsSpeechSettings.GptSoVitsPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </controls:FASettingsExpanderItem.Footer>
        </controls:FASettingsExpanderItem>

        <!-- 语音名称 -->
        <controls:FASettingsExpanderItem Content="{x:Static locSp:Localization.VoiceName}" Description="{x:Static locSp:Localization.VoiceNameDescription}">
            <controls:FASettingsExpanderItem.Footer >
                <TextBox Width="150"
                         Text="{Binding SettingsService.Settings.GptSoVitsSpeechSettings.GptSoVitsVoiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </controls:FASettingsExpanderItem.Footer>
        </controls:FASettingsExpanderItem>

        <!-- 文本语言 -->
        <controls:FASettingsExpanderItem Content="{x:Static locSp:Localization.TextLanguage}"> 
            <controls:FASettingsExpanderItem.Footer>
                <TextBox Width="150"
                         Text="{Binding SettingsService.Settings.GptSoVitsSpeechSettings.GptSoVitsTextLang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </controls:FASettingsExpanderItem.Footer>
        </controls:FASettingsExpanderItem>

        <!-- 参考音频路径 -->
        <controls:FASettingsExpanderItem Description="{x:Static locSp:Localization.RefAudioPathDescription}">
            <ci:Field Label="{x:Static locSp:Localization.RefAudioPath}">
                <TextBox Text="{Binding SettingsService.Settings.GptSoVitsSpeechSettings.GptSoVitsRefAudioPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </ci:Field>
        </controls:FASettingsExpanderItem>

        <!-- 参考音频语言 -->
        <controls:FASettingsExpanderItem>
            <ci:Field Label="{x:Static locSp:Localization.RefAudioLanguage}">
                <TextBox Text="{Binding SettingsService.Settings.GptSoVitsSpeechSettings.GptSoVitsPromptLang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </ci:Field>
        </controls:FASettingsExpanderItem>

        <!-- 参考音频文本 -->
        <controls:FASettingsExpanderItem>
            <ci:Field Label="{x:Static locSp:Localization.RefAudioText}">
                <TextBox TextWrapping="Wrap"
                         Text="{Binding SettingsService.Settings.GptSoVitsSpeechSettings.GptSoVitsPromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </ci:Field>
        </controls:FASettingsExpanderItem>

        <controls:FASettingsExpander Header="{x:Static locSp:Localization.AdvancedOptions}"
                                   Description="{x:Static locSp:Localization.AdvancedOptionsDescription}"
                                   Classes="no-radius">
            <controls:FASettingsExpander.Styles>
                <Style Selector="controls|FASettingsExpander /template/ Expander#Expander">
                    <Setter Property="Padding" Value="-1"/>
                </Style>
            </controls:FASettingsExpander.Styles>
            <controls:FASettingsExpanderItem Content="{x:Static locSp:Localization.TextSplitMethod}"> 
                <!-- 文本分割方法 -->
                <controls:FASettingsExpanderItem.Footer >
                    <TextBox Width="150"
                             Text="{Binding SettingsService.Settings.GptSoVitsSpeechSettings.GptSoVitsTextSplitMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </controls:FASettingsExpanderItem.Footer>
            </controls:FASettingsExpanderItem>
            <controls:FASettingsExpanderItem Classes="no-radius" Content="{x:Static locSp:Localization.Concurrency}">
                <controls:FASettingsExpanderItem.Footer>
                    <TextBox Width="150"
                             Text="{Binding SettingsService.Settings.GptSoVitsSpeechSettings.GptSoVitsBatchSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </controls:FASettingsExpanderItem.Footer>
            </controls:FASettingsExpanderItem>
        </controls:FASettingsExpander>
    </StackPanel>
    <!--State:G6MAAJzJ4+5T0YTJW4I5XDeVesEtfWC7sW8kSuamXGagGQfs3WNggQ04xwmOxjhgZ+Hpkt/U6PcNtL+7eR1Ax+dDz0Kg9H+YfTFe+eIEaINW1LeeAx0NyfIBagOQZS/sAdCI/D//wikKxZ2cUGOoJtR8FpL0b8wxvCRLcbZAtBPikQ==-->
</ci:SpeechProviderControlBase>
