<ci:NotificationProviderControlBase x:Class="ClassIsland.Controls.NotificationProviders.WeatherNotificationProviderSettingsControl"
             x:TypeArguments="notificationProviderSettings:WeatherNotificationProviderSettings"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClassIsland.Controls.NotificationProviders"
             xmlns:controls="clr-namespace:ClassIsland.Controls"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="clr-namespace:ClassIsland.Converters"
             xmlns:converters1="clr-namespace:ClassIsland.Core.Converters;assembly=ClassFabric.Core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ci="http://classfabric.tech/schemas/xaml/core"
             xmlns:notificationProviderSettings="clr-namespace:ClassIsland.Models.NotificationProviderSettings"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:locNp="clr-namespace:ClassFabric.Assets.Localization.Controls.NotificationProviders"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters1:NotificationModeToIntConverter x:Key="ShowModeToIntConverter" />
    </UserControl.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:WeatherNotificationProviderSettingsControl}}">
        <ScrollViewer>
            <StackPanel Spacing="6">
                <!-- 启用天气预报 -->
                <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xE4DC;}"
                                     Header="{x:Static locNp:Localization.EnableWeatherForecast}"
                                     Description="{x:Static locNp:Localization.EnableWeatherForecastDescription}">
                    <fa:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsForecastEnabled, Mode=TwoWay}" />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>

                <!-- 启用极端天气预警 -->
                <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xF431;}"
                                     Header="{x:Static locNp:Localization.EnableWeatherAlert}"
                                     Description="{x:Static locNp:Localization.EnableWeatherAlertDescription}">
                    <fa:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsAlertEnabled, Mode=TwoWay}" />
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>

                <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xE4DC;}"
                                     Header="{x:Static locNp:Localization.DefaultForecastShowMode}"
                                     Description="{x:Static locNp:Localization.DefaultForecastShowModeDescription}"
                                     IsVisible="{Binding Settings.IsForecastEnabled}">
                    <fa:FASettingsExpander.Footer>
                        <Grid>
                            <ComboBox Foreground="{DynamicResource MaterialDesignBody}"
                                      SelectedIndex="{Binding Settings.ForecastShowMode, Converter={StaticResource ShowModeToIntConverter}}">
                                <ComboBoxItem Content="{x:Static locNp:Localization.DefaultDisabled}"/>
                                <ComboBoxItem Content="{x:Static locNp:Localization.DefaultEnabled}"/>
                            </ComboBox>
                        </Grid>
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>

                <!-- 默认极端天气提醒显示模式 -->

                    <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xF431;}"
                                         Header="{x:Static locNp:Localization.DefaultAlertShowMode}"
                                         Description="{x:Static locNp:Localization.DefaultAlertShowModeDescription}"
                                         IsVisible="{Binding Settings.IsAlertEnabled}">
                        <fa:FASettingsExpander.Footer>
                        <Grid>
                            <ComboBox Foreground="{DynamicResource MaterialDesignBody}"
                                      SelectedIndex="{Binding Settings.AlertShowMode, Converter={StaticResource ShowModeToIntConverter}}">
                                <ComboBoxItem Content="{x:Static locNp:Localization.DefaultDisabled}"/>
                                <ComboBoxItem Content="{x:Static locNp:Localization.DefaultEnabled}"/>
                            </ComboBox>
                        </Grid>
                            </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
                <!-- 极端天气文本滚动速度 -->
                <fa:FASettingsExpander IconSource="{ci:FluentIconSource &#xF373;}"
                                     Header="{x:Static locNp:Localization.WeatherAlertScrollSpeed}"
                                     Description="{x:Static locNp:Localization.WeatherAlertScrollSpeedDescription}"
                                     IsVisible="{Binding Settings.IsAlertEnabled}">
                    <fa:FASettingsExpander.Footer>
                        <Grid>
                            <Slider Width="180" Minimum="5" Maximum="12"
                                    VerticalAlignment="Center"
                                    Value="{Binding Settings.WeatherAlertSpeed}"
                                    TickFrequency="0.1"
                                    TickPlacement="None"
                                    IsSnapToTickEnabled="True"
                                    ci:SliderDragTooltipAssist.StringFormat="F1"
                                    Classes="auto-tooltip" />
                        </Grid>
                    </fa:FASettingsExpander.Footer>
                </fa:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ci:NotificationProviderControlBase>
