<ci:RuleSettingsControlBase
    x:TypeArguments="rules:UsingTimeLayoutRuleSettings"
    x:Class="ClassFabric.Controls.RuleSettingsControls.UsingTimeLayoutRuleSettingsControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClassFabric.Controls.RuleSettingsControls"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:rules="clr-namespace:ClassFabric.Models.Rules"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:UsingTimeLayoutRuleSettingsControl}}">
        <ComboBox ItemsSource="{Binding ProfileSettingsViewModel.TimeLayouts.List}"
                  SelectedValue="{Binding Settings.TimeLayoutId}"
                  SelectedValueBinding="{Binding Key}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Value.Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</ci:RuleSettingsControlBase>
