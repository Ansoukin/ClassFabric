<controls2:ComponentBase x:TypeArguments="componentSettings:CountDownComponentSettings"
                         x:Class="ClassIsland.Controls.Components.CountDownComponentSettingsControl"
                         xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                         xmlns:controls="clr-namespace:ClassIsland.Controls"
                         xmlns:converters="clr-namespace:ClassIsland.Converters"
                         xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassFabric.Core"
                         xmlns:controls2="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassFabric.Core"
                         xmlns:models="clr-namespace:ClassIsland.Models"
                         xmlns:components="clr-namespace:ClassIsland.Controls.Components"
                         xmlns:componentSettings="clr-namespace:ClassIsland.Models.ComponentSettings"
                         xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                         xmlns:ci="http://classfabric.tech/schemas/xaml/core"
                         xmlns:locComp="clr-namespace:ClassFabric.Assets.Localization.Controls.Components"
                         mc:Ignorable="d">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=components:CountDownComponentSettingsControl}}">
        <StackPanel Classes="component-settings-container animated-intro">
            <controls3:FASettingsExpander IconSource="{controls1:FluentIconSource &#xEE7D;}"
                                        Header="{x:Static locComp:Localization.CountdownName}"
                                        Description="{x:Static locComp:Localization.CountdownNameDescription}">
                <controls3:FASettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.CountDownName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="180"/>
                </controls3:FASettingsExpander.Footer>
            </controls3:FASettingsExpander>
            
            <controls3:FASettingsExpander IconSource="{controls1:FluentIconSource &#xE304;}"
                                        Header="{x:Static locComp:Localization.Time}"
                                        Description="{x:Static locComp:Localization.TimeDescription}"
                                        IsExpanded="True">
                <controls3:FASettingsExpander.Styles>
                    <Style Selector="controls3|FASettingsExpanderItem.has-radius /template/ Border#Root">
                        <Setter Property="CornerRadius" Value="0 0 4 4"/>
                    </Style>
                </controls3:FASettingsExpander.Styles>
                <controls3:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.CountdownSource}">
                        <ComboBoxItem Content="{x:Static locComp:Localization.FixedTime}"/>
                        <ComboBoxItem Content="{x:Static locComp:Localization.Cycle}"/>
                        <ComboBoxItem Content="{x:Static locComp:Localization.Today}"/>
                        <ComboBoxItem Content="{x:Static locComp:Localization.ThisWeek}"/>
                    </ComboBox>
                </controls3:FASettingsExpander.Footer>
                <!-- 固定时间 -->
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.StartDate}"
                                                Description="{x:Static locComp:Localization.StartDateDescription}">
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="Settings.CountdownSource" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <x:Int32>0</x:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <controls3:FASettingsExpanderItem.Footer>
                        <CalendarDatePicker
                            SelectedDate="{Binding Settings.StartTime, Mode=TwoWay}"
                            Width="120" />
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.EndDate}"
                                                Description="{x:Static locComp:Localization.EndDateDescription}"
                                                Classes="has-radius">
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="Settings.CountdownSource" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <x:Int32>0</x:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <controls3:FASettingsExpanderItem.Footer>
                        <CalendarDatePicker
                            SelectedDate="{Binding Settings.OverTime, Mode=TwoWay}"
                            Width="120" />
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <!-- 周期 -->
                <controls3:FASettingsExpanderItem>
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="Settings.CountdownSource" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <x:Int32>1</x:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <CheckBox IsChecked="{Binding Settings.IsAdvancedCycleTimingEnabled}" Content="{x:Static locComp:Localization.AdvancedTiming}"/>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem>
                    <controls3:FASettingsExpanderItem.Footer>
                        <TextBox IsVisible="{Binding !Settings.IsAdvancedCycleTimingEnabled}"
                                 Text="{Binding Settings.CycleDuration, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:TimeSpanToStringConverter.Instance}}" />
                    </controls3:FASettingsExpanderItem.Footer>
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="Settings.CountdownSource" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <x:Int32>1</x:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <Panel>
                        <Grid ColumnDefinitions="Auto 1* Auto 1* Auto 2* Auto 2* Auto 1* Auto 1* Auto"
                              RowDefinitions="32,6,Auto"
                              IsVisible="{Binding Settings.IsAdvancedCycleTimingEnabled}">
                            <!-- ROW1 -->
                            <Line Grid.Row="0" Grid.Column="0"
                                  StartPoint="0 0" EndPoint="0 32"
                                  Stroke="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                  StrokeThickness="1" StrokeLineCap="Round" />
                            <Viewbox Grid.Row="0" Grid.Column="1"
                                     Stretch="Fill" HorizontalAlignment="Stretch" Height="32">
                                <Canvas Width="120" Height="32">
                                    <Line StartPoint="0 16" EndPoint="120 16"
                                          Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                          StrokeThickness="1" StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBox Grid.Row="0" Grid.Column="2" Margin="4 0"
                                     Text="{Binding Settings.CycleBeforeDuration, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:TimeSpanToStringConverter.Instance}}" />
                            <Viewbox Grid.Row="0" Grid.Column="3"
                                     Stretch="Fill" HorizontalAlignment="Stretch" Height="32">
                                <Canvas Width="120" Height="32">
                                    <Line StartPoint="0 16" EndPoint="120 16"
                                          Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                          StrokeThickness="1" StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <Line Grid.Row="0" Grid.Column="4"
                                  StartPoint="0 0" EndPoint="0 32"
                                  Stroke="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                  StrokeThickness="1" StrokeLineCap="Round" />
                            <Viewbox Grid.Row="0" Grid.Column="5"
                                     Stretch="Fill" HorizontalAlignment="Stretch" Height="32">
                                <Canvas Width="120" Height="32">
                                    <Line StartPoint="0 16" EndPoint="120 16"
                                          Stroke="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                          StrokeThickness="1" StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBox Grid.Row="0" Grid.Column="6" Margin="4 0"
                                     Text="{Binding Settings.CycleDuration, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:TimeSpanToStringConverter.Instance}}" />
                            <Viewbox Grid.Row="0" Grid.Column="7"
                                     Stretch="Fill" HorizontalAlignment="Stretch" Height="32">
                                <Canvas Width="120" Height="32">
                                    <Line StartPoint="0 16" EndPoint="120 16"
                                          Stroke="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                          StrokeThickness="1" StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <Line Grid.Row="0" Grid.Column="8"
                                  StartPoint="0 0" EndPoint="0 32"
                                  Stroke="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                  StrokeThickness="1" StrokeLineCap="Round" />
                            <Viewbox Grid.Row="0" Grid.Column="9"
                                     Stretch="Fill" HorizontalAlignment="Stretch" Height="32">
                                <Canvas Width="120" Height="32">
                                    <Line StartPoint="0 16" EndPoint="120 16"
                                          Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                          StrokeThickness="1" StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBox Grid.Row="0" Grid.Column="10" Margin="4 0"
                                     Text="{Binding Settings.CycleAfterDuration, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:TimeSpanToStringConverter.Instance}}" />
                            <Viewbox Grid.Row="0" Grid.Column="11"
                                     Stretch="Fill" HorizontalAlignment="Stretch" Height="32">
                                <Canvas Width="120" Height="32">
                                    <Line StartPoint="0 16" EndPoint="120 16"
                                          Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                          StrokeThickness="1" StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <controls1:FluentIcon Grid.Row="0" Grid.Column="11"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Glyph="&#xe44e;"
                                                  FontSize="20"
                                                  Foreground="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                  Margin="0 -2.5 -4.5 0" />
                            <Line Grid.Row="0" Grid.Column="12"
                                  StartPoint="0 0" EndPoint="0 32"
                                  Stroke="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                  StrokeThickness="1" StrokeLineCap="Round" />

                            <!-- ROW2 -->
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                       HorizontalAlignment="Center" FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center">
                                <Run Text="{x:Static locComp:Localization.CycleBeforeDurationLabel}" /><LineBreak />
                                <Run Text="{x:Static locComp:Localization.CycleBeforeDurationHint}"
                                     Foreground="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="3"
                                       HorizontalAlignment="Center" FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center">
                                <Run Text="{x:Static locComp:Localization.CycleTimingDurationLabel}" /><LineBreak />
                                <Run Text="{x:Static locComp:Localization.CycleTimingDurationHint}"
                                     Foreground="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="9" Grid.ColumnSpan="3"
                                       HorizontalAlignment="Center" FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center">
                                <Run Text="{x:Static locComp:Localization.CycleAfterDurationLabel}" /><LineBreak />
                                <Run Text="{x:Static locComp:Localization.CycleAfterDurationHint}"
                                     Foreground="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{x:Static locComp:Localization.CycleDurationLabel}" IsVisible="{Binding !Settings.IsAdvancedCycleTimingEnabled}"/>
                    </Panel>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.CycleStartTimeLabel}"
                                                Description="{x:Static locComp:Localization.CycleStartTimeLabelDescription}">
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="Settings.CountdownSource" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <x:Int32>1</x:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <controls3:FASettingsExpanderItem.Footer>
                        <CalendarDatePicker
                            SelectedDate="{Binding Settings.CycleStartTime, Mode=TwoWay}"
                            Width="120" />
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.LimitCycleLoops}"
                                                Description="{x:Static locComp:Localization.LimitCycleLoopsDescription}"
                                                Classes="has-radius">
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="Settings.CountdownSource" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <x:Int32>1</x:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <controls3:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <controls3:FANumberBox MinWidth="150"
                                                 SpinButtonPlacementMode="Inline"
                                                 Value="{Binding Settings.CycleCountLimit, Converter={x:Static ci:NotNaNConverter.Instance}}"
                                                 Maximum="33550336" Minimum="1"
                                                 IsVisible="{Binding Settings.IsCycleCountLimited}"
                                                 VerticalAlignment="Center"/>
                            <ToggleSwitch IsChecked="{Binding Settings.IsCycleCountLimited}"/>
                        </StackPanel>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.TimeMode}"
                                                Description="{x:Static locComp:Localization.TimeModeDailyDescription}"
                                                Classes="has-radius">
                    <controls3:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedIndex="{Binding Settings.NatureTimeUseMode}">
                            <ComboBoxItem Content="{x:Static locComp:Localization.TimeModeDefault}"/>
                            <ComboBoxItem Content="{x:Static locComp:Localization.ForceNaturalTime}"/>
                            <ComboBoxItem Content="{x:Static locComp:Localization.ForceClassTime}"/>
                        </ComboBox>
                    </controls3:FASettingsExpanderItem.Footer>
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="Settings.CountdownSource" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <x:Int32>2</x:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.TimeMode}"
                                                Description="{x:Static locComp:Localization.TimeModeWeeklyDescription}">
                    <controls3:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedIndex="{Binding Settings.NatureTimeUseMode}">
                            <ComboBoxItem Content="{x:Static locComp:Localization.TimeModeDefault}"/>
                            <ComboBoxItem Content="{x:Static locComp:Localization.ForceNaturalTime}"/>
                            <ComboBoxItem Content="{x:Static locComp:Localization.ForceClassTime}"/>
                        </ComboBox>
                    </controls3:FASettingsExpanderItem.Footer>
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="Settings.CountdownSource" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <x:Int32>3</x:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.CustomWeekStartDay}"
                                                Description="{x:Static locComp:Localization.CustomWeekStartDayDescription}"
                                                Classes="has-radius">
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="Settings.CountdownSource" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <x:Int32>3</x:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <controls3:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ComboBox SelectedIndex="{Binding Settings.WeekCountdownStartDay}"
                                      IsVisible="{Binding Settings.IsCustomWeekCountdownStartDayEnabled}">
                                <ComboBoxItem Content="{x:Static locComp:Localization.WeekdaySunday}"/>
                                <ComboBoxItem Content="{x:Static locComp:Localization.WeekdayMonday}"/>
                                <ComboBoxItem Content="{x:Static locComp:Localization.WeekdayTuesday}"/>
                                <ComboBoxItem Content="{x:Static locComp:Localization.WeekdayWednesday}"/>
                                <ComboBoxItem Content="{x:Static locComp:Localization.WeekdayThursday}"/>
                                <ComboBoxItem Content="{x:Static locComp:Localization.WeekdayFriday}"/>
                                <ComboBoxItem Content="{x:Static locComp:Localization.WeekdaySaturday}"/>
                            </ComboBox>
                            <ToggleSwitch IsChecked="{Binding Settings.IsCustomWeekCountdownStartDayEnabled}"/>
                        </StackPanel>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
            </controls3:FASettingsExpander>
            
            <controls3:FASettingsExpander IconSource="{controls1:FluentIconSource &#xe079;}"
                                        Header="{x:Static locComp:Localization.DisplayContent}"
                                        Description="{x:Static locComp:Localization.DisplayContentDescription}"
                                        IsExpanded="True">
                <controls3:FASettingsExpanderItem>
                    <controls3:FASettingsExpanderItem.Content>
                        <CheckBox Content="{x:Static locComp:Localization.ProgressBar}" IsChecked="{Binding Settings.ShowProgress}"/>
                    </controls3:FASettingsExpanderItem.Content>
                    <controls3:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedIndex="{Binding Settings.ProgressBarMode}"
                                  IsVisible="{Binding Settings.ShowProgress}">
                            <ComboBoxItem Content="{x:Static locComp:Localization.ProgressRing}"/>
                            <ComboBoxItem Content="{x:Static locComp:Localization.ProgressBar}"/>
                        </ComboBox>    
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem>
                    <controls3:FASettingsExpanderItem.Content>
                        <CheckBox Content="{x:Static locComp:Localization.CountdownConnector}" IsChecked="{Binding !Settings.IsCompactModeEnabled}"/>
                    </controls3:FASettingsExpanderItem.Content>
                    <controls3:FASettingsExpanderItem.Footer>
                        <TextBox Text="{Binding Settings.CountDownConnector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="120"
                                 MaxWidth="300"
                                 IsVisible="{Binding !Settings.IsCompactModeEnabled}"/>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.Countdown}">
                    <controls3:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal">
                            <TextBox
                                Text="{Binding Settings.CustomStringFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MinWidth="120"
                                MaxWidth="300" />
                            <Button Theme="{StaticResource TransparentButton}"
                                    Content="{controls1:FluentIcon &#xee31;}">
                                <Button.Flyout>
                                    <Flyout>
                                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                                <Run Text="{x:Static locComp:Localization.FormatVariablesHelp}" FontWeight="Bold" />
                                            </TextBlock>
                                            <SelectableTextBlock Grid.Row="1" Grid.Column="0" Margin="0 0 4 0">
                                                <Run Text="{x:Static locComp:Localization.FormatTotalDays}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatTotalHours}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatTotalMinutes}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatTotalSeconds}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatTotalMilliseconds}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatRoundUpNote}" FontWeight="Medium"/><LineBreak/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatRemainingPercent}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatElapsedPercent}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatElapsedPercent2Decimals}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatRoundingNote}" FontWeight="Medium"/>
                                            </SelectableTextBlock>
                                            <SelectableTextBlock Grid.Row="1" Grid.Column="1">
                                                <Run Text="{x:Static locComp:Localization.FormatDays}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatHours}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatMinutes}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatSeconds}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatMilliseconds}"/><LineBreak/>
                                                <Run Text="{x:Static locComp:Localization.FormatElementValueNote}" FontWeight="Medium"/>
                                            </SelectableTextBlock>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
            </controls3:FASettingsExpander>
            
            <controls3:FASettingsExpander IconSource="{controls1:FluentIconSource &#xEC54;}"
                                        Header="{x:Static locComp:Localization.AccentColor}"
                                        Description="{x:Static locComp:Localization.AccentColorDescription}"
                                        IsExpanded="True">
                <controls3:FASettingsExpander.Footer>
                    <ColorPicker 
                        Color="{Binding Settings.FontColor,Mode=TwoWay}"/>
                </controls3:FASettingsExpander.Footer>
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.ProgressBarUseAccent}"
                                                Description="{x:Static locComp:Localization.ProgressBarUseAccentDescription}">
                    <controls3:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.UseAccentOnProgressBar, Mode=TwoWay}"/>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem Content="{x:Static locComp:Localization.ConnectorUseAccent}"
                                                Description="{x:Static locComp:Localization.ConnectorUseAccentDescription}">
                    <controls3:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsConnectorColorEmphasized, Mode=TwoWay}"/>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
            </controls3:FASettingsExpander>
            
            <controls3:FASettingsExpander IconSource="{controls1:FluentIconSource &#xF26F;}"
                                        Header="{x:Static locComp:Localization.FontSize}"
                                        Description="{x:Static locComp:Localization.CountdownFontSizeDescription}">
                <controls3:FASettingsExpander.Footer>
                    <Slider Width="180" 
                            Maximum="30" Minimum="16" TickFrequency="1" 
                            TickPlacement="None" IsSnapToTickEnabled="True"
                            Classes="auto-tooltip"
                            Value="{Binding Settings.FontSize}" />
                </controls3:FASettingsExpander.Footer>
            </controls3:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls2:ComponentBase>
