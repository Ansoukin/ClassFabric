<controls1:ComponentBase x:TypeArguments="componentSettings:ClockComponentSettings" 
                         x:Class="ClassIsland.Controls.Components.ClockComponentSettingsControl"
                         xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="clr-namespace:ClassIsland.Controls.Components"
                         xmlns:controls="clr-namespace:ClassIsland.Core.Controls;assembly=ClassFabric.Core"
                         xmlns:controls1="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassFabric.Core"
                         xmlns:componentSettings="clr-namespace:ClassIsland.Models.ComponentSettings"
                         xmlns:ci="http://classfabric.tech/schemas/xaml/core"
                         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                         xmlns:converters="clr-namespace:ClassIsland.Core.Converters;assembly=ClassFabric.Core"
                         xmlns:controls2="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                         xmlns:locComp="clr-namespace:ClassFabric.Assets.Localization.Controls.Components"
                         mc:Ignorable="d"
                         d:DesignHeight="450"
                         d:DesignWidth="800">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:ClockComponentSettingsControl}}">
        <StackPanel Classes="component-settings-container animated-intro">
            <controls2:FASettingsExpander IconSource="{ci:FluentIconSource &#xE4D2;}"
                                        Header="{x:Static locComp:Localization.UseRealTime}"
                                        Description="{x:Static locComp:Localization.UseRealTimeDescription}">
                <controls2:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowRealTime, Mode=TwoWay}"/>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>

            <controls2:FASettingsExpander IconSource="{ci:FluentIconSource &#xEC26;}"
                                        Header="{x:Static locComp:Localization.ShowSeconds}"
                                        Description="{x:Static locComp:Localization.ShowSecondsDescription}">
                <controls2:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowSeconds, Mode=TwoWay}"/>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>
            
            <controls2:FASettingsExpander IconSource="{ci:FluentIconSource &#xE85F;}"
                                        Header="{x:Static locComp:Localization.FlashTimeSeparator}"
                                        Description="{x:Static locComp:Localization.FlashTimeSeparatorDescription}"
                                        IsVisible="{Binding !Settings.ShowSeconds}">
                <controls2:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.FlashTimeSeparator, Mode=TwoWay}"/>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls1:ComponentBase>
