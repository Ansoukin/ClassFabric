<ci:ActionSettingsControlBase x:Class="ClassFabric.Controls.ActionSettingsControls.ScreenshotActionSettingsControl"
                              x:TypeArguments="actionSettings:ScreenshotActionSettings"
                              d:DataContext="{d:DesignInstance Type=local:ScreenshotActionSettingsControl}"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:ci="http://classisland.tech/schemas/xaml/core"
                              xmlns:local="clr-namespace:ClassFabric.Controls.ActionSettingsControls"
                              xmlns:actionSettings="clr-namespace:ClassFabric.Models.Actions">
    <TextBox Watermark="保存目录（留空保存到图片库）"
             Text="{Binding Settings.SaveDirectory, Mode=TwoWay}" />
</ci:ActionSettingsControlBase>
